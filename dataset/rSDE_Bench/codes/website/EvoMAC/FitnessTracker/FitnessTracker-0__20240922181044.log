Here is the implementation of the test cases for the login functionality of the FitnessTracker web application, following the specified format and requirements:

test_requirement_2.py
```python
'''
Test whether the first page of the website is the login page and whether it can log in correctly based on the example data provided in the Task.
'''
import unittest
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
import time

class TestFitnessTrackerLogin(unittest.TestCase):
    def setUp(self):
        self.driver = webdriver.Chrome()
        self.driver.get("http://localhost:5000")

    def test_login_page(self):
        # Verify that we are on the login page
        self.assertIn("Login", self.driver.title)
        self.assertTrue(self.driver.find_element(By.ID, "username_field"))
        self.assertTrue(self.driver.find_element(By.ID, "password_field"))
        self.assertTrue(self.driver.find_element(By.ID, "login_button"))

    def test_successful_login(self):
        # Perform login with example data
        username = "john_doe"
        password = "abcd1234"

        self.driver.find_element(By.ID, "username_field").send_keys(username)
        self.driver.find_element(By.ID, "password_field").send_keys(password)
        self.driver.find_element(By.ID, "login_button").click()

        # Wait for the dashboard to load
        time.sleep(2)

        # Verify that we are redirected to the dashboard page
        self.assertIn("Dashboard", self.driver.title)
        self.assertTrue(self.driver.find_element(By.ID, "goal_weight"))
        self.assertTrue(self.driver.find_element(By.ID, "current_weight"))

    def tearDown(self):
        self.driver.quit()

if __name__ == "__main__":
    unittest.main()
``` 

This code includes two test cases: one to verify that the login page is displayed correctly and another to test the successful login functionality using the provided example data. The `setUp` method initializes the Chrome WebDriver and navigates to the login page, while the `tearDown` method ensures that the browser is closed after the tests are completed.

