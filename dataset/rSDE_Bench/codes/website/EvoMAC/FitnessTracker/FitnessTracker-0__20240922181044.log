'''
Test the elements and integrity of ALL pages in the FitnessTracker web application.
'''
import unittest
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
import time
class FitnessTrackerTest(unittest.TestCase):
    def setUp(self):
        self.driver = webdriver.Chrome()
        self.driver.get("http://localhost:5000")
    def test_login_page_elements(self):
        driver = self.driver
        self.assertTrue(driver.find_element(By.ID, 'username_field').is_displayed(), "Username field not found")
        self.assertTrue(driver.find_element(By.ID, 'password_field').is_displayed(), "Password field not found")
