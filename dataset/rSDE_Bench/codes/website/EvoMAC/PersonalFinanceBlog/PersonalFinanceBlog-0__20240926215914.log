'''
Test whether the website can be accessed through local port 5000, specifically testing the login page.
'''
import unittest
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
import time

class TestPersonalFinanceBlog(unittest.TestCase):
    def setUp(self):
        # Initialize the Chrome WebDriver
        self.driver = webdriver.Chrome()
        self.driver.get("http://localhost:5000")

    def test_login_page_access(self):
        driver = self.driver
        # Check if the login page is accessible
        time.sleep(2)  # Wait for the page to load
        self.assertIn("Login", driver.title)  # Verify the title of the page
        print("Login page accessed successfully.")

        # Check for the presence of login elements
        username_field = driver.find_element(By.ID, "username_field")
        password_field = driver.find_element(By.ID, "password_field")
        login_button = driver.find_element(By.ID, "login_button")
        
        self.assertIsNotNone(username_field, "Username field is not found.")
        self.assertIsNotNone(password_field, "Password field is not found.")
        self.assertIsNotNone(login_button, "Login button is not found.")
        print("All login elements are present.")

    def tearDown(self):
        # Close the browser after the test
        self.driver.quit()

if __name__ == "__main__":
    unittest.main()
```

### Explanation:
- The test case is structured using the `unittest` framework.
- The `setUp` method initializes the Chrome WebDriver and navigates to the login page at `http://localhost:5000`.
- The `test_login_page_access` method checks if the login page is accessible by verifying the page title and the presence of key elements (username field, password field, and login button).
- The `tearDown` method ensures that the browser is closed after the test execution.
- Logging is done through print statements to indicate the success of accessing the login page and the presence of required elements.

