        self.assertTrue(driver.find_element(By.ID, 'back_button'))

    def test_category_post_page_elements(self):
        self.login()
        driver = self.driver
        driver.find_element(By.ID, 'search_post_button').click()
        time.sleep(1)  # Wait for the page to load
