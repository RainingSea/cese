        self.assertTrue(driver.find_element(By.ID, "investment_button").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "banking_button").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "insurance_button").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "back_button").is_displayed())

    def test_category_post_page_elements(self):
        self.driver.find_element(By.ID, "search_post_button").click()
        self.driver.find_element(By.ID, "investment_button").click()
