'''
Test whether the first page of the website is the login page and whether it can log in correctly based on the example data provided in the Task.
'''
import unittest
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
import logging

# Configure logging
logging.basicConfig(level=logging.INFO)

class TestPersonalFinanceBlogLogin(unittest.TestCase):
    def setUp(self):
        self.driver = webdriver.Chrome()
        self.driver.get("http://localhost:5000")

    def test_login_page(self):
        driver = self.driver
        logging.info("Checking if the current page is the login page.")
        
        # Verify that the login page is displayed
        self.assertIn("Login", driver.title)
        logging.info("Login page title verified.")

        # Locate the username and password fields
        username_field = driver.find_element(By.ID, "username_field")
        password_field = driver.find_element(By.ID, "password_field")
        login_button = driver.find_element(By.ID, "login_button")

        # Input example data and attempt to log in
        username = "john_doe"
        password = "abcd1234"
        
        username_field.send_keys(username)
        password_field.send_keys(password)
        login_button.click()
        logging.info("Login attempt made with username: %s", username)

        # Check if redirected to the dashboard page
        self.assertNotIn("Login", driver.title)
        logging.info("Successfully logged in and redirected from login page.")

    def tearDown(self):
        self.driver.quit()

if __name__ == "__main__":
    unittest.main()
``` 

This code implements the test case for the login functionality of the PersonalFinanceBlog web application, ensuring that the login page is correctly displayed and that the login process works as intended using the provided example data.

