_occupation_display"&gt;Occupation:&lt;/label&gt;\n            &lt;span id="profile_occupation_display"&gt;{{ occupation }}&lt;/span&gt;\n        &lt;/div&gt;\n        &lt;div&gt;\n            &lt;button id="logout_button" onclick="window.location.href=\'{{ url_for(\'login\') }}\'"&gt;Logout&lt;/button&gt;\n        &lt;/div&gt;\n    &lt;/div&gt;\n&lt;/body&gt;\n&lt;/html&gt;\n\n\n', 'issues': ''} |
