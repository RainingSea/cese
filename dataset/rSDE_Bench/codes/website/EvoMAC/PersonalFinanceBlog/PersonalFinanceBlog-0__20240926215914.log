        with open(POSTS_FILE, 'r') as file:
            for line in file:
                post_id, username, title, date, category, content = line.strip().split('|')
                posts.append({
                    'id': post_id,
                    'username': username,
                    'title': title,
                    'date': date,
                    'category': category,
                    'content': content
