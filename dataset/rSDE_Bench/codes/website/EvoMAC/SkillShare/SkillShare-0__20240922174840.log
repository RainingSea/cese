Here is the implementation of the test cases for the SkillShare web application according to the specified requirements:

test_requirement_2.py
```python
'''
Test whether the first page of the website is the login page and whether it can log in correctly based on the example data provided in the Task.
'''
import unittest
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
import time

class TestSkillShareLogin(unittest.TestCase):
    def setUp(self):
        self.driver = webdriver.Chrome()
        self.driver.get("http://localhost:5000")

    def test_login_page(self):
        # Verify that the current page is the login page
        self.assertIn("Login", self.driver.title)
        print("Login page title verified.")

        # Check if the username and password fields are present
        username_field = self.driver.find_element(By.ID, "usernameInput")
        password_field = self.driver.find_element(By.ID, "passwordInput")
        self.assertIsNotNone(username_field)
        self.assertIsNotNone(password_field)
        print("Username and password fields are present.")

    def test_login_functionality(self):
        # Attempt to log in with example data
        username = "johnDoe"
        password = "securePassword123"

        username_field = self.driver.find_element(By.ID, "usernameInput")
        password_field = self.driver.find_element(By.ID, "passwordInput")
        login_button = self.driver.find_element(By.ID, "loginButton")

        username_field.send_keys(username)
        password_field.send_keys(password)
        login_button.click()

        # Wait for the page to load
        time.sleep(2)

        # Verify that the user is redirected to the dashboard
        self.assertIn("Dashboard", self.driver.title)
        print("Login functionality verified, redirected to Dashboard.")

    def tearDown(self):
        self.driver.quit()

if __name__ == "__main__":
    unittest.main()
```

### Explanation:
- The test class `TestSkillShareLogin` is created to encapsulate the test cases.
- The `setUp` method initializes the Chrome WebDriver and navigates to the login page.
- The `test_login_page` method checks if the title of the page is "Login" and verifies the presence of the username and password fields.
- The `test_login_functionality` method tests the login functionality using the provided example data. It checks if the user is redirected to the Dashboard after a successful login.
- The `tearDown` method ensures that the browser is closed after the tests are completed.
- Logging statements are included to provide feedback during the test execution.

