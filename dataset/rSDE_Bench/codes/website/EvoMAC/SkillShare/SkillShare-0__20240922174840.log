test_requirement_1.py
```python
'''
Test whether the website can be accessed through local port 5000, specifically testing the login page.
'''
import unittest
from selenium import webdriver
from selenium.webdriver.common.by import By
import time

class TestSkillShareLoginPage(unittest.TestCase):
    def setUp(self):
        self.driver = webdriver.Chrome()
        self.driver.get("http://localhost:5000")

    def test_login_page_access(self):
        # Check if the login page is accessible
        try:
            username_field = self.driver.find_element(By.ID, "usernameInput")
            password_field = self.driver.find_element(By.ID, "passwordInput")
            login_button = self.driver.find_element(By.ID, "loginButton")
            register_button = self.driver.find_element(By.ID, "registerButton")

            # Log the results
            print("Login page accessed successfully.")
            self.assertIsNotNone(username_field, "Username field not found.")
            self.assertIsNotNone(password_field, "Password field not found.")
            self.assertIsNotNone(login_button, "Login button not found.")
            self.assertIsNotNone(register_button, "Register button not found.")
        except Exception as e:
            print(f"Error accessing login page: {e}")
            self.fail("Login page access test failed.")

    def tearDown(self):
        time.sleep(2)  # Wait for 2 seconds to observe the result
        self.driver.quit()

if __name__ == "__main__":
    unittest.main()
