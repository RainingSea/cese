        # Wait for the page to load
        time.sleep(2)
        # Verify if redirected to the Home page
        self.assertIn("Home", self.driver.title)
        print("Successfully logged in and redirected to Home page.")
    def tearDown(self):
        self.driver.quit()
if __name__ == "__main__":
    unittest.main()
