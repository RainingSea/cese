'''
Test the elements and integrity of all pages in NoteTakingApp, ensuring that each page contains the required elements as specified in the task requirements.
'''
import unittest
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
import time

class NoteTakingAppTests(unittest.TestCase):
    def setUp(self):
        self.driver = webdriver.Chrome()
        self.driver.get("http://localhost:5000")
        self.username = "john_doe"
        self.password = "abcd1234"
        self.login()

    def login(self):
        self.driver.find_element(By.ID, "username_field").send_keys(self.username)
        self.driver.find_element(By.ID, "password_field").send_keys(self.password)
        self.driver.find_element(By.ID, "login_button").click()
        time.sleep(2)  # Wait for the dashboard to load

    def test_login_page_elements(self):
        self.driver.get("http://localhost:5000")
        self.assertTrue(self.driver.find_element(By.ID, "login_page").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "username_field").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "password_field").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "login_button").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "error_message").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "register_link").is_displayed())

    def test_registration_page_elements(self):
        self.driver.get("http://localhost:5000/register")
        self.assertTrue(self.driver.find_element(By.ID, "registration_page").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "register_username_field").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "register_password_field").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "confirm_password_field").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "register_button").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "registration_success_message").is_displayed())

    def test_dashboard_page_elements(self):
        self.assertTrue(self.driver.find_element(By.ID, "dashboard_page").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "notes_list").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "add_note_button").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "view_note_button").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "search_note_button").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "logout_button").is_displayed())

    def test_add_note_page_elements(self):
        self.driver.find_element(By.ID, "add_note_button").click()
        time.sleep(2)  # Wait for the add note page to load
        self.assertTrue(self.driver.find_element(By.ID, "add_note_page").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "note_title_field").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "note_content_field").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "save_note_button").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "cancel_button").is_displayed())

    def test_search_note_page_elements(self):
        self.driver.find_element(By.ID, "search_note_button").click()
        time.sleep(2)  # Wait for the search note page to load
        self.assertTrue(self.driver.find_element(By.ID, "search_note_field").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "search_note_button").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "search_note_result").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "back_button").is_displayed())

    def test_view_note_page_elements(self):
        self.driver.find_element(By.ID, "view_note_button").click()
        time.sleep(2)  # Wait for the view note page to load
        self.assertTrue(self.driver.find_element(By.ID, "view_note_page").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "note_title_filed").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "note_content_filed").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "edit_note_button").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "delete_note_button").is_displayed())
        self.assertTrue(self.driver.find_element(By.ID, "back_to_dashboard_button").is_displayed())

    def tearDown(self):
        self.driver.quit()

if __name__ == "__main__":
    unittest.main()
