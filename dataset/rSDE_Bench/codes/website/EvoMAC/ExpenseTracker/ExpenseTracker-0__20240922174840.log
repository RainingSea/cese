'''
Test the elements and integrity of all pages in the ExpenseTracker application.
'''
import unittest
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
import time

class TestExpenseTracker(unittest.TestCase):
    def setUp(self):
        self.driver = webdriver.Chrome()
        self.driver.get("http://localhost:5000")
        self.username = "user1"  # Example username from users.txt
        self.password = "pass123"  # Example password from users.txt

    def test_login_page_elements(self):
        driver = self.driver
        self.assertTrue(driver.find_element(By.ID, "login-form"))
        self.assertTrue(driver.find_element(By.ID, "username"))
        self.assertTrue(driver.find_element(By.ID, "password"))
        self.assertTrue(driver.find_element(By.ID, "login-button"))
        self.assertTrue(driver.find_element(By.ID, "register-button"))
        self.assertTrue(driver.find_element(By.ID, "login-error"))

    def test_register_page_elements(self):
        driver = self.driver
        driver.find_element(By.ID, "register-button").click()
        time.sleep(1)  # Wait for page to load
        self.assertTrue(driver.find_element(By.ID, "register-form"))
        self.assertTrue(driver.find_element(By.ID, "username"))
        self.assertTrue(driver.find_element(By.ID, "password"))
        self.assertTrue(driver.find_element(By.ID, "register-button"))

    def test_dashboard_page_elements(self):
        self.login()
        driver = self.driver
        self.assertTrue(driver.find_element(By.ID, "dashboard-header"))
        self.assertTrue(driver.find_element(By.ID, "expense-summary"))
        self.assertTrue(driver.find_element(By.ID, "add-expense-button"))
        self.assertTrue(driver.find_element(By.ID, "view-expense-button"))
        self.assertTrue(driver.find_element(By.ID, "add-income-button"))
        self.assertTrue(driver.find_element(By.ID, "report-button"))
        self.assertTrue(driver.find_element(By.ID, "logout-button"))

    def test_add_expense_page_elements(self):
        self.login()
        driver = self.driver
        driver.find_element(By.ID, "add-expense-button").click()
        time.sleep(1)  # Wait for page to load
        self.assertTrue(driver.find_element(By.ID, "add-expense-form"))
        self.assertTrue(driver.find_element(By.ID, "expense-name"))
        self.assertTrue(driver.find_element(By.ID, "expense-amount"))
        self.assertTrue(driver.find_element(By.ID, "expense-date"))
        self.assertTrue(driver.find_element(By.ID, "expense-category"))
        self.assertTrue(driver.find_element(By.ID, "submit-expense-button"))

    def test_add_income_page_elements(self):
        self.login()
        driver = self.driver
        driver.find_element(By.ID, "add-income-button").click()
        time.sleep(1)  # Wait for page to load
        self.assertTrue(driver.find_element(By.ID, "add-income-form"))
        self.assertTrue(driver.find_element(By.ID, "income-amount"))
        self.assertTrue(driver.find_element(By.ID, "income-date"))
        self.assertTrue(driver.find_element(By.ID, "income-category"))
        self.assertTrue(driver.find_element(By.ID, "submit-income-button"))

    def test_view_expenses_page_elements(self):
        self.login()
        driver = self.driver
        driver.find_element(By.ID, "view-expense-button").click()
        time.sleep(1)  # Wait for page to load
        self.assertTrue(driver.find_element(By.ID, "expense-list"))
        self.assertTrue(driver.find_element(By.ID, "delete-expense-button"))

    def test_reports_page_elements(self):
        self.login()
        driver = self.driver
        driver.find_element(By.ID, "report-button").click()
        time.sleep(1)  # Wait for page to load
        self.assertTrue(driver.find_element(By.ID, "report-select"))
        self.assertTrue(driver.find_element(By.ID, "generate-report-button"))
        self.assertTrue(driver.find_element(By.ID, "report-output"))

    def login(self):
        driver = self.driver
        driver.find_element(By.ID, "username").send_keys(self.username)
        driver.find_element(By.ID, "password").send_keys(self.password)
        driver.find_element(By.ID, "login-button").click()
        time.sleep(1)  # Wait for login to process

    def tearDown(self):
        self.driver.quit()

if __name__ == "__main__":
