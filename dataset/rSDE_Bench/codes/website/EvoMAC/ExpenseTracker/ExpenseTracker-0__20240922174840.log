ntent="width=device-width, initial-scale=1.0"&gt;\n    &lt;title&gt;View All Expenses&lt;/title&gt;\n    &lt;link rel="stylesheet" href="{{ url_for(\'static\', filename=\'css/styles.css\') }}"&gt;\n&lt;/head&gt;\n&lt;body&gt;\n    &lt;div id="expense-list"&gt;\n        &lt;h1&gt;View All Expenses&lt;/h1&gt;\n        &lt;table&gt;\n            &lt;thead&gt;\n                &lt;tr&gt;\n                    &lt;th&gt;Date&lt;/th&gt;\n                    &lt;th&gt;Name&lt;/th&gt;\n                    &lt;th&gt;Amount&lt;/th&gt;\n                    &lt;th&gt;Category&lt;/th&gt;\n                    &lt;th&gt;Action&lt;/th&gt;\n                &lt;/tr&gt;\n            &lt;/thead&gt;\n            &lt;tbody&gt;\n                {% for expense in expenses %}\n                &lt;tr&gt;\n                    &lt;td&gt;{{ expense.date }}&lt;/td&gt;\n                    &lt;td&gt;{{ expense.name }}&lt;/td&gt;\n                    &lt;td&gt;${{ expense.amount }}&lt;/td&gt;\n                    &lt;td&gt;{{ expense.category }}&lt;/td&gt;\n                    &lt;td&gt;\n                        &lt;form action="{{ url_for(\'delete_expense\') }}" method="post"&gt;\n                            &lt;input type="hidden" name="expense_id" value="{{ expense.id }}"&gt;  &lt;!-- Use unique ID for deletion --&gt;\n                            &lt;button type="submit" id="delete-expense-button"&gt;Delete&lt;/button&gt;\n                        &lt;/form&gt;\n                    &lt;/td&gt;\n                &lt;/tr&gt;\n                {% endfor %}\n            &lt;/tbody&gt;\n        &lt;/table&gt;\n    &lt;/div&gt;\n&lt;/body&gt;\n&lt;/html&gt;\n\n\nreports.html\nhtml\n\'\'\'\nThis is the reports page for the ExpenseTracker web application. \nIt allows users to generate and view expense reports like monthly summaries and category analysis.\n\'\'\'\n&lt;!DOCTYPE html&gt;\n&lt;html lang="en"&gt;\n&lt;head&gt;\n    &lt;meta charset="UTF-8"&gt;\n    &lt;meta name="viewport" content="width=device