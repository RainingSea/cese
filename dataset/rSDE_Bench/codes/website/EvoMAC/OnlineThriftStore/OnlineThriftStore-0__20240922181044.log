'''
Test cases for OnlineThriftStore web application to ensure all required elements are present on each page.
'''
import unittest
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
import time
class TestOnlineThriftStore(unittest.TestCase):
    def setUp(self):
        self.driver = webdriver.Chrome()
        self.driver.get("http://localhost:5000")
        self.username = "john_doe"  # Example username from users.txt
        self.password = "abcd1234"   # Example password from users.txt
    def login(self):
        driver = self.driver
        driver.find_element(By.ID, "username_field").send_keys(self.username)
        driver.find_element(By.ID, "password_field").send_keys(self.password)
        driver.find_element(By.ID, "login_button").click()
        time.sleep(2)  # Wait for the dashboard to load
    def test_login_page_elements(self):
        driver = self.driver
        self.assertTrue(driver.find_element(By.ID, "username_field").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "password_field").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "login_button").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "error_message").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "register_link").is_displayed())
    def test_registration_page_elements(self):
        driver = self.driver
        driver.find_element(By.ID, "register_link").click()
        time.sleep(2)  # Wait for the registration page to load
        self.assertTrue(driver.find_element(By.ID, "register_username_field").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "register_password_field").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "confirm_password_field").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "register_button").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "registration_success_message").is_displayed())
    def test_dashboard_page_elements(self):
        self.login()
        driver = self.driver
        self.assertTrue(driver.find_element(By.ID, "search_field").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "search_button").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "shopping_cart_button").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "checkout_button").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "sell_item_button").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "user_profile_button").is_displayed())
    def test_item_details_page_elements(self):
        self.login()
        driver = self.driver
        driver.find_element(By.ID, "search_field").send_keys("cell phone")  # Example item title
        driver.find_element(By.ID, "search_button").click()
        time.sleep(2)  # Wait for the item details page to load
        self.assertTrue(driver.find_element(By.ID, "item_title").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "item_seller").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "item_price").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "item_status").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "add_to_cart_button").is_displayed())
        self.assertTrue(driver.find_element(By.ID, "back_button").is_displayed())
    def test_shopping_cart_page_elements(self):
        self.login()
        driver = self.driver
        driver.find_element(By.ID, "shopping_cart_button").click()
        time.sleep(2)  # Wait for the shopping cart page to load
        self.assertTrue(driver.find_element(By.ID, "cart_items_list").is_displayed())
