<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Home</title>
</head>
<body>
    <h1>Available Vintage Items</h1>
    <input type="text" id="search" placeholder="Search items...">
    <button onclick="searchItems()">Search</button>
    <ul id="itemList">
        {% for item in items %}
            <li>
                {{ item.name }} - ${{ item.price }}
                <a href="/item/{{ item.name }}">Item Details</a>
            </li>
        {% endfor %}
    </ul>
    <a href="/listing">List a New Item</a>
    <script>
        function searchItems() {
            const query = document.getElementById('search').value;
            window.location.href = '/home?search=' + query;
        }
    </script>
</body>
</html>
```

