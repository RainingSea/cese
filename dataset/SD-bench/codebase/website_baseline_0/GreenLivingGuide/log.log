*** templates/dashboard.html
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dashboard</title>
</head>
<body>
    <h1>Dashboard</h1>
    <h2>Sustainable Living Tips</h2>
    <ul>
        {% for tip in tips %}
            <li>{{ tip.content }}</li>
        {% endfor %}
    </ul>
    <h2>Submit a Tip</h2>
    <form action="/submit_tip" method="post">
        <textarea name="content" required></textarea>
        <button type="submit">Submit</button>
    </form>
    <h2>Articles</h2>
    <ul>
        {% for article in articles %}
            <li>{{ article.title }}: {{ article.content }}</li>
        {% endfor %}
    </ul>
    <h2>Submit an Article</h2>
    <form action="/submit_article" method="post">
        <input type="text" name="title" placeholder="Title" required>
        <textarea name="content" required></textarea>
        <button type="submit">Submit</button>
    </form>
    <a href="/forum">Go to Forum</a>
    <a href="/logout">Logout</a>
</body>
</html>
```

