*** templates/add_test_result.html
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Test Result</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body>
    <div class="container">
        <h2>Add Test Result</h2>
        <form method="POST">
            <div class="form-group">
                <label for="test_name">Test Name:</label>
                <input type="text" class="form-control" id="test_name" name="test_name" required>
            </div>
            <div class="form-group">
                <label for="result">Result:</label>
                <input type="number" step="0.01" class="form-control" id="result" name="result" required>
            </div>
            <div class="form-group">
                <label for="date">Date:</label>
                <input type="date" class="form-control" id="date" name="date" required>
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
            <a href="/dashboard" class="btn btn-secondary">Back to Dashboard</a>
        </form>
    </div>
</body>
</html>
```

*** templates/reminders.html
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reminders</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body>
    <div class="container">
        <h2>Your Reminders</h2>
        <form method="POST">
            <div class="form-group">
                <label for="reminder">Reminder:</label>
                <input type="text" class="form-control" id="reminder" name="reminder" required>
            </div>
            <div class="form-group">
                <label for="date">Date:</label>
                <input type="date" class="form-control" id="date" name="date" required>
            </div>
            <button type="submit" class="btn btn-primary">Add Reminder</button>
            <a href="/dashboard" class="btn btn-secondary">Back to Dashboard</a>
        </form>
        <table class="table mt-3">
            <thead>
                <tr>
                    <th>Reminder</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                {% for reminder in reminders %}
                <tr>
                    <td>{{ reminder.reminder }}</td>
                    <td>{{ reminder.date }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</body>
</html>
