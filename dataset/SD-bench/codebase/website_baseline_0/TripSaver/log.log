<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Comparison</title>
</head>
<body>
    <h1>Compare Transportation Options</h1>
    <ul>
        {% for trip in comparison_data %}
            <li>
                From: {{ trip.starting_point }} to {{ trip.destination }} on {{ trip.travel_date }}<br>
                Suggestions:
                <ul>
                    {% for suggestion in trip.suggestions %}
                        <li>{{ suggestion.mode }} - Cost: ${{ suggestion.cost }}, Time: {{ suggestion.time }}</li>
                    {% endfor %}
                </ul>
            </li>
        {% endfor %}
    </ul>
    <a href="/trip_input">Back</a>
</body>
</html>
