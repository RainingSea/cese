<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Saved Options</title>
</head>
<body>
    <h1>Saved Transportation Options</h1>
    <ul>
        {% for user, options in saved_options.items() %}
            <li>{{ user }}: {{ options | join(', ') }}</li>
        {% endfor %}
    </ul>
    <form method="POST" action="/saved_options">
        <label for="options">Select Preferred Options:</label>
        <select name="options" multiple>
            <option value="Bus">Bus</option>
            <option value="Train">Train</option>
            <option value="Car">Car</option>
        </select>
        <button type="submit">Save Options</button>
    </form>
    <a href="/trip_input">Back</a>
</body>
</html>
