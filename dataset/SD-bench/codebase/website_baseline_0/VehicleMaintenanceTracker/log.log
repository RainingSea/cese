*** user.py
```python
class User:
    def __init__(self, username: str, password: str):
        self.username = username
        self.password = password

    def save(self) -> None:
        with open('users.txt', 'a') as file:
            file.write(f"{self.username}|{self.password}\n")

    @staticmethod
    def load_users() -> list:
        users = []
        try:
            with open('users.txt', 'r') as file:
                for line in file:
                    username, password = line.strip().split('|')
                    users.append(User(username, password))
        except FileNotFoundError:
            pass
        return users
```

*** vehicle.py
```python
class Vehicle:
    def __init__(self, make: str, model: str, year: int, mileage: int):
        self.make = make
        self.model = model
        self.year = year
        self.mileage = mileage

    def save(self) -> None:
        with open('vehicles.txt', 'a') as file:
            file.write(f"{self.make}|{self.model}|{self.year}|{self.mileage}\n")

    @staticmethod
    def load_vehicles() -> list:
        vehicles = []
        try:
            with open('vehicles.txt', 'r') as file:
                for line in file:
                    make, model, year, mileage = line.strip().split('|')
                    vehicles.append(Vehicle(make, model, int(year), int(mileage)))
        except FileNotFoundError:
            pass
        return vehicles
```

*** maintenance_record.py
```python
class MaintenanceRecord:
    def __init__(self, vehicle_id: int, task: str, date: str):
        self.vehicle_id = vehicle_id
        self.task = task
        self.date = date

    def save(self) -> None:
        with open('maintenance_records.txt', 'a') as file:
            file.write(f"{self.vehicle_id}|{self.task}|{self.date}\n")

    @staticmethod
    def load_records() -> list:
        records = []
        try:
            with open('maintenance_records.txt', 'r') as file:
                for line in file:
                    vehicle_id, task, date = line.strip().split('|')
                    records.append(MaintenanceRecord(int(vehicle_id), task, date))
        except FileNotFoundError:
            pass
        return records
```

