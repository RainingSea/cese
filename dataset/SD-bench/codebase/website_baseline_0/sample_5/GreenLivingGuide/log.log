*** data_storage.py
```python
import json
from typing import List

class User:
    def __init__(self, username: str, password: str):
        self.username = username
        self.password = password

    def to_dict(self) -> dict:
        return {'username': self.username, 'password': self.password}

class Tip:
    def __init__(self, content: str, author: str):
        self.content = content
        self.author = author

    def to_dict(self) -> dict:
        return {'content': self.content, 'author': self.author}

class Article:
    def __init__(self, title: str, content: str, author: str):
        self.title = title
        self.content = content
        self.author = author

    def to_dict(self) -> dict:
        return {'title': self.title, 'content': self.content, 'author': self.author}

class ForumPost:
    def __init__(self, content: str, author: str):
        self.content = content
        self.author = author

    def to_dict(self) -> dict:
        return {'content': self.content, 'author': self.author}

class DataStorage:
    def load_users(self) -> List[User]:
        try:
            with open('users.txt', 'r') as file:
                return [User(*line.strip().split('|')) for line in file.readlines()]
        except FileNotFoundError:
            return []

    def save_user(self, user: User):
        with open('users.txt', 'a') as file:
            file.write(f"{user.username}|{user.password}\n")

    def load_tips(self) -> List[Tip]:
        try:
            with open('tips.txt', 'r') as file:
                return [Tip(**json.loads(line.strip())) for line in file.readlines()]
        except FileNotFoundError:
            return []

    def save_tip(self, tip: Tip):
        with open('tips.txt', 'a') as file:
            file.write(json.dumps(tip.to_dict()) + '\n')

    def load_articles(self) -> List[Article]:
        try:
            with open('articles.txt', 'r') as file:
                return [Article(**json.loads(line.strip())) for line in file.readlines()]
        except FileNotFoundError:
            return []

    def save_article(self, article: Article):
        with open('articles.txt', 'a') as file:
            file.write(json.dumps(article.to_dict()) + '\n')

    def load_forum_posts(self) -> List[ForumPost]:
        try:
            with open('forum_posts.txt', 'r') as file:
                return [ForumPost(**json.loads(line.strip())) for line in file.readlines()]
        except FileNotFoundError:
            return []

    def save_forum_post(self, post: ForumPost):
        with open('forum_posts.txt', 'a') as file:
            file.write(json.dumps(post.to_dict()) + '\n')
```

