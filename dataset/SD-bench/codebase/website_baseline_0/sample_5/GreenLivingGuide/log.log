*** main.py
```python
from flask import Flask, render_template, request, redirect, url_for, session
from user import User
from tip import Tip
from article import Article
from forum_post import ForumPost

app = Flask(__name__)
app.secret_key = 'your_secret_key'

@app.route('/')
def login():
    return render_template('login.html')

@app.route('/home')
def home():
    return render_template('home.html')

@app.route('/tips', methods=['GET', 'POST'])
def tips():
    if request.method == 'POST':
        tip_content = request.form['tip']
        tip = Tip(tip_content)
        tip.save()
        return redirect(url_for('tips'))
    return render_template('tips.html', tips=Tip().load_tips())

@app.route('/articles', methods=['GET', 'POST'])
def articles():
    if request.method == 'POST':
        title = request.form['title']
        content = request.form['content']
        article = Article(title, content)
        article.save()
        return redirect(url_for('articles'))
    return render_template('articles.html', articles=Article().load_articles())

@app.route('/forum', methods=['GET', 'POST'])
def forum():
    if request.method == 'POST':
        username = session.get('username')
        message = request.form['message']
        post = ForumPost(username, message)
        post.save()
        return redirect(url_for('forum'))
    return render_template('forum.html', posts=ForumPost().load_forum_posts())

@app.route('/register', methods=['GET', 'POST'])
def register():
    if request.method == 'POST':
        username = request.form['username']
        password = request.form['password']
        user = User(username, password)
        user.save()
        return redirect(url_for('login'))
    return render_template('register.html')

@app.route('/authenticate', methods=['POST'])
def authenticate():
    username = request.form['username']
    password = request.form['password']
    users = User().load_users()
    for user in users:
        if user.username == username and user.password == password:
            session['username'] = username
            return redirect(url_for('home'))
    return redirect(url_for('login'))

if __name__ == '__main__':
    app.run(debug=True)
```

*** user.py
```python
class User:
    def __init__(self, username: str, password: str):
        self.username = username
        self.password = password

    def save(self) -> None:
        with open('users.txt', 'a') as file:
            file.write(f"{self.username}|{self.password}\n")

    def load_users(self) -> list:
        users = []
        try:
            with open('users.txt', 'r') as file:
                for line in file:
                    username, password = line.strip().split('|')
                    users.append(User(username, password))
        except FileNotFoundError:
            pass
        return users
```

*** tip.py
```python
class Tip:
    def __init__(self, content: str):
        self.content = content

    def save(self) -> None:
        with open('tips.txt', 'a') as file:
            file.write(f"{self.content}\n")

    def load_tips(self) -> list:
        tips = []
        try:
            with open('tips.txt', 'r') as file:
                for line in file:
                    tips.append(line.strip())
        except FileNotFoundError:
            pass
        return tips
```

*** article.py
```python
class Article:
    def __init__(self, title: str, content: str):
        self.title = title
        self.content = content

    def save(self) -> None:
        with open('articles.txt', 'a') as file:
            file.write(f"{self.title}|{self.content}\n")

    def load_articles(self) -> list:
        articles = []
        try:
            with open('articles.txt', 'r') as file:
                for line in file:
                    title, content = line.strip().split('|')
                    articles.append({'title': title, 'content': content})
        except FileNotFoundError:
            pass
        return articles
```

*** forum_post.py
```python
class ForumPost:
    def __init__(self, username: str, message: str):
        self.username = username
        self.message = message

    def save(self) -> None:
        with open('forum.txt', 'a') as file:
            file.write(f"{self.username}|{self.message}\n")

    def load_forum_posts(self) -> list:
        posts = []
        try:
            with open('forum.txt', 'r') as file:
                for line in file:
                    username, message = line.strip().split('|')
                    posts.append({'username': username, 'message': message})
        except FileNotFoundError:
            pass
        return posts
```

