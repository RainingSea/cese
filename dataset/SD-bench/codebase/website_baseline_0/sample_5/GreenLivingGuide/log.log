*** templates/dashboard.html
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
</head>
<body>
    <h1>Welcome to the Dashboard</h1>
    <h2>Submit a Tip</h2>
    <form method="POST" action="{{ url_for('submit_tip') }}">
        <input type="text" name="tip" required>
        <button type="submit">Submit</button>
    </form>
    <h2>Tips</h2>
    <ul>
        {% for tip in tips %}
            <li>{{ tip.tip }}</li>
        {% endfor %}
    </ul>
    
    <h2>Submit an Article</h2>
    <form method="POST" action="{{ url_for('submit_article') }}">
        <input type="text" name="title" placeholder="Title" required>
        <textarea name="content" placeholder="Content" required></textarea>
        <button type="submit">Submit</button>
    </form>
    <h2>Articles</h2>
    <ul>
        {% for article in articles %}
            <li><strong>{{ article.title }}</strong>: {{ article.content }}</li>
        {% endfor %}
    </ul>

    <h2>Community Forum</h2>
    <form method="POST" action="{{ url_for('forum') }}">
        <textarea name="content" placeholder="Post a message" required></textarea>
        <button type="submit">Post</button>
    </form>
    <h2>Forum Posts</h2>
    <ul>
        {% for post in forum_posts %}
            <li><strong>{{ post.username }}</strong>: {{ post.content }}</li>
        {% endfor %}
    </ul>
</body>
</html>
```

