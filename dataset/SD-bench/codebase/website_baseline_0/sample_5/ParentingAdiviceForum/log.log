class ContactInquiry:
    def __init__(self, name: str, email: str, message: str) -> None:
        self.name = name
        self.email = email
        self.message = message

    def save(self) -> None:
        with open('contact_inquiries.txt', 'a') as file:
            file.write(f"{self.name}|{self.email}|{self.message}\n")
