<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Feed</title>
</head>
<body>
    <h1>Content Feed</h1>
    <form method="POST">
        <h2>Share a New Article</h2>
        <label for="title">Title:</label>
        <input type="text" id="title" name="title" required>
        <br>
        <label for="content">Content:</label>
        <textarea id="content" name="content" required></textarea>
        <br>
        <button type="submit">Share Article</button>
    </form>
    <ul>
        {% for article in articles %}
            <li>
                <h2>{{ article.title }}</h2>
                <p>{{ article.content }}</p>
                <p>Author: {{ article.author }}</p>
                <p>Likes: {{ article.likes }}</p>
                <form method="POST" action="{{ url_for('like_article', article_title=article.title) }}">
                    <button type="submit">Like</button>
                </form>
                <form method="POST" action="{{ url_for('comment_article', article_title=article.title) }}">
                    <label for="comment">Comment:</label>
                    <input type="text" id="comment" name="content" required>
                    <button type="submit">Comment</button>
                </form>
                <ul>
                    {% for comment in article.comments %}
                        <li>{{ comment.author }}: {{ comment.content }}</li>
                    {% endfor %}
                </ul>
            </li>
        {% endfor %}
    </ul>
    <a href="/profile">Go to Profile</a>
</body>
</html>
