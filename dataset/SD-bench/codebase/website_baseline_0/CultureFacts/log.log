                    <a href="{{ url_for('culture_details', culture_name=culture) }}">{{ culture }}</a>
                </li>
            {% endfor %}
        </ul>
        <a href="/logout" class="btn btn-danger">Logout</a>
    </div>
</body>
</html>
```

