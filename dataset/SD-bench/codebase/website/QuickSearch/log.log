*** templates/dashboard.html
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <title>Dashboard</title>
</head>
<body>
    <div class="container">
        <h2>Dashboard</h2>
        <h3>Available Books</h3>
        <ul>
            {% for book in books %}
                <li><a href="{{ url_for('book_details', title=book.title) }}">{{ book.title }}</a> by {{ book.author }}</li>
            {% endfor %}
        </ul>
        <a href="/reading_list" class="btn btn-info">View Reading List</a>
        <a href="/logout" class="btn btn-danger">Logout</a>
    </div>
</body>
</html>
```

*** templates/book_details.html
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <title>Book Details</title>
</head>
<body>
    <div class="container">
        <h2>{{ book.title }}</h2>
        <p><strong>Author:</strong> {{ book.author }}</p>
        <p><strong>Summary:</strong> {{ book.summary }}</p>
        <img src="{{ book.cover_image }}" alt="Cover Image" class="img-fluid">
        <a href="/dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</body>
</html>
