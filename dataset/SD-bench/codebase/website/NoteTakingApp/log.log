```python
import os

class FileManager:
    def save_user_data(self, user):
        with open('users.txt', 'a') as f:
            f.write(f"{user.username}:{user.password}\n")

    def load_user_data(self):
        users = []
        if os.path.exists('users.txt'):
            with open('users.txt', 'r') as f:
                for line in f:
                    username, password = line.strip().split(':')
                    users.append(User(username, password))
        return users

    def save_note_data(self, note):
        with open('notes.txt', 'a') as f:
            f.write(f"{note.username}:{note.title}:{note.content}\n")

    def load_note_data(self, username):
        notes = []
        if os.path.exists('notes.txt'):
            with open('notes.txt', 'r') as f:
                for line in f:
                    note_username, title, content = line.strip().split(':')
                    if note_username == username:
                        notes.append(Note(note_username, title, content))
        return notes
```

*** user.py
```python
from file_manager import FileManager

class User:
    def __init__(self, username: str, password: str):
        self.username = username
        self.password = password

    def register(self, username: str, password: str) -> bool:
        file_manager = FileManager()
        users = file_manager.load_user_data()
        if any(user.username == username for user in users):
            return False
        new_user = User(username, password)
        file_manager.save_user_data(new_user)
        return True

    def login(self, username: str, password: str) -> bool:
        file_manager = FileManager()
        users = file_manager.load_user_data()
        return any(user.username == username and user.password == password for user in users)
```

