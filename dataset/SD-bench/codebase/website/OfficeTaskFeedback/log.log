*** main.py
```python
from flask import Flask, render_template, request, redirect, session
from user import User
from feedback import Feedback
from feedback_tracker import FeedbackTracker

app = Flask(__name__)
app.secret_key = 'your_secret_key'
tracker = FeedbackTracker()

def load_users():
    users = []
    try:
        with open('users.txt', 'r') as file:
            for line in file:
                username, password = line.strip().split('|')
                users.append(User(username, password))
    except FileNotFoundError:
        pass
    return users

users = load_users()

@app.route('/', methods=['GET', 'POST'])
def login():
    if request.method == 'POST':
        username = request.form['username']
        password = request.form['password']
        if login_user(username, password):
            return redirect('/feedback')
    return render_template('login.html')

def login_user(username: str, password: str) -> bool:
    for user in users:
        if user.username == username and user.password == password:
            session['username'] = username
            return True
    return False

@app.route('/register', methods=['GET', 'POST'])
def register():
    if request.method == 'POST':
        username = request.form['username']
        password = request.form['password']
        if register_user(username, password):
            return redirect('/')
    return render_template('register.html')

def register_user(username: str, password: str) -> bool:
    for user in users:
        if user.username == username:
            return False
    new_user = User(username, password)
    new_user.save()
    users.append(new_user)
    return True

@app.route('/feedback', methods=['GET', 'POST'])
def feedback():
    if request.method == 'POST':
        user = session['username']
        content = request.form['content']
        category = request.form['category']
        submit_feedback(user, content, category)
        return redirect('/status')
    return render_template('feedback.html')

def submit_feedback(user: str, content: str, category: str) -> None:
    feedback = Feedback(user, content, category)
    feedback.save()

@app.route('/status')
def status():
    user = session.get('username')
    feedback_status = tracker.get_status(user)
    return render_template('status.html', feedback_status=feedback_status)

if __name__ == '__main__':
    app.run(debug=True)
```

*** user.py
```python
class User:
    def __init__(self, username: str, password: str):
        self.username = username
        self.password = password

    def save(self) -> None:
        with open('users.txt', 'a') as file:
            file.write(f"{self.username}|{self.password}\n")

    @staticmethod
    def load(username: str) -> 'User':
        with open('users.txt', 'r') as file:
            for line in file:
                user_data = line.strip().split('|')
                if user_data[0] == username:
                    return User(user_data[0], user_data[1])
        return None
```

*** feedback.py
```python
class Feedback:
    def __init__(self, user: str, content: str, category: str):
        self.user = user
        self.content = content
        self.category = category
        self.status = 'Pending'

    def save(self) -> None:
        with open('feedback.txt', 'a') as file:
            file.write(f"{self.user}|{self.content}|{self.category}|{self.status}\n")

    @staticmethod
    def load_all() -> list:
        feedbacks = []
        try:
            with open('feedback.txt', 'r') as file:
                for line in file:
                    user, content, category, status = line.strip().split('|')
                    feedbacks.append(Feedback(user, content, category))
                    feedbacks[-1].status = status
        except FileNotFoundError:
            pass
        return feedbacks
```

*** feedback_tracker.py
```python
from feedback import Feedback

class FeedbackTracker:
    def __init__(self):
        self.feedbacks = Feedback.load_all()

    def track_feedback(self, feedback: Feedback) -> None:
        self.feedbacks.append(feedback)

    def update_status(self, feedback_id: int, status: str) -> None:
        if 0 <= feedback_id < len(self.feedbacks):
            self.feedbacks[feedback_id].status = status
            self.save_status()

    def get_status(self, user: str) -> list:
        return [feedback for feedback in self.feedbacks if feedback.user == user]

    def save_status(self) -> None:
        with open('feedback_status.txt', 'w') as file:
            for feedback in self.feedbacks:
                file.write(f"{feedback.user}|{feedback.content}|{feedback.category}|{feedback.status}\n")
```

