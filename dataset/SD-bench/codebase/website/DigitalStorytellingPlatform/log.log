    END IF
    REDIRECT to '/'
END FUNCTION

FUNCTION login(username, password)
    FOR EACH user IN users
        IF user.username == username AND user.password == password THEN
            RETURN True
        END IF
    END FOR
    RETURN False
END FUNCTION
