                if post[0] != self.title:
                    file.write('|'.join(post) + '\n')

    def view_post(self) -> str:
        return f"{self.title}\n{self.content}\nBy: {self.author}"

    @staticmethod
    def load_posts() -> list:
        posts = []
        try:
            with open('posts.txt', 'r') as file:
                for line in file:
                    posts.append(line.strip().split('|'))
        except FileNotFoundError:
            return posts
        return posts
```

