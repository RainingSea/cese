        time.sleep(2)  # Wait for the web application to fully start
        self.driver = webdriver.Chrome()
        self.driver.get('http://localhost:8064/') 

    def tearDown(self):
        # Close the web driver session
        self.driver.quit()
        self.process.terminate()

