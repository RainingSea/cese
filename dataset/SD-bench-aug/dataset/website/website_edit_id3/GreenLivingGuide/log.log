class Article:
    def __init__(self, title: str, content: str):
        self.title = title
        self.content = content

    def save(self) -> None:
        with open('articles.txt', 'a') as file:
            file.write(f"{self.title}|{self.content}\n")

    @staticmethod
    def load_articles() -> list:
        articles = []
        with open('articles.txt', 'r') as file:
            for line in file:
                title, content = line.strip().split('|')
                articles.append(Article(title, content))
        return articles

file name: forum_post.py

class ForumPost:
    def __init__(self, username: str, content: str):
        self.username = username
        self.content = content

    def save(self) -> None:
        with open('forum.txt', 'a') as file:
            file.write(f"{self.username}|{self.content}\n")

    @staticmethod
    def load_posts() -> list:
        posts = []
        with open('forum.txt', 'r') as file:
            for line in file:
                username, content = line.strip().split('|')
                posts.append(ForumPost(username, content))
        return posts

