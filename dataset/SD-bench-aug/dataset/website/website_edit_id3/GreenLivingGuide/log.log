        forum_post = ForumPost(username, post_content)
        forum_post.save()
        return redirect(url_for('forum'))
    posts = ForumPost.load_posts()
    return render_template('forum.html', posts=posts)

@app.route('/logout')
def logout():
    session.clear()
    return redirect(url_for('login'))

if __name__ == '__main__':
    app.run(debug=True)
```

