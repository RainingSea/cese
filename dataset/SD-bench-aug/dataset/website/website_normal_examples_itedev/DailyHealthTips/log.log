from flask import Flask, render_template, request, redirect, url_for, session
from user_manager import UserManager
from tip_manager import TipManager
from feedback_manager import FeedbackManager

app = Flask(__name__)
app.secret_key = 'your_secret_key'  # Change this to a random secret key

# Initialize managers
user_manager = UserManager('users.txt')
tip_manager = TipManager('tips.txt')
feedback_manager = FeedbackManager('feedback.txt')

@app.route('/')
def login():
    return render_template('login.html')

@app.route('/register', methods=['GET', 'POST'])
def register():
    if request.method == 'POST':
        username = request.form['username']
        password = request.form['password']
        if user_manager.register(username, password):
            return redirect(url_for('login'))
    return render_template('register.html')

@app.route('/archive')
def archive():
    if 'username' not in session:
        return redirect(url_for('login'))
    daily_tip = tip_manager.get_daily_tip()
    return render_template('archive.html', daily_tip=daily_tip)

@app.route('/feedback', methods=['GET', 'POST'])
def feedback():
    if request.method == 'POST':
        user = session['username']
        feedback = request.form['feedback']
        feedback_manager.submit_feedback(user, feedback)
        return redirect(url_for('archive'))
    return render_template('feedback.html')

@app.route('/login', methods=['POST'])
def do_login():
    username = request.form['username']
    password = request.form['password']
    if user_manager.login(username, password):
        session['username'] = username
        return redirect(url_for('archive'))
    return redirect(url_for('login'))

@app.route('/logout')
def logout():
    session.pop('username', None)
    return redirect(url_for('login'))

if __name__ == '__main__':
    app.run(debug=True)

file name: user_manager.py

class UserManager:
    def __init__(self, users_file: str):
        self.users_file = users_file
        self.load_users()

    def load_users(self):
        self.users = {}
        try:
            with open(self.users_file, 'r') as file:
                for line in file:
                    username, password = line.strip().split('|')
                    self.users[username] = password
        except FileNotFoundError:
            pass

    def register(self, username: str, password: str) -> bool:
        if username in self.users:
            return False
        self.users[username] = password
        with open(self.users_file, 'a') as file:
            file.write(f"{username}|{password}\n")
        return True

    def login(self, username: str, password: str) -> bool:
        return self.users.get(username) == password

    def get_users(self) -> list:
        return list(self.users.keys())

file name: tip_manager.py

class TipManager:
    def __init__(self, tips_file: str):
        self.tips_file = tips_file
        self.load_tips()

    def load_tips(self):
        self.tips = []
        try:
            with open(self.tips_file, 'r') as file:
                for line in file:
                    self.tips.extend(line.strip().split('|'))
        except FileNotFoundError:
            pass

    def get_daily_tip(self) -> str:
        return self.tips[0] if self.tips else "No tips available."

    def get_previous_tip(self, current_index: int) -> str:
        if current_index > 0:
            return self.tips[current_index - 1]
        return "No previous tips."

    def get_next_tip(self, current_index: int) -> str:
        if current_index < len(self.tips) - 1:
            return self.tips[current_index + 1]
        return "No more tips."

    def search_tips(self, query: str) -> list:
        return [tip for tip in self.tips if query.lower() in tip.lower()]

    def get_all_tips(self) -> list:
        return self.tips

file name: feedback_manager.py

class FeedbackManager:
    def __init__(self, feedback_file: str):
        self.feedback_file = feedback_file
        self.load_feedback()

    def load_feedback(self):
        self.feedback = []
        try:
            with open(self.feedback_file, 'r') as file:
                for line in file:
                    self.feedback.append(line.strip())
        except FileNotFoundError:
            pass

    def submit_feedback(self, user: str, feedback: str) -> None:
        with open(self.feedback_file, 'a') as file:
            file.write(f"{user}|{feedback}\n")
        self.feedback.append(feedback)

    def get_feedback(self) -> list:
        return self.feedback

