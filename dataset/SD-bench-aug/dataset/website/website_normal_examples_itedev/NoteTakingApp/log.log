    <a href="{{ url_for('logout') }}">Logout</a>
    <h2>Your Notes</h2>
    <ul>
        {% for note in notes %}
            <li>
                <a href="{{ url_for('view_note', title=note.title) }}">{{ note.title }}</a>
            </li>
