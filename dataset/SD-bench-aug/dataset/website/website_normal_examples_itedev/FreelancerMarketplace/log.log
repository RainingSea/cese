            <li>
                <strong>{{ project.name }}</strong>: {{ project.description }} (Assigned to: {{ project.freelancer }})
            </li>
        {% else %}
            <li>No projects available.</li>
        {% endfor %}
    </ul>
    <a href="/home">Back to Home</a>
</body>
</html>
