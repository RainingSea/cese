                <a href="{{ url_for('view_post', title=post['title']) }}">{{ post['title'] }}</a>
                <form method="POST" action="{{ url_for('delete_post', title=post['title']) }}">
                    <button type="submit">Delete</button>
                </form>
            </li>
        {% endfor %}
    </ul>
</body>
</html>
