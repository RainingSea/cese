        else:
            self.items[product.id] = {'product': product, 'quantity': 1}

    def remove_item(self, product_id: int) -> None:
        if product_id in self.items:
            del self.items[product_id]

    def get_items(self) -> dict:
        return self.items

    def clear(self) -> None:
        self.items.clear()

class Application:
