FUNCTION get_list(username)  
    READ reading_lists.txt INTO dictionary lists  
    RETURN lists.get(username, [])  
END FUNCTION  

FUNCTION remove_from_list(username, book_title)  
    READ reading_lists.txt INTO dictionary lists  
    IF username IN lists AND book_title IN lists[username]  
        REMOVE book_title FROM lists[username]  
        WRITE lists back to reading_lists.txt  
        RETURN True  
    RETURN False  
END FUNCTION  

ROUTE /reading_list  
