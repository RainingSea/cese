Example implementation improvement for BookManager:

```python
class BookManager:
    def __init__(self, books_file='books.txt'):
        self.books_file = books_file
        
    def _validate_book_line(self, line):
        """Validate the format of a book record line"""
        parts = line.strip().split('|')
        return len(parts) == 4 and all(parts)

    def search(self, query):
        results = []
        with open(self.books_file, 'r') as f:
            for line in f:
                if not self._validate_book_line(line):
                    continue  # or log error
                title, author, summary, description = line.strip().split('|')
                if query.lower() in title.lower() or query.lower() in author.lower():
                    results.append(Book(title, author, summary, description))
        return results
```

