<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Reading List</title>
</head>
<body>
    <h2>{{ username }}'s Reading List</h2>
    <p><a href="{{ url_for('dashboard') }}">Back to Dashboard</a> | <a href="{{ url_for('logout') }}">Logout</a></p>
    {% if message %}
    <p style="color:green;">{{ message }}</p>
    {% endif %}
    {% if books %}
    <ul>
        {% for book in books %}
        <li>
            <strong><a href="{{ url_for('book_details', book_id=book.id) }}">{{ book.title }}</a></strong> by {{ book.author }}
            <form method="post" action="{{ url_for('reading_list') }}" style="display:inline;">
                <input type="hidden" name="remove_id" value="{{ book.id }}">
                <button type="submit">Remove</button>
            </form>
        </li>
        {% endfor %}
    </ul>
    {% else %}
    <p>Your reading list is empty.</p>
    {% endif %}
</body>
</html>
```

