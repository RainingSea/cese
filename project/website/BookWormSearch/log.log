FUNCTION add_to_list(username, book_title)  
    READ reading_lists.txt INTO dictionary lists  
    IF username NOT IN lists  
        SET lists[username] = []  
    IF book_title NOT IN lists[username]  
        APPEND book_title to lists[username]  
        WRITE lists back to reading_lists.txt  
        RETURN True  
    RETURN False  
END FUNCTION  

ROUTE /add_to_list/<title>  
    IF 'username' NOT IN session  
        REDIRECT to login  
