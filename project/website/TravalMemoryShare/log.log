        self.album = album
        self.likes = []
        self.comments = []

    def like(self, user: User):
        if user.username not in self.likes:
            self.likes.append(user.username)

    def comment(self, user: User, comment: str):
        self.comments.append((user.username, comment))

class InteractionController:
