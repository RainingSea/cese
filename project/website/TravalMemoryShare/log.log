FUNCTION register()
    IF POST request received
        SET username to request.form['username']
        SET password to request.form['password']
        IF user_manager.register(username, password) is True THEN
            REDIRECT to login
        ELSE
            RETURN "Username already exists!"
        ENDIF
    ENDIF
    RENDER registration.html
END FUNCTION

FUNCTION user_manager.register(username, password)
    IF username exists in self.users THEN
        RETURN False
    ELSE
        ADD {'username': username, 'password': password} to self.users
        APPEND username|password to 'users.txt'
        RETURN True
    ENDIF
END FUNCTION
