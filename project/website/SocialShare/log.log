        self.assertIn('Login', self.driver.title)
        
        # Attempt to access protected page
        self.driver.get('http://localhost:8101/feed')
        self.wait.until(EC.url_contains('/login'))
        self.assertIn('Login', self.driver.title)

    # Functionality 8: User Interaction (Follow and Message)
