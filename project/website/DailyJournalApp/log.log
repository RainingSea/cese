CLASS JournalEntry:
    FUNCTION __init__(title: str, content: str, date: str):
        SET self.title TO title
        SET self.content TO content
        SET self.date TO date

    FUNCTION save_entry() -> None:
        OPEN 'journal_entries.txt' for appending AS file:
            WRITE f"{self.title}|{self.content}|{self.date}\n" TO file

    STATIC FUNCTION load_entries() -> list:
        INITIALIZE entries AS EMPTY list
        OPEN 'journal_entries.txt' for reading AS file:
            FOR EACH line IN file:
                SPLIT line BY '|' INTO title, content, date
                APPEND JournalEntry(title, content, date) TO entries
        RETURN entries

CLASS App:
    FUNCTION create_entry(title: str, content: str) -> None:
        IMPORT datetime
        SET date TO CURRENT datetime FORMATTED AS "Y-m-d H:M:S"
        INITIALIZE new_entry AS JournalEntry(title, content, date)
        CALL new_entry.save_entry()
        APPEND new_entry TO self.entries
```

