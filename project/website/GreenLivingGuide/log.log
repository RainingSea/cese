*** templates/dashboard.html
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
</head>
<body>
    <h1>Dashboard</h1>
    <h2>Tips</h2>
    <ul>
        {% for tip in tips %}
            <li>{{ tip.content }} - <em>{{ tip.author }}</em></li>
        {% endfor %}
    </ul>

    <h2>Articles</h2>
    <ul>
        {% for article in articles %}
            <li><strong>{{ article.title }}</strong>: {{ article.content }} - <em>{{ article.author }}</em></li>
        {% endfor %}
    </ul>

    <h3>Submit a Tip</h3>
    <form method="POST" action="/submit_tip">
        <textarea name="content" placeholder="Enter your tip..." required></textarea>
        <button type="submit">Submit Tip</button>
    </form>

    <h3>Submit an Article</h3>
    <form method="POST" action="/submit_article">
        <input type="text" name="title" placeholder="Article Title" required>
        <textarea name="content" placeholder="Enter your article..." required></textarea>
        <button type="submit">Submit Article</button>
    </form>

    <a href="/forum">Go to Forum</a>
</body>
</html>
```

