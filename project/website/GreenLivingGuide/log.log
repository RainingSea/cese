FUNCTION login(username, password)
    LOAD users from 'users.txt' file
    FOR each user IN users
        IF user.username == username AND user.password == password 
            RETURN True  // User successfully logged in
    RETURN False  // Login failed
END FUNCTION

FUNCTION dashboard()
    IF user is logged in
        DISPLAY dashboard including:
            TIPS from TipManager.view_tips()
            ARTICLES from ArticleManager.view_articles()
            POSTS from ForumManager.view_posts()
    ELSE
        REDIRECT to login page
    END IF
END FUNCTION
```
|Case|:**login**
```python
CLASS UserManager
    FUNCTION __init__()
        LOAD users from 'users.txt'
        PARSE users into (username, password) tuples
        STORE users in self.users
    END FUNCTION

    FUNCTION login(username, password)
        FOR each (user, pwd) IN self.users
            IF user == username AND pwd == password
                RETURN True
            ENDIF
        ENDFOR
        RETURN False
    END FUNCTION 

CLASS ContentManager
    FUNCTION __init__()
        LOAD tips from 'tips.txt'
        LOAD articles from 'articles.txt'
        LOAD forum posts from 'forum.txt'
    END FUNCTION

    FUNCTION load_users()
        OPEN 'users.txt'
        READ file lines
        FOR each line IN lines
            SPLIT line by '|'
            APPEND (username, password) to users list
        ENDFOR
        RETURN users
    END FUNCTION

FUNCTION login()
    IF request.method == 'POST'
        username = FORM input for 'username'
        password = FORM input for 'password'
        IF user_manager.login(username, password)
            SET session['username'] = username
            REDIRECT to '/home'
        ELSE
            RETURN "Login Failed"
        ENDIF
    ENDIF
    RENDER login page template
END FUNCTION
```

