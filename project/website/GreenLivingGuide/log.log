           ENDFOR
       ENDIF
       RETURN render_template('login.html')
   END FUNCTION
   ```

4. |Case|:**view_and_submit_tips**
   ```
   FUNCTION tips()
       IF request method is POST THEN
           title = get title from form
           content = get content from form
           tip = create new Tip with title and content
           data_manager.save_tip(tip)
           redirect to '/tips'
       ENDIF
       tips = data_manager.load_tips()
       RETURN render_template('tips.html', tips=tips)
   END FUNCTION
   ```

5. |Case|:**user_login**
   ```
   class UserManager:
       method __init__():
           self.users = load_users()

       method load_users() -> dict:
           users = {}
           try:
               open 'users.txt' for reading as file:
                   for each line in file:
                       username, password = split line by '|'
                       users[username] = password
           except FileNotFoundError:
               pass
           return users

       method validate_user(username: str, password: str) -> bool:
           return self.users.get(username) == password

   class Main:
       method login(username: str, password: str) -> bool:
           return self.user_manager.validate_user(username, password)
   ```

6. |Case|:**view_and_submit_sustainable_living_tips**
   ```
   class TipManager:
       method __init__():
           self.tips = load_tips()

       method load_tips() -> list:
           tips = []
           try:
               open 'tips.txt' for reading as file:
                   for each line in file:
                       tips.append(strip line)
           except FileNotFoundError:
               pass
           return tips

       method add_tip(tip: str) -> bool:
           self.tips.append(tip)
           return save_tips()

       method save_tips() -> bool:
           try:
               open 'tips.txt' for writing as file:
                   for each tip in self.tips:
                       file.write(tip + newline)
           except Exception as e:
               print("Error saving tips: " + str(e))
               return False

   class Main:
       method submit_tip(tip: str) -> bool:
           return self.tip_manager.add_tip(tip)
   ```

