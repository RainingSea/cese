        <h5>Cultural Background:</h5>
        <p>{{ story[2] }}</p>
        <button onclick="addBookmark('{{ story[0] }}')" class="btn btn-primary">Add to Bookmarks</button>
        <a href="/dashboard" class="btn btn-link">Back to Dashboard</a>
    </div>
    <script>
        function addBookmark(title) {
            fetch('/bookmarks', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ title: title })
            }).then(response => {
                if (response.ok) {
                    alert('Story added to bookmarks!');
                } else {
                    alert('Error adding bookmark.');
                }
            });
        }
    </script>
</body>
</html>
