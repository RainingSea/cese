<body>
    <div class="container">
        <h2>Your Bookmarks</h2>
        <ul class="list-group">
            {% for title in bookmarks %}
                <li class="list-group-item">
                    <a href="/story/{{ title }}">{{ title }}</a>
                    <button onclick="removeBookmark('{{ title }}')" class="btn btn-danger btn-sm float-right">Remove</button>
                </li>
            {% endfor %}
        </ul>
        <a href="/dashboard" class="btn btn-link">Back to Dashboard</a>
    </div>
    <script>
        function removeBookmark(title) {
            fetch('/bookmarks', {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ title: title })
            }).then(response => {
                if (response.ok) {
                    alert('Bookmark removed!');
                    location.reload();
                } else {
                    alert('Error removing bookmark.');
                }
            });
        }
    </script>
</body>
</html>
