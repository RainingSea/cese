FUNCTION apply(job_id)  
    IF session['username'] NOT EXISTS  
        REDIRECT to login  
    users = LOAD users.txt  
    FOR user IN users  
        IF user[0] == session['username']  
            applied_jobs = SPLIT user[3] (if exists)  
            IF job_id NOT IN applied_jobs  
                ADD job_id to applied_jobs  
                user[3] = JOIN applied_jobs  
    SAVE updated users to users.txt  
    REDIRECT to jobs  
```
