CLASS User
    FUNCTION __init__(username, password, email)
        SET self.username = username
        SET self.password = password
        SET self.email = email
    END FUNCTION

    FUNCTION register()
        IF username AND password AND email are NOT EMPTY
            OPEN 'users.txt' file in append mode
            WRITE (username, password, email) to 'users.txt' in format: 'username|password|email'
            CLOSE file
            RETURN TRUE
        ENDIF
        RETURN FALSE
    END FUNCTION
END CLASS
