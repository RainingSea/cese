class ReadingList:
    def __init__(self, user):
        self.user = user
        self.books = []

    def add_book(self, book) -> None:
        if book not in self.books:
            self.books.append(book)

    def remove_book(self, book) -> None:
        if book in self.books:
            self.books.remove(book)

    def get_reading_list(self) -> list:
        return self.books

