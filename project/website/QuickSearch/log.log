        <button type="submit">Search</button>
    </form>
    <h2>Search Results</h2>
    <ul>
        {% for title in results %}
            <li><a href="{{ url_for('book_details', title=title) }}">{{ title }}</a></li>
        {% endfor %}
    </ul>
    <a href="{{ url_for('reading_list') }}">View Reading List</a>
    <a href="{{ url_for('logout') }}">Logout</a>
</body>
</html>
```

*** templates/book_details.html
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ book.title }}</title>
</head>
<body>
    <h1>{{ book.title }}</h1>
    <p><strong>Author:</strong> {{ book.author }}</p>
    <p><strong>Summary:</strong> {{ book.summary }}</p>
    <img src="{{ book.cover_image }}" alt="Cover Image">
    <a href="{{ url_for('add_to_reading_list', title=book.title) }}">Add to Reading List</a>
    <a href="{{ url_for('dashboard') }}">Back to Dashboard</a>
</body>
</html>
```

*** templates/reading_list.html
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reading List</title>
</head>
<body>
    <h1>Your Reading List</h1>
    <ul>
        {% for book in reading_list %}
            <li>{{ book }}</li>
        {% endfor %}
    </ul>
    <a href="{{ url_for('dashboard') }}">Back to Dashboard</a>
</body>
</html>
