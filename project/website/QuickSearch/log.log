*** UserManager.py
```python
import bcrypt

class UserManager:
    def __init__(self):
        self.users = self.load_users('users.txt')

    def load_users(self, file_path: str) -> dict:
        users = {}
        with open(file_path, 'r') as file:
            for line in file:
                username, password = line.strip().split('|')
                users[username] = password
        return users

    def register(self, username: str, password: str) -> bool:
        if username not in self.users:
            hashed_password = bcrypt.hashpw(password.encode('utf-8'), bcrypt.gensalt()).decode('utf-8')
            self.users[username] = hashed_password
            with open('users.txt', 'a') as file:
                file.write(f"{username}|{hashed_password}\n")
            return True
        return False

    def login(self, username: str, password: str) -> bool:
        stored_password = self.users.get(username)
        if stored_password and bcrypt.checkpw(password.encode('utf-8'), stored_password.encode('utf-8')):
            return True
        return False
```

*** BookManager.py
```python
class BookManager:
    def __init__(self):
        self.books = self.load_books('books.txt')

    def load_books(self, file_path: str) -> list:
        books = []
        with open(file_path, 'r') as file:
            for line in file:
                title, author, book_id = line.strip().split('|')
                books.append({'title': title, 'author': author, 'id': book_id})
        return books

    def search_books(self, query: str) -> list:
        return [book for book in self.books if query.lower() in book['title'].lower()]

    def get_book_details(self, book_id: str) -> dict:
        for book in self.books:
            if book['id'] == book_id:
                return book
        return {}
```

*** ReadingListManager.py
```python
class ReadingListManager:
    def __init__(self):
        self.reading_lists = self.load_reading_lists('reading_list.txt')

    def load_reading_lists(self, file_path: str) -> dict:
        reading_lists = {}
        with open(file_path, 'r') as file:
            for line in file:
                username, book_id = line.strip().split('|')
                if username not in reading_lists:
                    reading_lists[username] = []
                reading_lists[username].append(book_id)
        return reading_lists

    def add_to_reading_list(self, username: str, book_id: str) -> None:
        if username not in self.reading_lists:
            self.reading_lists[username] = []
        self.reading_lists[username].append(book_id)
        with open('reading_list.txt', 'a') as file:
            file.write(f"{username}|{book_id}\n")

    def get_reading_list(self, username: str) -> list:
        return self.reading_lists.get(username, [])

    def remove_from_reading_list(self, username: str, book_id: str) -> None:
        if username in self.reading_lists and book_id in self.reading_lists[username]:
            self.reading_lists[username].remove(book_id)
            self.save_reading_lists()

    def save_reading_lists(self) -> None:
        with open('reading_list.txt', 'w') as file:
            for username, books in self.reading_lists.items():
                for book_id in books:
                    file.write(f"{username}|{book_id}\n")
```

*** main.py
```python
from flask import Flask, render_template, request, redirect, session, url_for
from UserManager import UserManager
from BookManager import BookManager
from ReadingListManager import ReadingListManager

app = Flask(__name__)
app.secret_key = 'your_secret_key'

user_manager = UserManager()
book_manager = BookManager()
reading_list_manager = ReadingListManager()

@app.route('/')
def login():
    return render_template('login.html')

@app.route('/register', methods=['GET', 'POST'])
def register():
    if request.method == 'POST':
        username = request.form['username']
        password = request.form['password']
        if user_manager.register(username, password):
            return redirect(url_for('login'))
    return render_template('register.html')

@app.route('/dashboard', methods=['GET', 'POST'])
def dashboard():
    if 'username' not in session:
        return redirect(url_for('login'))
    if request.method == 'POST':
        query = request.form['search']
        search_results = book_manager.search_books(query)
        return render_template('dashboard.html', books=search_results)
    return render_template('dashboard.html', books=book_manager.books)

@app.route('/login', methods=['POST'])
def do_login():
    username = request.form['username']
    password = request.form['password']
    if user_manager.login(username, password):
        session['username'] = username
        return redirect(url_for('dashboard'))
    return redirect(url_for('login'))

@app.route('/logout')
def logout():
    session.pop('username', None)
    return redirect(url_for('login'))

@app.route('/book/<book_id>')
def book_details(book_id):
    book = book_manager.get_book_details(book_id)
    return render_template('book_details.html', book=book)

@app.route('/reading_list')
def reading_list():
    if 'username' not in session:
        return redirect(url_for('login'))
    user_reading_list = reading_list_manager.get_reading_list(session['username'])
    return render_template('reading_list.html', reading_list=user_reading_list)

if __name__ == '__main__':
    app.run(debug=True)
```

