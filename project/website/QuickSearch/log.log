2. |Case|:**user_login**
```pseudocode
FUNCTION login_user()
    IF REQUEST_METHOD IS POST
        username = EXTRACT 'username' FROM request.form
        password = EXTRACT 'password' FROM request.form

        IF user_manager.login(username, password) THEN
            REDIRECT TO '/dashboard'
        ELSE
            RETURN "Login failed", STATUS_CODE 400
        ENDIF
    ENDIF
END FUNCTION

CLASS UserManager
    FUNCTION login(self, username, password) -> bool
        IF username IN self.users AND self.users[username] EQUALS password THEN
            session['username'] = username
            RETURN True
        ELSE
            RETURN False
        ENDIF
    END FUNCTION
END CLASS
```

3. |Case|:**view_book_details**
```pseudocode
FUNCTION book_details(title)
    book = search_engine.get_book_details(title)
    RETURN render_template('book_details.html', book=book)
END FUNCTION

CLASS SearchEngine
    FUNCTION get_book_details(self, title) -> book
        FOR EACH book IN self.books
            IF book['title'] EQUALS title THEN
                RETURN book
            ENDIF
        ENDFOR
        RETURN EMPTY DICTIONARY
    END FUNCTION
END CLASS
