        ELSE
            RETURN "Login failed", STATUS_CODE 400
        ENDIF
    ENDIF
END FUNCTION

CLASS UserManager
    FUNCTION login(self, username, password) -> bool
        IF username IN self.users AND self.users[username] EQUALS password THEN
