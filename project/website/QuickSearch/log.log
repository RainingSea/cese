class UserManager:
    def __init__(self):
        self.users = self.load_users('users.txt')

    def load_users(self, file_path):
        users = {}
        with open(file_path, 'r') as file:
            for line in file:
                username, password = line.strip().split('|')
                users[username] = password
        return users

    def register(self, username: str, password: str) -> bool:
        if username not in self.users:
            self.users[username] = password
            with open('users.txt', 'a') as file:
                file.write(f"{username}|{password}\n")
            return True
        return False

    def login(self, username: str, password: str) -> bool:
        return self.users.get(username) == password
```

*** book_manager.py
```python
class Book:
    def __init__(self, book_id, title, author, description):
        self.book_id = book_id
        self.title = title
        self.author = author
        self.description = description

    def get_details(self):
        return {
            'id': self.book_id,
            'title': self.title,
            'author': self.author,
            'description': self.description
        }

class BookManager:
    def __init__(self):
        self.books = self.load_books('books.txt')

    def load_books(self, file_path):
        books = []
        with open(file_path, 'r') as file:
            for line in file:
                book_id, title, author, description = line.strip().split('|')
                books.append(Book(book_id, title, author, description))
        return books

    def search_books(self, query: str) -> list:
        return [book.get_details() for book in self.books if query.lower() in book.title.lower()]

    def get_book_details(self, book_id: str) -> dict:
        for book in self.books:
            if book.book_id == book_id:
                return book.get_details()
        return {}
```

*** reading_list.py
```python
class ReadingList:
    def __init__(self):
        self.reading_list = {}

    def load_reading_list(self, username: str) -> list:
        if username not in self.reading_list:
            self.reading_list[username] = []
            self.load_reading_list_from_file(username)
        return self.reading_list[username]

    def load_reading_list_from_file(self, username: str):
        try:
            with open('reading_lists.txt', 'r') as file:
                for line in file:
                    user, book_id = line.strip().split('|')
                    if user == username:
                        self.reading_list[username].append(book_id)
        except FileNotFoundError:
            pass

    def save_reading_list(self, username: str) -> None:
        with open('reading_lists.txt', 'a') as file:
            for book_id in self.reading_list[username]:
                file.write(f"{username}|{book_id}\n")

    def add_to_reading_list(self, username: str, book_id: str) -> None:
        if username not in self.reading_list:
            self.reading_list[username] = []
        self.reading_list[username].append(book_id)
        self.save_reading_list(username)

    def remove_from_reading_list(self, username: str, book_id: str) -> None:
        if username in self.reading_list and book_id in self.reading_list[username]:
            self.reading_list[username].remove(book_id)
            self.save_reading_list(username)
```

