### Passed Test Cases
1. |Case|:**user_registration**
```python
class User:
    users_file = 'users.txt'

    # Constructor
    FUNCTION User(username: str, password: str)
        SET self.username = username
        SET self.password = password
    END FUNCTION

    # Load users from a file
    FUNCTION load_users() RETURNS users_dict
        SET users_dict = {}
        IF os.path.exists(users_file)
            OPEN users_file IN READ MODE AS file
                FOR line IN file
                    SPLIT line BY '|'
                    SET username = VALUE[0]
                    SET password = VALUE[1]
                    SET users_dict[username] = password
                END FOR
            END OPEN file
        RETURN users_dict
    END FUNCTION

    # Register a new user
    FUNCTION register() RETURNS BOOL
        IF self.username NOT IN load_users()
            OPEN users_file IN APPEND MODE AS file
                WRITE self.username + '|' + self.password + '\n' TO file
            END OPEN file
            RETURN True
        END IF
        RETURN False
    END FUNCTION
```
2. |Case|:**add_books_to_reading_list**
```pseudocode
CLASS ReadingList
    FUNCTION __init__(filename: str)
        SET self.filename = filename
        SET self.reading_lists = load_reading_lists()

    FUNCTION add_to_reading_list(username: str, book_title: str) -> bool
        IF username is in self.reading_lists
            IF book_title is not in self.reading_lists[username]
                APPEND book_title to self.reading_lists[username]
        ELSE
            SET self.reading_lists[username] = [book_title]
        CALL save_reading_lists()
        RETURN TRUE

    FUNCTION get_reading_list(username: str) -> list
        RETURN self.reading_lists.get(username, [])

    FUNCTION load_reading_lists() -> dict
        SET reading_lists = {}
        TRY
            OPEN file with self.filename as file
                FOR each line in file
                    SPLIT line by '|' into username and books
                    SET reading_lists[username] = SPLIT books by ','
        EXCEPT FileNotFoundError
            PASS
        RETURN reading_lists

    FUNCTION save_reading_lists()
        OPEN file with self.filename as file
            FOR each username, books in self.reading_lists.items()
                WRITE username + '|' + JOIN books by ',' + newline
```
