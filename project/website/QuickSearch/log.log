    return redirect(url_for('login'))

@app.route('/book/<title>', methods=['GET', 'POST'])
def book_details(title):
    """Render the details of a specific book."""
    if 'username' not in session:
        return redirect(url_for('login'))

    details = book_manager.get_book_details(title)
