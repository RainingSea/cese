*** main.py
```python
from flask import Flask, render_template, request, redirect, url_for, session
from user_manager import UserManager
from book_manager import BookManager
from reading_list_manager import ReadingListManager

app = Flask(__name__)
app.secret_key = 'your_secret_key'

user_manager = UserManager()
book_manager = BookManager()
reading_list_manager = ReadingListManager()

@app.route('/')
def login():
    return render_template('login.html')

@app.route('/register', methods=['GET', 'POST'])
def register():
    if request.method == 'POST':
        username = request.form['username']
        password = request.form['password']
        if user_manager.register(username, password):
            return redirect(url_for('login'))
        else:
            return "Registration Failed. Username may already exist."
    return render_template('registration.html')

@app.route('/dashboard', methods=['GET', 'POST'])
def dashboard():
    if 'username' not in session:
        return redirect(url_for('login'))
    if request.method == 'POST':
        query = request.form['search_query']
        search_results = book_manager.search_books(query)
        return render_template('dashboard.html', books=search_results)
    return render_template('dashboard.html')

@app.route('/book/<book_id>')
def book_details(book_id):
    book_details = book_manager.get_book_details(book_id)
    return render_template('book_details.html', book=book_details)

@app.route('/reading_list')
def reading_list():
    if 'username' not in session:
        return redirect(url_for('login'))
    user_reading_list = reading_list_manager.load_reading_list(session['username'])
    return render_template('reading_list.html', reading_list=user_reading_list)

@app.route('/logout')
def logout():
    session.pop('username', None)
    return redirect(url_for('login'))

if __name__ == '__main__':
    app.run(debug=True)
```

*** user_manager.py
```python
import bcrypt

class UserManager:
    def __init__(self):
        self.users = self.load_users('users.txt')

    def load_users(self, file_path):
        users = {}
        with open(file_path, 'r') as file:
            for line in file:
                username, password = line.strip().split('|')
                users[username] = password
        return users

    def register(self, username: str, password: str) -> bool:
        if username not in self.users:
            self.users[username] = password
            with open('users.txt', 'a') as file:
                file.write(f"{username}|{password}\n")
            return True
        return False

    def login(self, username: str, password: str) -> bool:
        return self.users.get(username) == password
```

*** book_manager.py
```python
class BookManager:
    def __init__(self):
        self.books = self.load_books('books.txt')

    def load_books(self, file_path):
        books = {}
        with open(file_path, 'r') as file:
            for line in file:
                book_id, title, author, description = line.strip().split('|')
                books[book_id] = {
                    'title': title,
                    'author': author,
                    'description': description
                }
        return books

    def search_books(self, query: str) -> list:
        return [book for book in self.books.values() if query.lower() in book['title'].lower()]

    def get_book_details(self, book_id: str) -> dict:
        return self.books.get(book_id, {})
```

*** reading_list_manager.py
```python
class ReadingListManager:
    def __init__(self):
        self.reading_lists = self.load_reading_lists('reading_list.txt')

    def load_reading_lists(self, file_path):
        reading_lists = {}
        with open(file_path, 'r') as file:
            for line in file:
                username, book_id = line.strip().split('|')
                if username not in reading_lists:
                    reading_lists[username] = []
                reading_lists[username].append(book_id)
        return reading_lists

    def add_to_reading_list(self, username: str, book_id: str) -> bool:
        if username in self.reading_lists:
            self.reading_lists[username].append(book_id)
        else:
            self.reading_lists[username] = [book_id]
        with open('reading_list.txt', 'a') as file:
            file.write(f"{username}|{book_id}\n")
        return True

    def load_reading_list(self, username: str) -> list:
        return self.reading_lists.get(username, [])

    def remove_from_reading_list(self, username: str, book_id: str) -> bool:
        if username in self.reading_lists and book_id in self.reading_lists[username]:
            self.reading_lists[username].remove(book_id)
            self.save_reading_lists()
            return True
        return False

    def save_reading_lists(self):
        with open('reading_list.txt', 'w') as file:
            for username, books in self.reading_lists.items():
                for book_id in books:
                    file.write(f"{username}|{book_id}\n")
