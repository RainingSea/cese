    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
</head>
<body>
    <h1>Welcome, {{ username }}</h1>
    <form method="POST" action="/search_freelancer">
        <input type="text" name="name" placeholder="Search Freelancer" required>
        <button type="submit">Search</button>
    </form>
    <h2>Freelancers</h2>
    <ul>
        {% if freelancers %}
            {% for freelancer in freelancers %}
                <li>{{ freelancer.name }} - Skills: {{ freelancer.skills | join(', ') }}</li>
            {% endfor %}
        {% else %}
            <li>No freelancers found.</li>
        {% endif %}
    </ul>
    <h2>Create Project</h2>
    <form method="POST" action="/create_project">
        <input type="text" name="name" placeholder="Project Name" required>
        <textarea name="description" placeholder="Project Description" required></textarea>
        <input type="text" name="freelancer" placeholder="Freelancer Name" required>
        <button type="submit">Create Project</button>
    </form>
</body>
</html>
