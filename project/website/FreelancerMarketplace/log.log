        with open('freelancers.txt', 'w') as file:
            for freelancer in self.freelancers:
                file.write(f"{freelancer['name']}|{','.join(freelancer['skills'])}\n")

    def get_freelancer_details(self, name: str) -> dict:
        for freelancer in self.freelancers:
            if freelancer['name'] == name:
                return freelancer
        return {}

