            file.write(f"{self.name}|{self.details}\n")

    @staticmethod
    def load_freelancers() -> list:
        freelancers = []
        with open('freelancers.txt', 'r') as file:
            for line in file:
                name, details = line.strip().split('|')
                freelancers.append(Freelancer(name, details))
        return freelancers
