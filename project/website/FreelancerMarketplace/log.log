```
// Define the User class and its methods
CLASS User:
    FUNCTION __init__(username: str, password: str):
        SET self.username = username
        SET self.password = password

    FUNCTION save():
        OPEN 'users.txt' IN append mode AS file:
            WRITE self.username + "|" + self.password + "\n"

// Define the load_users function
FUNCTION load_users():
    CREATE users LIST
    OPEN 'users.txt' IN read mode AS file:
        FOR EACH line IN file:
            SPLIT line BY '|'
            CREATE User instance with username and password
            APPEND User instance to users LIST
    RETURN users

// Define the Flask application behavior for login
FUNCTION login():
    IF request.method IS 'POST':
        SET username = request.form['username']
        SET password = request.form['password']
        SET users = load_users()
        FOR EACH user IN users:
            IF user.username EQUALS username AND user.password EQUALS password:
                SET session['username'] = username
                REDIRECT to 'home'
    RETURN render_template('login.html')
```

