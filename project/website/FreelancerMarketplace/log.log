```pseudocode
function navigate_to_registration():
    @app.route('/register', methods=['GET', 'POST'])  // Define a route for registration
    if request.method == 'POST':  // Check for POST request
        username = request.form['username']  // Get username from form
        password = request.form['password']  // Get password from form
        new_user = User(username, password)  // Create a new User instance
        new_user.save()  // Save new user to file
        return redirect(url_for('login'))  // Redirect to login page
    return render_template('register.html')  // Render the registration template for GET request
```

