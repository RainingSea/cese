            data_storage.save_user(new_user)
            return redirect(url_for('login'))
        
        flash('Please fill in all fields.')
    
    return render_template('register.html')

@app.route('/dashboard')
def dashboard():
    charities = data_storage.load_charities()
    donations = data_storage.load_donations()
    user_contributions = {donation.charity_name: donation.amount for donation in donations}
    return render_template('dashboard.html', charities=charities, contributions=user_contributions)

@app.route('/charity/<charity_name>', methods=['GET', 'POST'])
def charity_details(charity_name):
    charity = next((c for c in data_storage.load_charities() if c.name == charity_name), None)
    
    if request.method == 'POST':
        donation_amount = float(request.form['donation_amount'])
        username = request.form['username']  # Assuming username is passed from the session or form
        donation = Donation(username, charity_name, donation_amount)
        data_storage.save_donation(donation)
        flash('Thank you for your donation!')
        return redirect(url_for('dashboard'))
    
    return render_template('charity_details.html', charity=charity)

if __name__ == '__main__':
    app.run(debug=True)
