    if request.method == 'POST':
        tip = request.form['tip']
        tip_manager.submit_tip(tip)
    tips = tip_manager.get_tips()
    return render_template('tips.html', tips=tips)

@app.route('/resources', methods=['GET', 'POST'])
def resources():
    if request.method == 'POST':
        title = request.form['title']
