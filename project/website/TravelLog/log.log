```
FUNCTION view_entries()
    CALL JournalEntry.load_entries()  # Load all entries from storage

    RETURN entries  # Return the list of journal entries to be displayed in the dashboard
END FUNCTION

FUNCTION load_entries()
    IF "entries.txt" does NOT exist THEN
        RETURN {}  # Return empty if no entries exist
    ENDIF

    OPEN "entries.txt" for reading AS file
        SET entries = {}
        FOR EACH line IN file
            SPLIT line INTO entry_id and data
            entries[entry_id] = PARSE JSON(data)  # Convert string data to JSON
        ENDFOR
    CLOSE file

    RETURN entries  # Return the parsed entries
END FUNCTION

