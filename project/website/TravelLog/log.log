<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <title>Journal Entries</title>
</head>
<body>
    <div class="container">
        <h2>Journal Entries</h2>
        <form method="POST" action="/journal">
            <div class="form-group">
                <label for="destination">Destination:</label>
                <input type="text" class="form-control" id="destination" name="destination" required>
            </div>
            <div class="form-group">
                <label for="dates">Dates:</label>
                <input type="text" class="form-control" id="dates" name="dates" required>
            </div>
            <div class="form-group">
                <label for="activities">Activities:</label>
                <input type="text" class="form-control" id="activities" name="activities" required>
            </div>
            <div class="form-group">
                <label for="photos">Photos (comma-separated):</label>
                <input type="text" class="form-control" id="photos" name="photos">
            </div>
            <div class="form-group">
                <label for="reflections">Reflections:</label>
                <textarea class="form-control" id="reflections" name="reflections" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Save Entry</button>
            <a href="/logout" class="btn btn-link">Logout</a>
        </form>
        <h3>Your Entries:</h3>
        <ul>
            {% for entry in entries %}
                <li>
                    {{ entry.destination }} - {{ entry.dates }} - {{ entry.activities }}
                    <form method="POST" action="/delete_entry/{{ loop.index0 }}">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                    <a href="/edit_entry/{{ loop.index0 }}" class="btn btn-warning btn-sm">Edit</a>
                    <form method="POST" action="/share_entry/{{ loop.index0 }}" style="display:inline;">
                        <button type="submit" class="btn btn-info btn-sm">Share</button>
                    </form>
                </li>
            {% endfor %}
        </ul>
        <h3>Search Entries:</h3>
        <form method="POST" action="/search">
            <input type="text" name="query" placeholder="Search..." required>
            <button type="submit" class="btn btn-info">Search</button>
        </form>
        {% if search_results %}
            <h4>Search Results:</h4>
            <ul>
                {% for result in search_results %}
                    <li>{{ result.destination }} - {{ result.dates }} - {{ result.activities }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</body>
</html>
