    ```python
    def delete_book(self, isbn):
        try:
            with open(self.books_file, 'r') as f:
                books = [line.strip().split(',') for line in f if line.strip().split(',')[2] != isbn]
            with open(self.books_file, 'w') as f:
                f.writelines(','.join(book) + '\n' for book in books)
            return True
        except:
