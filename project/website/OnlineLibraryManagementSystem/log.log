## Experience and Lessons
|Case|:**manage_books**
```pseudocode
FUNCTION book_management()
    IF REQUEST_METHOD IS POST THEN
        title = GET_TITLE_FROM_FORM()
        author = GET_AUTHOR_FROM_FORM()
        CALL book_manager.add_book(title, author)

    books = CALL book_manager.view_books()
    RENDER book_management.html WITH books
END FUNCTION

CLASS BookManager
    FUNCTION add_book(title: str, author: str) -> None
        APPEND title + "|" + author TO self.books
        CALL self.save_books()
    END FUNCTION

    FUNCTION view_books() -> list
        RETURN self.books
    END FUNCTION

    FUNCTION save_books() -> None
        OPEN 'books.txt' IN WRITE MODE
            WRITE '\n'.join(self.books) TO FILE
        CLOSE FILE
    END FUNCTION
END CLASS
```|Case|:**user_login**
```pseudocode
FUNCTION login()
    IF REQUEST_METHOD IS POST THEN
        username = GET_USERNAME_FROM_FORM()
        password = GET_PASSWORD_FROM_FORM()
        IF user_manager.login(username, password) THEN
            REDIRECT TO '/dashboard'
        ELSE
            RETURN "Invalid credentials", 401
        ENDIF
    ENDIF
    RENDER login.html
END FUNCTION

CLASS UserManager
    FUNCTION login(username: str, password: str) -> bool
        FOR user IN self.users DO
            stored_username, stored_password = SPLIT user BY '|'
            IF stored_username EQUALS username AND stored_password EQUALS password THEN
                RETURN True
            ENDIF
        ENDFOR
        RETURN False
    END FUNCTION
END CLASS
```

