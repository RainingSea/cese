```python
import os
from user_manager import UserManager
from book_manager import BookManager
from flask import Flask, render_template, request, redirect, url_for, session

app = Flask(__name__)
app.secret_key = 'your_secret_key'

user_manager = UserManager('users.txt')
book_manager = BookManager('books.txt')

@app.route('/')
def login():
    return render_template('login.html')

@app.route('/dashboard')
def dashboard():
    if 'username' in session:
        return render_template('dashboard.html', username=session['username'])
    return redirect(url_for('login'))

@app.route('/login', methods=['POST'])
def do_login():
    username = request.form['username']
    password = request.form['password']
    if user_manager.login(username, password):
        session['username'] = username
        return redirect(url_for('dashboard'))
    return "Login Failed"

@app.route('/logout')
def logout():
    session.pop('username', None)
    return redirect(url_for('login'))

@app.route('/add_book', methods=['POST'])
def add_book():
    title = request.form['title']
    author = request.form['author']
    book_manager.add_book(title, author)
    return redirect(url_for('dashboard'))

@app.route('/delete_book', methods=['POST'])
def delete_book():
    title = request.form['title']
    book_manager.delete_book(title)
    return redirect(url_for('dashboard'))

@app.route('/list_books')
def list_books():
    books = book_manager.list_books()
    return render_template('book_management.html', books=books)

if __name__ == '__main__':
    app.run(debug=True)
```

*** user_manager.py
```python
class UserManager:
    def __init__(self, file_path: str):
        self.file_path = file_path
        self.load_users()

    def load_users(self):
        self.users = {}
        if os.path.exists(self.file_path):
            with open(self.file_path, 'r') as file:
                for line in file:
                    username, password = line.strip().split('|')
                    self.users[username] = password

    def register(self, username: str, password: str) -> bool:
        if username in self.users:
            return False
        self.users[username] = password
        with open(self.file_path, 'a') as file:
            file.write(f"{username}|{password}\n")
        return True

    def login(self, username: str, password: str) -> bool:
        return self.users.get(username) == password

    def list_users(self) -> list:
        return list(self.users.keys())
```

*** book_manager.py
```python
class BookManager:
    def __init__(self, file_path: str):
        self.file_path = file_path
        self.load_books()

    def load_books(self):
        self.books = []
        if os.path.exists(self.file_path):
            with open(self.file_path, 'r') as file:
                for line in file:
                    title, author = line.strip().split('|')
                    self.books.append({'title': title, 'author': author})

    def add_book(self, title: str, author: str) -> bool:
        self.books.append({'title': title, 'author': author})
        with open(self.file_path, 'a') as file:
            file.write(f"{title}|{author}\n")
        return True

    def delete_book(self, title: str) -> bool:
        self.books = [book for book in self.books if book['title'] != title]
        self.save_books()
        return True

    def list_books(self) -> list:
        return self.books

    def save_books(self):
        with open(self.file_path, 'w') as file:
            for book in self.books:
                file.write(f"{book['title']}|{book['author']}\n")

    def search_book(self, query: str) -> list:
        return [book for book in self.books if query.lower() in book['title'].lower()]
```

