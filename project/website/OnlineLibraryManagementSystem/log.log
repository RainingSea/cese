```python
import os

class UserManager:
    def __init__(self, file_path: str):
        self.file_path = file_path
        self.load_users()

    def load_users(self):
        self.users = {}
        if os.path.exists(self.file_path):
            with open(self.file_path, 'r') as file:
                for line in file:
                    username, password = line.strip().split('|')
                    self.users[username] = password

    def register(self, username: str, password: str) -> bool:
        if username in self.users:
            return False
        self.users[username] = password
        with open(self.file_path, 'a') as file:
            file.write(f"{username}|{password}\n")
        return True

    def login(self, username: str, password: str) -> bool:
        return self.users.get(username) == password

    def logout(self):
        session.pop('username', None)

    def list_users(self) -> list:
        return list(self.users.keys())
```

*** book_manager.py
```python
import os

class BookManager:
    def __init__(self, file_path: str):
        self.file_path = file_path
        self.load_books()

    def load_books(self):
        self.books = []
        if os.path.exists(self.file_path):
            with open(self.file_path, 'r') as file:
                for line in file:
                    title, author = line.strip().split('|')
                    self.books.append({'title': title, 'author': author})

    def add_book(self, title: str, author: str) -> bool:
        self.books.append({'title': title, 'author': author})
        with open(self.file_path, 'a') as file:
            file.write(f"{title}|{author}\n")
        return True

    def delete_book(self, title: str) -> bool:
        self.books = [book for book in self.books if book['title'] != title]
        self.save_books()
        return True

    def list_books(self) -> list:
        return self.books

    def save_books(self):
        with open(self.file_path, 'w') as file:
            for book in self.books:
                file.write(f"{book['title']}|{book['author']}\n")

    def search_book(self, query: str) -> list:
        return [book for book in self.books if query.lower() in book['title'].lower()]
```

