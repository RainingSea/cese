2. |Case|:**registration**
```pseudocode
FUNCTION register()
    IF request.method IS 'POST'
        username = request.form['username']
        password = request.form['password']
        IF user_manager.register(username, password) IS True
            REDIRECT TO '/'
        ELSE
            RETURN "Registration failed. Username may already exist."
    ENDIF
    RENDER registration.html
END FUNCTION

CLASS UserManager
    FUNCTION register(username: str, password: str) -> bool
        IF username IN self.users
            RETURN False
        self.users[username] = password
        CALL self.save_users()
        RETURN True

    FUNCTION save_users() -> None
        OPEN 'users.txt' FOR writing
        FOR EACH username, password IN self.users
            WRITE username + ',' + password + '\n'
        END FOR
    END FUNCTION
END CLASS

