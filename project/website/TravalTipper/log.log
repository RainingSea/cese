                <a class="nav-link" href="{{ url_for('logout') }}">Logout</a>
            </div>
        </div>
    </nav>

    <h1>Get Travel Tips</h1>
    
    <form method="POST" class="mb-5">
        <div class="mb-3">
            <label class="form-label">Destination</label>
            <input type="text" class="form-control" name="destination" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Interests (select at least one)</label>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="interests" value="Food" id="food">
                <label class="form-check-label" for="food">Food</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="interests" value="Sightseeing" id="sightseeing">
                <label class="form-check-label" for="sightseeing">Sightseeing</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="interests" value="Culture" id="culture">
                <label class="form-check-label" for="culture">Culture</label>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Get Tips</button>
    </form>

    {% if tips %}
    <h2>Recommended Tips</h2>
    <div class="list-group">
        {% for tip in tips %}
        <div class="list-group-item">
            <h5>{{ tip.destination }} - {{ tip.category }}</h5>
            <p>{{ tip.content }}</p>
            <form method="POST" action="{{ url_for('save_favorite') }}">
                <input type="hidden" name="tip_id" value="{{ tip.id }}">
                <button type="submit" class="btn btn-sm btn-outline-primary">Save as Favorite</button>
            </form>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</body>
</html>

