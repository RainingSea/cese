        <select name="destination" required>
            <option value="Paris">Paris</option>
            <option value="Tokyo">Tokyo</option>
            <option value="New York">New York</option>
            <option value="London">London</option>
        </select><br>
        
        <label>Interests:</label><br>
        <input type="checkbox" name="interests" value="Food"> Food<br>
        <input type="checkbox" name="interests" value="Sightseeing"> Sightseeing<br>
        <input type="checkbox" name="interests" value="Shopping"> Shopping<br>
        
        <button type="submit">Get Tips</button>
    </form>
    
    <h2>Search Tips</h2>
    <form action="{{ url_for('search') }}" method="GET">
        <input type="text" name="query" placeholder="Search tips...">
        <button type="submit">Search</button>
    </form>
    
    {% if favorites %}
