                    <input type="hidden" name="destination" value="{{ tip.destination }}">
                    <input type="hidden" name="content" value="{{ tip.content }}">
                    <button type="submit">Save to Favorites</button>
                </form>
            </div>
            {% endfor %}
        </div>
        {% else %}
