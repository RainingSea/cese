FUNCTION Main()
    INITIALIZE UserManager
    INITIALIZE TravelTipGenerator
    INITIALIZE FavoritesManager
    CALL load_user_data() FROM UserManager
    CALL load_tips() FROM TravelTipGenerator
    CALL load_favorites() FROM FavoritesManager
