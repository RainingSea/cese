#### Pseudocode:
```plaintext
FUNCTION get_recommendations(destination: string, interests: list) -> list
    DECLARE recommendations as list

    IF destination exists in tips
        FOR each interest in interests
            FOR each tip in tips[destination]
                IF tip[0] matches interest
                    APPEND tip[1] to recommendations
                ENDIF
            ENDFOR
        ENDFOR
    ENDIF

    RETURN recommendations
END FUNCTION

FUNCTION travel_details() 
    IF request.method is 'POST'
        SET destination FROM request.form['destination']
        SET duration FROM request.form['duration']
        SET interests FROM request.getlist('interests')

        CALL recommendations = get_recommendations(destination, interests)
        
        RENDER recommendations.html with recommendations
    ENDIF

    RENDER travel_details.html
END FUNCTION
```

