# travel_tipper.py
FUNCTION get_tips(destination, interests)
    OPEN tips.txt
    FOR EACH LINE IN FILE:
        SPLIT INTO tip_dest, category, content
        IF tip_dest MATCHES destination AND category IN interests:
            ADD TO tips LIST WITH HASHED ID
    RETURN tips
END
```

```python
CLASS TipService:
    METHOD get_tips(destination, interests):
        READ tips_database.txt LINE BY LINE
        SPLIT line INTO tip_dest, category, tip_text
        IF tip_dest.lower() == destination.lower() AND category IN interests:
            ADD {'id': f"{tip_dest}_{category}", 'text': tip_text} TO results
        RETURN results
```
Key Functionality:
- Case-insensitive destination matching
- Multiple interest selection supported

