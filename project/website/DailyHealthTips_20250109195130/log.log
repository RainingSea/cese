    <form method="POST">
        <input type="text" name="search" placeholder="Search tips..." required>
        <button type="submit">Search</button>
    </form>
    <ul>
        {% for tip in tips %}
            <li>{{ tip.content }} ({{ tip.date }})</li>
        {% endfor %}
    </ul>
    <a href="/feedback">Give Feedback</a>
    <a href="/archive">View Archive</a>
</body>
</html>
