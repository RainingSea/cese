<!DOCTYPE html>
<html>
<head>
    <title>Compare Options - Trip Saver</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5">
    <h1 class="mb-4">Comparison</h1>
    
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3>{{ option1.mode }}</h3>
                </div>
                <div class="card-body">
                    <p><strong>Cost:</strong> ${{ option1.cost }}</p>
                    <p><strong>Time:</strong> {{ option1.time }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3>{{ option2.mode }}</h3>
                </div>
                <div class="card-body">
                    <p><strong>Cost:</strong> ${{ option2.cost }}</p>
                    <p><strong>Time:</strong> {{ option2.time }}</p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="mt-4">
        <h3>Summary</h3>
        <table class="table">
            <thead>
                <tr>
                    <th>Criteria</th>
                    <th>{{ option1.mode }}</th>
                    <th>{{ option2.mode }}</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Cost Difference</td>
                    <td colspan="2">
                        {% if option1.cost > option2.cost %}
                            {{ option1.mode }} is ${{ option1.cost - option2.cost }} more expensive
                        {% elif option1.cost < option2.cost %}
                            {{ option2.mode }} is ${{ option2.cost - option1.cost }} more expensive
                        {% else %}
                            Both options cost the same
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td>Time Difference</td>
                    <td colspan="2">
                        {% if option1.time > option2.time %}
                            {{ option1.mode }} takes longer
                        {% elif option1.time < option2.time %}
                            {{ option2.mode }} takes longer
                        {% else %}
                            Both options take the same time
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    
    <a href="{{ url_for('trip_input') }}" class="btn btn-secondary mt-3">Back to Trip Planning</a>
</body>
</html>
