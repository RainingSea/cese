            {"option": "Car", "cost": 15, "time": "1h 15m"}
        ]

    def compare_options(self, options: list) -> str:
        comparison = ""
        for option in options:
            comparison += f"{option['option']} - Cost: ${option['cost']}, Time: {option['time']}\n"
        return comparison

