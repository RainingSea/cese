    def get_suggestions(self, start: str, destination: str, date: str):
        return [{"mode": "Bus", "cost": 10, "time": "1 hour"}, {"mode": "Train", "cost": 20, "time": "30 minutes"}]

    def save_preference(self, user: str, trip: str):
