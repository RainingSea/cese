```python
FUNCTION login():
    IF request.method == 'POST':
        SET username = request.form['username']
        SET password = request.form['password']
        
        IF user_manager.login(username, password):
            REDIRECT to '/trip_details'
        ELSE:
            FLASH message 'Invalid username or password'
    RETURN RENDER login.html

FUNCTION trip_details():
    IF request.method == 'POST':
        SET start = request.form['start']
        SET destination = request.form['destination']
        SET date = request.form['date']
        
        CALL trip_manager.add_trip(start, destination, date)
        SET options = trip_manager.get_transport_options(start, destination, date)
        RETURN RENDER results.html with options
    RETURN RENDER trip_details.html
```

