        <a href="{{ url_for('trip_input') }}">Home</a> |
        <a href="{{ url_for('saved_trips') }}">Saved Trips</a> |
        <a href="{{ url_for('logout') }}">Logout</a>
    </nav>
    
    <h1>Your Saved Trips</h1>
    {% if trips %}
    <table>
        <thead>
            <tr>
                <th>Start</th>
                <th>Destination</th>
                <th>Date</th>
                <th>Preferred Option</th>
            </tr>
        </thead>
        <tbody>
            {% for trip in trips %}
            <tr>
                <td>{{ trip.start }}</td>
                <td>{{ trip.destination }}</td>
                <td>{{ trip.date }}</td>
                <td>{{ trip.option.replace('_', ' ').title() }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p>You haven't saved any trips yet.</p>
    {% endif %}
</body>
</html>
