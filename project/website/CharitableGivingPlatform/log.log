</head>
<body class="container mt-5">
    <div class="d-flex justify-content-between mb-4">
        <h2>Welcome, {{ username }}</h2>
        <a href="{{ url_for('logout') }}" class="btn btn-outline-danger">Logout</a>
    </div>

    <div class="card mb-5">
        <div class="card-header">
            <h3>Charities</h3>
        </div>
        <div class="card-body">
            <div class="list-group">
                {% for charity in charities %}
                <a href="{{ url_for('charity', charity_id=charity.id) }}" 
                   class="list-group-item list-group-item-action">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">{{ charity.name }}</h5>
                    </div>
                    <p class="mb-1">{{ charity.mission }}</p>
                </a>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3>Your Donations</h3>
        </div>
        <div class="card-body">
            {% if donations %}
            <table class="table">
                <thead>
                    <tr>
                        <th>Charity</th>
                        <th>Amount</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    {% for donation in donations %}
                    <tr>
                        <td>
                            {% for charity in charities %}
                                {% if charity.id == donation.charity_id %}
                                    {{ charity.name }}
                                {% endif %}
                            {% endfor %}
                        </td>
                        <td>${{ "%.2f"|format(donation.amount) }}</td>
                        <td>{{ donation.timestamp }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <p>No donations yet.</p>
            {% endif %}
        </div>
    </div>
