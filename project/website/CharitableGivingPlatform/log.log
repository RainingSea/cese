   **Pseudocode**:
   ```
   FUNCTION register()
       IF request method is POST THEN
           username = get username from request
           password = get password from request
           new_user = create new User with username and password
           new_user.save()  // Save user info
           redirect to login page
       END IF
       render registration page
   END FUNCTION
   ```

2. **test_user_registration**
   - **Project Code Related to the Test Case**:
   ```python
   class User:
       def __init__(self, username: str, password: str):
           self.username = username
           self.password = password

       def save(self):
           with open('users.txt', 'a') as file:
               file.write(f"{self.username}|{self.password}\n")
   
       @staticmethod
       def load_users() -> list:
           users = []
           try:
               with open('users.txt', 'r') as file:
                   for line in file:
                       username, password = line.strip().split('|')
                       users.append(User(username, password))
           except FileNotFoundError:
               pass
           return users
   ```

   **Pseudocode**:
   ```
   CLASS User
       FUNCTION __init__(username, password)
           SET self.username = username
           SET self.password = password
       END FUNCTION

       FUNCTION save()
           OPEN users.txt in append mode
           WRITE username and password to users.txt
           CLOSE file
       END FUNCTION

       STATIC FUNCTION load_users() RETURNS list
           users = empty list
           TRY
               OPEN users.txt in read mode
               FOR each line in file DO
                   username, password = split line by '|'
                   APPEND new User(username, password) to users
               END FOR
           EXCEPT FileNotFoundError
               RETURN empty list
           RETURN users
       END FUNCTION
   END CLASS
   ```

