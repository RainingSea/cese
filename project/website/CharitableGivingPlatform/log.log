*** templates/dashboard.html
```html
<!DOCTYPE html>
<html>
<head>
    <title>Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5">
    <div class="d-flex justify-content-between mb-4">
        <h2>Welcome, {{ username }}</h2>
        <a href="{{ url_for('logout') }}" class="btn btn-outline-danger">Logout</a>
    </div>

    <div class="card mb-5">
        <div class="card-header">
            <h3>Charities</h3>
        </div>
        <div class="card-body">
            <div class="list-group">
                {% for charity in charities %}
                <a href="{{ url_for('charity', charity_id=charity.id) }}" 
                   class="list-group-item list-group-item-action">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">{{ charity.name }}</h5>
                    </div>
                    <p class="mb-1">{{ charity.mission }}</p>
                </a>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3>Your Donations</h3>
        </div>
        <div class="card-body">
            {% if donations %}
            <table class="table">
                <thead>
                    <tr>
                        <th>Charity</th>
                        <th>Amount</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    {% for donation in donations %}
                    <tr>
                        <td>
                            {% for charity in charities %}
                                {% if charity.id == donation.charity_id %}
                                    {{ charity.name }}
                                {% endif %}
                            {% endfor %}
                        </td>
                        <td>${{ "%.2f"|format(donation.amount) }}</td>
                        <td>{{ donation.timestamp }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <p>No donations yet.</p>
            {% endif %}
        </div>
    </div>
</body>
</html>
```

*** templates/charity.html
```html
<!DOCTYPE html>
<html>
<head>
    <title>{{ charity.name }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5">
    <div class="mb-4">
        <a href="{{ url_for('dashboard') }}" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h2>{{ charity.name }}</h2>
        </div>
        <div class="card-body">
            <h5 class="card-title">Mission</h5>
            <p class="card-text">{{ charity.mission }}</p>
            
            <h5 class="card-title mt-4">Projects</h5>
            <ul class="list-group list-group-flush">
                {% for project in charity.projects %}
                <li class="list-group-item">{{ project }}</li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3>Make a Donation</h3>
        </div>
        <div class="card-body">
            {% if error %}
                <div class="alert alert-danger">{{ error }}</div>
            {% endif %}
            <form method="POST">
                <div class="mb-3">
                    <label for="amount" class="form-label">Amount ($)</label>
                    <input type="number" step="0.01" min="0.01" class="form-control" id="amount" name="amount" required>
                </div>
                <button type="submit" class="btn btn-primary">Donate</button>
            </form>
        </div>
    </div>
</body>
</html>
