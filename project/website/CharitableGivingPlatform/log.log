                    donor, charity_id, amount, timestamp = line.strip().split('|')
                    if donor == username:
                        donations.append({
                            'charity_id': charity_id,
                            'amount': float(amount),
                            'timestamp': timestamp
                        })
        except Exception:
            pass
        return donations
