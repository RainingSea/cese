<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ charity.name }} Details</title>
</head>
<body>
    <h2>{{ charity.name }}</h2>
    <p><strong>Mission:</strong> {{ charity.mission }}</p>
    <h3>Projects:</h3>
    <ul>
        {% for project in charity.projects %}
            <li>{{ project }}</li>
        {% endfor %}
    </ul>
    <h3>Make a Donation</h3>
    <form method="POST" action="{{ url_for('charity_details', charity_name=charity.name) }}">
        <input type="hidden" name="username" value="{{ request.form['username'] }}">
        <label for="amount">Donation Amount:</label>
        <input type="number" id="amount" name="amount" required>
        <button type="submit">Donate</button>
    </form>
    <a href="/dashboard">Back to Dashboard</a>
</body>
</html>
```

