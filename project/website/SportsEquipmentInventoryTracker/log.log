ty,\n                \'condition\': condition,\n                \'location\': location,\n                \'last_maintenance_date\': last_maintenance\n            })\n        RETURN equipment\n\nROUTE /dashboard:\n    IF \'username\' NOT IN session:\n        REDIRECT TO /login\n    equipment = EquipmentTracker.get_equipment()\n    alerts = AlertSystem.check_alerts(session[\'username\'])\n    RENDER dashboard.html WITH equipment AND alerts\n```\n```\nMETHOD get_all():\n    RETURN search(\'\')  # Returns all equipment\n```\n\n3. ', '|Case|:search_equipment\n```\nCLASS EquipmentTracker:\n    FUNCTION search_equipment(query):\n        equipment = self.get_equipment()\n        RETURN [eq FOR eq IN equipment IF query.lower() IN eq[\'name\'].lower()]\n\nROUTE /search_equipment:\n    IF \'username\' NOT IN session:\n        REDIRECT TO /login\n    query = FORM[\'query\']\n    results = EquipmentTracker.search_equipment(query)\n    RENDER dashboard.html WITH results\n```\n```\nMETHOD search(query, filter_type=None):\n    INIT results = []\n    READ equipment.txt:\n        FOR EACH line:\n            IF query.lower() IN line.lower() AND (filter_type is None OR line matches filter_type):\n                PARSE line INTO structured data\n                APPEND TO results\n    RETURN results\n```\n\n4. |Case|:user_registration\n```\nFUNCTION register(username, password)  \n    READ users.txt  \n    IF username EXISTS in users  \n        RETURN False (username exists)  \n    ELSE  \n        HASH password (using werkzeug.security.generate_password_hash)  \n        APPEND username:hashed_password to users.txt  \n        RETURN True  \n    ENDIF  \nENDFUNCTION  \n\n---  \n<form method="POST" action="/register">  \n    <input type="text" name="username" required>  \n    <input type="password" name="password" required>  \n    <button type="submit">Register</button>  \n</form>  \n```\n\n5. ', '|Case|:equipment_management\n```\nFUNCTION add_equipment(name, type, quantity, condition, availability, location, alert_date)  \n    GENERATE new_id = len(equipment) + 1  \n    FORMAT data as "id|name|type|quantity|condition|availability|location|alert_date"  \n    APPEND to equipment.txt  \n    RETURN True  \nENDFUNCTION  \n\nFUNCTION update_equipment(id, updated_data)  \n    READ equipment.txt  \n    FIND equipment with matching id  \n    UPDATE fields with new data  \n    REWRITE entire equipment.txt  \n    RETURN True  \nENDFUNCTION  \n\n---  \n<form method="POST" action="/add_equipment">  \n    <input type="text" name="name" required>  \n    <select name="condition">  \n        <option value="New">New</option>  \n        ...  \n    </select>  \n    <button type="submit">Add Equipment</button>  \n</form>  \n```\n\n6. |Case|:user_logout\n```\nFUNCTION logout()  \n    REMOVE session[\'username\']  \n    REDIRECT to login  \nENDFUNCTION  \n\n---  \n<a href="/logout">Logout</a>  \n```\n```\n# auth.py\nMETHOD logout():\n    REMOVE \'username\' FROM session\n    RETURN True\n```\n\n7. ', "|Case|:data_persistence\n```\nFUNCTION read_equipment()  \n    READ equipment.txt  \n    PARSE each line into structured data  \n    RETURN list of equipment  \nENDFUNCTION  \n\nFUNCTION write_equipment(data)  \n    APPEND formatted data to equipment.txt  \nENDFUNCTION  \n```\n```\nCLASS EquipmentManager:\n    INIT(equipment_file='equipment.txt'):\n        SET self.equipment_file = equipment_file\n\n    METHOD add_item(name, type, quantity, condition, location):\n        READ equipment.txt TO GET last_id\n        INCREMENT last_id TO new_id\n        APPEND new_id|name|type|quantity|condition|location|No alerts TO equipment.txt\n        RETURN True\n```\n\n8. |Case|:filter_equipment\n```\nMETHOD search(query, filter_type=None):\n    INIT results = []\n    READ equipment.txt:\n        FOR EACH line:\n            IF (filter_type is None OR line matches filter_type) AND query in line:\n                PARSE line INTO id|name|type|quantity|condition|location|alert\n               