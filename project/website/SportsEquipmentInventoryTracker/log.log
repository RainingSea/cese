<!DOCTYPE html>
<html>
<head>
    <title>Dashboard</title>
</head>
<body>
    <h1>Welcome, {{ session.username }}!</h1>
    <a href="/logout">Logout</a>
    <a href="/alerts">View Alerts</a>
    
    {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
            {% for category, message in messages %}
                <p style="color: {% if category == 'error' %}red{% else %}green{% endif %};">{{ message }}</p>
            {% endfor %}
        {% endif %}
    {% endwith %}
    
    <h2>Search Equipment</h2>
    <form method="POST" action="/search_equipment">
        <label>Search:</label>
        <input type="text" name="query" required>
        <label>Filter by Type:</label>
        <select name="filter_type">
            <option value="">All Types</option>
            <option value="Sports">Sports</option>
            <option value="Medical">Medical</option>
            <option value="Office">Office</option>
        </select>
        <button type="submit">Search</button>
    </form>
    
    <h2>Add Equipment</h2>
    <form method="POST" action="/add_equipment">
        <label>Name:</label>
        <input type="text" name="name" required><br>
        <label>Type:</label>
        <input type="text" name="type" required><br>
        <label>Quantity:</label>
        <input type="number" name="quantity" required><br>
        <label>Condition:</label>
        <select name="condition" required>
            <option value="New">New</option>
            <option value="Good">Good</option>
            <option value="Fair">Fair</option>
            <option value="Poor">Poor</option>
        </select><br>
        <label>Availability:</label>
        <select name="availability" required>
            <option value="Available">Available</option>
            <option value="In Use">In Use</option>
            <option value="Maintenance">Maintenance</option>
        </select><br>
        <label>Location:</label>
        <input type="text" name="location" required><br>
        <label>Alert Date (YYYY-MM-DD):</label>
        <input type="text" name="alert_date" required><br>
        <button type="submit">Add Equipment</button>
    </form>
    
    <h2>Equipment List</h2>
    <table border="1">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Type</th>
            <th>Quantity</th>
            <th>Condition</th>
            <th>Availability</th>
            <th>Location</th>
            <th>Alert Date</th>
            <th>Actions</th>
        </tr>
        {% for item in equipment %}
        <tr>
            <td>{{ item.id }}</td>
            <td>{{ item.name }}</td>
            <td>{{ item.type }}</td>
            <td>{{ item.quantity }}</td>
            <td>{{ item.condition }}</td>
            <td>{{ item.availability }}</td>
            <td>{{ item.location }}</td>
            <td>{{ item.alert_date }}</td>
            <td>
                <form method="POST" action="/update_equipment/{{ item.id }}" style="display: inline;">
                    <input type="text" name="name" value="{{ item.name }}" required>
                    <input type="text" name="type" value="{{ item.type }}" required>
                    <input type="number" name="quantity" value="{{ item.quantity }}" required>
                    <select name="condition" required>
                        <option value="New" {% if item.condition == 'New' %}selected{% endif %}>New</option>
                        <option value="Good" {% if item.condition == 'Good' %}selected{% endif %}>Good</option>
                        <option value="Fair" {% if item.condition == 'Fair' %}selected{% endif %}>Fair</option>
                        <option value="Poor" {% if item.condition == 'Poor' %}selected{% endif %}>Poor</option>
                    </select>
                    <select name="availability" required>
                        <option value="Available" {% if item.availability == 'Available' %}selected{% endif %}>Available</option>
                        <option value="In Use" {% if item.availability == 'In Use' %}selected{% endif %}>In Use</option>
                        <option value="Maintenance" {% if item.availability == 'Maintenance' %}selected{% endif %}>Maintenance</option>
                    </select>
                    <input type="text" name="location" value="{{ item.location }}" required>
                    <input type="text" name="alert_date" value="{{ item.alert_date }}" required>
                    <button type="submit">Update</button>
                </form>
            </td>
        </tr>
        {% endfor %}
    </table>
    
    <h2>Add Alert</h2>
    <form method="POST" action="/add_alert">
        <label>Equipment ID:</label>
        <select name="equipment_id" required>
            {% for item in equipment %}
                <option value="{{ item.id }}">{{ item.name }}</option>
            {% endfor %}
        </select><br>
        <label>Alert Type:</label>
        <input type="text" name="alert_type" required><br>
        <label>Threshold Date (YYYY-MM-DD):</label>
        <input type="text" name="threshold_date" required><br>
        <button type="submit">Add Alert</button>
    </form>
</body>
</html>
```

