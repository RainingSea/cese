```pseudocode
CLASS EquipmentManager
    INIT
        Call load_equipment()
    ENDINIT

    FUNCTION load_equipment()
        CREATE empty equipment list
        OPEN file 'equipment.txt'
        FOR each line in file
            SPLIT line by '|'
            APPEND equipment dictionary {name, quantity, condition, location} to equipment list
        END FOR
        RETURN equipment list
    ENDFUNCTION

    FUNCTION add_equipment(name, quantity, condition, location)
        APPEND {name, quantity, condition, location} to equipment list
        OPEN file 'equipment.txt' in append mode
            WRITE name, quantity, condition, location separated by '|'
        CLOSE file
        RETURN True
    ENDFUNCTION

    FUNCTION view_equipment()
        RETURN equipment list
    ENDFUNCTION
ENDCLASS
```

