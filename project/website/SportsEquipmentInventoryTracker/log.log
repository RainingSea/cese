        OPEN users_file IN append mode AS f
            WRITE username, password TO f
        SET users[username] TO password
        RETURN True

    METHOD load_users()
        DEFINE users AS empty dictionary
        TRY
            OPEN users_file IN read mode AS f
                FOR EACH line IN f
                    SPLIT line INTO username, password
                    SET users[username] TO password
        EXCEPT FileNotFoundError
            PASS
        RETURN users
