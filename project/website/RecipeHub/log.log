@app.route('/browse_recipes', methods=['GET', 'POST'])
def browse_recipes():
    if request.method == 'POST':
        keyword = request.form.get('keyword', '')
        recipes = recipe_manager.search_recipes(keyword)
    else:
        recipes = recipe_manager.search_recipes('')
