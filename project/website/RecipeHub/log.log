            <div class="recipe-ingredients">{{ recipe.ingredients }}</div>
            <a href="/recipe_details/{{ recipe.id }}" class="view-button">View Recipe</a>
        </li>
        {% endfor %}
    </ul>
    
    <a href="/" class="back-link">Back to Home</a>
</body>
</html>

