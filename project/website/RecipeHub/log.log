from flask import Flask, render_template, request, redirect, url_for, flash
from user_manager import UserManager
from recipe_manager import RecipeManager, Recipe

app = Flask(__name__)
app.secret_key = 'your_secret_key'  # Needed for session management

# Initialize UserManager and RecipeManager with respective file paths
user_manager = UserManager('users.txt')
recipe_manager = RecipeManager('recipes.txt')

@app.route('/')
def login():
    return render_template('login.html')

@app.route('/register', methods=['GET', 'POST'])
def register():
    if request.method == 'POST':
        username = request.form['username']
        password = request.form['password']
        if user_manager.register(username, password):
            flash('Registration successful! Please log in.')
            return redirect(url_for('login'))
        else:
            flash('Username already exists. Please choose another one.')

    return render_template('register.html')

@app.route('/home')
def home():
    return render_template('home.html')

@app.route('/login', methods=['POST'])
def do_login():
    username = request.form['username']
    password = request.form['password']
    if user_manager.login(username, password):
        return redirect(url_for('home'))
    else:
        flash('Invalid username or password.')
        return redirect(url_for('login'))

@app.route('/recipe_submission', methods=['GET', 'POST'])
def recipe_submission():
    if request.method == 'POST':
        title = request.form['title']
        ingredients = request.form['ingredients']
        instructions = request.form['instructions']
        recipe = Recipe(title, ingredients, instructions)
        if recipe_manager.submit_recipe(recipe):
            flash('Recipe submitted successfully!')
            return redirect(url_for('home'))
        else:
            flash('Error submitting the recipe. Please try again.')
    return render_template('recipe_submission.html')

@app.route('/recipe_browsing', methods=['GET', 'POST'])
def recipe_browsing():
    recipes = []
    if request.method == 'POST':
        keyword = request.form['keyword']
        recipes = recipe_manager.search_recipes(keyword)
    return render_template('recipe_browsing.html', recipes=recipes)

# Running the Flask app
if __name__ == '__main__':
    app.run(debug=False)

file name: user_manager.py

class User:
    def __init__(self, username: str, password: str):
        self.username = username
        self.password = password

    def save(self) -> None:
        with open('users.txt', 'a') as f:
            f.write(f"{self.username}|{self.password}\n")

class UserManager:
    def __init__(self, users_file: str):
        self.users_file = users_file

    def register(self, username: str, password: str) -> bool:
        # Check if the username already exists
        if self.login(username, password):
            return False  # Username already exists

        # Save the new user
        user = User(username, password)
        user.save()
        return True

    def login(self, username: str, password: str) -> bool:
        # Load users from file and check for validity
        with open(self.users_file, 'r') as f:
            for line in f:
                stored_username, stored_password = line.strip().split('|')
                if stored_username == username and stored_password == password:
                    return True
        return False

file name: recipe_manager.py

class Recipe:
    def __init__(self, title: str, ingredients: str, instructions: str):
        self.title = title
        self.ingredients = ingredients
        self.instructions = instructions

    def save(self) -> None:
        with open('recipes.txt', 'a') as f:
            f.write(f"{self.title}|{self.ingredients}|{self.instructions}\n")

class RecipeManager:
    def __init__(self, recipes_file: str):
        self.recipes_file = recipes_file

    def submit_recipe(self, recipe: Recipe) -> bool:
        recipe.save()
        return True

    def search_recipes(self, keyword: str) -> list:
        recipes_found = []
        with open(self.recipes_file, 'r') as f:
            for line in f:
                if keyword.lower() in line.lower():
                    recipes_found.append(line.strip().split('|'))
        return recipes_found

    def get_recipe_details(self, title: str) -> Recipe:
        with open(self.recipes_file, 'r') as f:
            for line in f:
                recipe_title, ingredients, instructions = line.strip().split('|')
                if recipe_title == title:
                    return Recipe(recipe_title, ingredients, instructions)
        return None

