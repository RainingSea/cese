                        </form>
                    </td>
                </tr>
            {% endfor %}
            <tr>
                <td colspan="3"><strong>Total</strong></td>
                <td colspan="2">${{ "%.2f"|format(total) }}</td>
            </tr>
        </table>
        <p><a href="{{ url_for('checkout') }}">Proceed to Checkout</a></p>
