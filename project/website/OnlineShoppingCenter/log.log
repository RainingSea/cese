    INITIALIZE products AS empty list
    TRY
        OPEN products_file IN read mode
            FOR EACH line IN products_file
                SPLIT line INTO product_id, name, price, description
                APPEND {id: product_id, name: name, price: price, description: description} TO products
            ENDFOR
        CLOSE products_file
    EXCEPT FileNotFoundError
        RETURN empty list
    END TRY
    RETURN products
END FUNCTION
```
