    <p><a href="{{ url_for('products') }}">Continue Shopping</a></p>
    {% if cart_items %}
        <table border="1">
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Subtotal</th>
                <th>Action</th>
            </tr>
            {% for item in cart_items %}
