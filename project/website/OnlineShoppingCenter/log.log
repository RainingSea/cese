CLASS UserManager  
    FUNCTION register_user(username, password, email)  
        IF username OR password OR email MISSING  
            RETURN False  
        
        READ users.txt  
        IF username ALREADY EXISTS  
            RETURN False  
        
        APPEND new user (username|password|email) to users.txt  
        RETURN True  
    END FUNCTION  
END CLASS  

