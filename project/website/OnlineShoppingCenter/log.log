```pseudocode
FUNCTION do_login()
    username = GET username from request
    password = GET password from request
    IF user_manager.login(username, password) IS TRUE
        session['username'] = username
        REDIRECT to product_listing
    ELSE
        REDIRECT to login
    ENDIF
