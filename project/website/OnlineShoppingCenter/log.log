                SPLIT line INTO user, product_ids
                IF user == username
                    cart_items = SPLIT product_ids BY ','
                    RETURN cart_items
                ENDIF
            ENDFOR
        CLOSE cart_file
    EXCEPT FileNotFoundError
        RETURN empty list
    END TRY
    RETURN cart_items
END FUNCTION

FUNCTION save_cart(username, cart_items)
    OPEN cart_file IN write mode
        WRITE username, '|', JOIN cart_items BY ',' TO cart_file
    CLOSE cart_file
END FUNCTION
```
