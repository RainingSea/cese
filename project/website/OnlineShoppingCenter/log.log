    def __init__(self):
        self.cart = []

    def add_to_cart(self, product_id: str) -> None:
        self.cart.append(product_id)

    def remove_from_cart(self, product_id: str) -> None:
        self.cart.remove(product_id)

    def get_cart(self) -> list:
        return self.cart

    def clear_cart(self) -> None:
        self.cart.clear()
