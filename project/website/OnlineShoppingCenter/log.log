CLASS OrderManager
    FUNCTION create_order(username: STRING, cart_items: LIST, shipping_info: DICT)
        IF cart_items IS EMPTY
            RAISE ValueError("Cart is empty.")
        ENDIF
        order_summary = "User: " + username + " | Items: " + JOIN(cart_items, ",") + " | Shipping: " + shipping_info['address'] + " | Payment: " + shipping_info['payment_method']
        orders.APPEND(SPLIT(order_summary, '|'))
        CALL save_orders()
    END FUNCTION

    FUNCTION save_orders()
        OPEN 'orders.txt' FOR WRITING AS file
            FOR EACH order IN orders
                WRITE JOIN(order, '|') + "\n" TO file
            ENDFOR
        CLOSE file
    END FUNCTION
```
