        <input type="password" id="password" name="password" required>
        <label for="email">Email:</label>
        <input type="email" id="email" name="email" required>
        <button type="submit">Register</button>
    </form>
    <p><a href="/">Login</a></p>
    {% with messages = get_flashed_messages() %}
        {% if messages %}
            <ul>
            {% for message in messages %}
                <li>{{ message }}</li>
            {% endfor %}
            </ul>
        {% endif %}
    {% endwith %}
</body>
</html>
```

*** templates/main_blog.html
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Main Blog</title>
</head>
<body>
    <h1>Blog Posts</h1>
    <a href="/new_post">Create New Post</a>
    <a href="/logout">Logout</a>
    <ul>
        {% for post in posts %}
            <li>
                <a href="/view_post/{{ loop.index0 }}">{{ post.title }}</a>
                <form method="post" action="/delete_post/{{ loop.index0 }}" style="display:inline;">
                    <button type="submit">Delete</button>
                </form>
            </li>
        {% else %}
            <li>No posts available.</li>
        {% endfor %}
    </ul>
</body>
</html>
```

*** templates/new_post.html
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>New Post</title>
</head>
<body>
    <h1>Create New Post</h1>
    <form method="post" action="/new_post">
        <label for="title">Title:</label>
        <input type="text" id="title" name="title" required>
        <label for="content">Content:</label>
        <textarea id="content" name="content" required></textarea>
        <input type="hidden" name="username" value="{{ username }}"> <!-- Assume username is passed from session -->
        <button type="submit">Submit</button>
    </form>
    <p><a href="/main_blog">Back to Blog</a></p>
    {% with messages = get_flashed_messages() %}
        {% if messages %}
            <ul>
            {% for message in messages %}
                <li>{{ message }}</li>
            {% endfor %}
            </ul>
        {% endif %}
    {% endwith %}
</body>
</html>
```

