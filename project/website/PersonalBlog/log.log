        posts = self.load_posts()
        for post in posts:
            if post.title == title:
                post.edit(new_title, new_content)
                break

    def delete_post(self, title: str) -> None:
        posts = self.load_posts()
        with open(self.posts_file, 'w') as file:
            for post in posts:
                if post.title != title:
                    file.write(f"{post.username},{post.title},{post.content}\n")
