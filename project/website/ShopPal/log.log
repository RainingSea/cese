    FUNCTION load_products()
        IF 'products.txt' FILE EXISTS
            OPEN 'products.txt' AS file
                FOR EACH line IN file
                    SPLIT line BY '|'
                    ASSIGN product_id to line[0]
                    ASSIGN details to line[1]
                    ADD product_id -> details TO self.products DICTIONARY

    FUNCTION get_product(product_id)
        RETURN self.products[product_id] IF product_id EXISTS ELSE EMPTY DICT
    
ROUTE '/product/<product_id>'
