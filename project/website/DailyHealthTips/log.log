        RENDER 'register.html'  // Load registration page
    ELSE IF request.method == 'POST'
        username = request.form['username']
        password = request.form['password']
        result = user_manager.register(username, password)  // Call register function
        IF result is True
            REDIRECT to '/'  // Redirect to login page after successful registration
        ELSE
            RETURN "Registration failed, username may already exist."  // Handle registration failure
        ENDIF
    ENDIF
END FUNCTION
```|Case|:**registration**
```pseudocode
FUNCTION register(username, password)
    IF username exists in users
        RETURN False  // Username already exists
    ELSE
        OPEN users.txt to append
        WRITE username + "|" + password  // Save new username and password
        END OPEN
        users[username] = password  // Update in-memory user store
        RETURN True  // Registration successful
    ENDIF
END FUNCTION
```

