class TestDailyHealthTipsApp(unittest.TestCase):

    @classmethod
    def setUpClass(cls):
        cls.process = subprocess.Popen(['python', 'main.py'])

    @classmethod
    def tearDownClass(cls):
        cls.process.terminate()

