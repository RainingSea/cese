CLASS UserManager
    FUNCTION register(username: str, password: str) -> bool
        IF any user[0] == username FOR user IN self.users
            RETURN False
        ENDIF
        APPEND (username, password) to self.users
        OPEN 'users.txt' IN append mode AS file
            WRITE f"{username},{password}\n" TO file
        END FUNCTION
        RETURN True
    END FUNCTION
END CLASS
```
