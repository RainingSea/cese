|Case|:**user_login**
   ```pseudocode
   FUNCTION login() 
       RENDER 'login.html' PAGE
   END FUNCTION

   FUNCTION authenticate() 
       IF METHOD IS POST
           username = GET 'username' FROM request
           password = GET 'password' FROM request
           IF user_manager.login(username, password) RETURNS TRUE
               SET session['username'] TO username
               REDIRECT TO 'story' PAGE
           ELSE
               REDIRECT TO 'login' PAGE
           ENDIF
       ENDIF
   END FUNCTION

   CLASS UserManager
       FUNCTION load_users()
           TRY
               OPEN 'users.txt' IN READ MODE
               FOR EACH line IN file
                   username, password, email = SPLIT line BY ','
                   ADD {'username': username, 'password': password, 'email': email} TO users LIST
               ENDFOR
           EXCEPT FileNotFoundError
               DO NOTHING
           ENDTRY
           RETURN users
       END FUNCTION

       FUNCTION login(username, password)
           FOR EACH user IN users
               IF user['username'] IS EQUAL TO username AND user['password'] IS EQUAL TO password
                   RETURN TRUE
               ENDIF
           ENDFOR
           RETURN FALSE
       END FUNCTION
   END CLASS
   ```


