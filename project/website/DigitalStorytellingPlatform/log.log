    def load_stories(self) -> list:
        stories = []
        with open(self.stories_file, 'r') as file:
            for line in file:
                username, title, content = line.strip().split('|')
                stories.append(Story(username, title, content))
        return stories

    def save_story(self, story: Story) -> None:
