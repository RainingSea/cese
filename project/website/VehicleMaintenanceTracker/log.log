FUNCTION register()
    IF request method is POST THEN
        SET username = request.form['username']
        SET password = request.form['password']
        
        IF user_manager.register(username, password) IS TRUE THEN
            REDIRECT to login()
        ELSE
            RENDER error message "User already exists."
        ENDIF
    ENDIF
    RENDER registration template
END FUNCTION

CLASS UserManager
    FUNCTION register(username, password) RETURNS Boolean
        FOR user IN self.users DO
            IF user[0] == username THEN
                RETURN FALSE  # User already exists
            ENDIF
        ENDFOR
        APPEND [username, password] to self.users
        CALL save_users()
        RETURN TRUE
    END FUNCTION
    
    FUNCTION save_users()
        OPEN 'users.txt' for writing AS file
            FOR user IN self.users DO
                WRITE '|'.join(user) to file
            ENDFOR
        CLOSE file
    END FUNCTION
END CLASS
```
