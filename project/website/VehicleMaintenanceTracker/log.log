FUNCTION maintenance_tracking()
    IF request method is POST THEN
        SET vehicle_id = request.form['vehicle_id']
        SET task = request.form['task']
        SET date = request.form['date']
        
        CALL maintenance_manager.add_record(vehicle_id, task, date)
        REDIRECT to maintenance_tracking()
    ENDIF
    RENDER maintenance tracking template
END FUNCTION

CLASS MaintenanceManager
    FUNCTION add_record(vehicle_id, task, date) RETURNS Boolean
        APPEND [STR(vehicle_id), task, date] to self.maintenance_records
        CALL save_records()
        RETURN TRUE
    END FUNCTION

    FUNCTION save_records()
        OPEN 'maintenance.txt' for writing AS file
            FOR record IN self.maintenance_records DO
                WRITE '|'.join(record) to file
            ENDFOR
        CLOSE file
    END FUNCTION
END CLASS
