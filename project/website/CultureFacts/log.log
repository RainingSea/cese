DEFINE flask_app AS Flask()

SET secret_key FOR flask_app

DEFINE load_users FUNCTION:
    CREATE empty list users
    TRY:
        OPEN 'users.txt' as f
        FOR each line in f:
            SPLIT line by '|'
            APPEND User(username, password) to users
    EXCEPT FileNotFoundError:
        RETURN empty users
    RETURN users

DEFINE login_view AS route('/login', methods=['POST']):
    GET username AND password FROM request
    CALL load_users() TO retrieve users
    CHECK IF any user.username == username AND user.password == password
        SET session['username'] to username
        REDIRECT TO 'dashboard'
