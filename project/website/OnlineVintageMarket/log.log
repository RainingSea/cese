```python
class User:
    def __init__(self, username: str, password: str):
        self.username = username
        self.password = password

    def register(self) -> bool:
        with open('users.txt', 'a') as file:
            file.write(f"{self.username}|{self.password}\n")
        return True

    def login(self) -> bool:
        with open('users.txt', 'r') as file:
            for line in file:
                user, pwd = line.strip().split('|')
                if user == self.username and pwd == self.password:
                    return True
        return False
```

*** item.py
```python
class Item:
    def __init__(self, name: str, description: str, price: float):
        self.name = name
        self.description = description
        self.price = price

    def save(self) -> None:
        with open('items.txt', 'a') as file:
            file.write(f"{self.name}|{self.description}|{self.price}\n")

    @classmethod
    def load_all(cls) -> list:
        items = []
        try:
            with open('items.txt', 'r') as file:
                for line in file:
                    name, description, price = line.strip().split('|')
                    items.append(cls(name, description, float(price)))
        except FileNotFoundError:
            pass
        return items
