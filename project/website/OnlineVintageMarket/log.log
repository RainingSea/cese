*** auth_manager.py
```python
import os
import time

class AuthManager:
    def __init__(self):
        self.users_file = 'users.txt'
        self.sessions_file = 'sessions.txt'
        if not os.path.exists(self.users_file):
            open(self.users_file, 'w').close()
        if not os.path.exists(self.sessions_file):
            open(self.sessions_file, 'w').close()

    def login(self, username, password):
        if not self._validate_credentials(username, password):
            return False
        
        with open(self.sessions_file, 'a') as f:
            f.write(f"{username}|{int(time.time())}\n")
        return True

    def register(self, username, password, email=''):
        if not username or not password:
            return False
        
        if self._user_exists(username):
            return False
        
        return self._save_user(username, password, email)

    def _validate_credentials(self, username, password):
        with open(self.users_file, 'r') as f:
            for line in f:
                parts = line.strip().split('|')
                if len(parts) >= 2 and parts[0] == username and parts[1] == password:
                    return True
        return False

    def _user_exists(self, username):
        with open(self.users_file, 'r') as f:
            for line in f:
                stored_username = line.strip().split('|')[0]
                if stored_username == username:
                    return True
        return False

    def _save_user(self, username, password, email):
        try:
            with open(self.users_file, 'a') as f:
                f.write(f"{username}|{password}|{email}\n")
            return True
        except:
            return False
```

*** item_manager.py
```python
import os
import time
import random

class ItemManager:
    def __init__(self):
        self.items_file = 'items.txt'
        if not os.path.exists(self.items_file):
            open(self.items_file, 'w').close()

    def get_items(self):
        return self._load_items()

    def search_items(self, query):
        items = self._load_items()
        return [item for item in items if query.lower() in item['title'].lower()]

    def get_item_details(self, item_id):
        items = self._load_items()
        for item in items:
            if item['id'] == item_id:
                return item
        return None

    def add_item(self, title, description, price, seller):
        items = self._load_items()
        item_id = f"{int(time.time())}{random.randint(100,999)}"
        new_item = {
            'id': item_id,
            'title': title,
            'description': description,
            'price': price,
            'seller': seller
        }
        items.append(new_item)
        return self._save_items(items)

    def _load_items(self):
        items = []
        if not os.path.exists(self.items_file):
            return items
            
        with open(self.items_file, 'r') as f:
            for line in f:
                parts = line.strip().split('|')
                if len(parts) == 5:
                    items.append({
                        'id': parts[0],
                        'title': parts[1],
                        'description': parts[2],
                        'price': float(parts[3]),
                        'seller': parts[4]
                    })
        return items

    def _save_items(self, items):
        try:
            with open(self.items_file, 'w') as f:
                for item in items:
                    line = f"{item['id']}|{item['title']}|{item['description']}|{item['price']}|{item['seller']}\n"
                    f.write(line)
            return True
        except:
            return False
