class User:
    // Constructor to initialize user attributes
    method __init__(username: str, password: str, email: str):
        set self.username to username
        set self.password to password
        set self.email to email

    // Method to save user details to a file
    method save():
        open 'users.txt' in append mode as file:
            write "{self.username}|{self.password}|{self.email}\n" to file

    // Static method to load all users from a file
    method load_all() -> list:
        create empty list users
        try:
            open 'users.txt' in read mode as file:
                for line in file:
                    split line using '|' into username, password, email
                    append new User(username, password, email) to users
        except FileNotFoundError:
            pass
        return users

class Auth:
    // Constructor to initialize Auth object
    method __init__():
        set self.users to User.load_all()

    // Method to register a new user
    method register(username: str, password: str, email: str) -> bool:
        if any user in self.users where user.username == username:
            return False  // Username already exists
        create new_user as User(username, password, email)
        new_user.save() // Save new user to file
        append new_user to self.users
        return True  // Registration successful
```

