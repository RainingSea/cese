    <p><strong>Source:</strong> {{ article.source }}</p>  <!-- Display the article source -->
    <p>{{ article.full_text }}</p>  <!-- Display the full article text -->
    <a href="/dashboard">Back to Dashboard</a>  <!-- Link back to dashboard -->
</body>
</html>
```

