2. |Case|:**registration**
```
FUNCTION register()
    IF method is POST
        username = request.form['username']
        password = request.form['password']
        IF user_manager.register(username, password) returns TRUE
            REDIRECT to '/'
        ELSE
            RETURN "User already exists", 400
    ENDIF
    RENDER 'registration.html'
END FUNCTION

CLASS UserManager
    FUNCTION register(username, password) -> BOOLEAN
        IF username exists in users
            RETURN FALSE
        ENDIF
        users[username] = password
        OPEN 'users.txt' in append mode
            WRITE username + "|" + password + "\n"
        END OPEN
        RETURN TRUE
END CLASS
```

3. |Case|:**view_article_details**
```
FUNCTION article_details(article_id)
    articles = article_manager.articles
    IF article_id is within valid range
        RENDER 'article_details.html' with article
    ELSE
        RETURN "Article not found", 404
    ENDIF
END FUNCTION

CLASS ArticleManager
    FUNCTION load_articles() -> List
        OPEN 'articles.txt' in read mode
        FOR each line in file
            articles.append(trimmed line)
        END FOR
        RETURN articles
END CLASS
```

