|Case|:**browse_news_categories**
   ```python
   CLASS ArticleManager
       FUNCTION __init__()
           self.articles = self.load_articles()

       FUNCTION load_articles() -> list
           Initialize articles as empty list
           OPEN 'articles.txt' FOR READING as file
               FOR EACH line in file
                   Split line by ',' into headline, summary, source, full_text
                   Append {headline, summary, source, full_text} to articles
               ENDFOR
           RETURN articles

   CLASS Main
       FUNCTION setup_routes()
           DEFINE route '/dashboard' (GET)
               articles = self.article_manager.articles
               RENDER 'dashboard.html' WITH articles
           END DEFINE
   ```
|Case|:**registration**
   ```python
   CLASS UserManager:
       FUNCTION __init__(users_file)
           SET self.users_file to users_file
           CALL load_users()

       FUNCTION load_users()
           INITIALIZE self.users as an empty dictionary
           OPEN users_file for read
               FOR each line in file:
                   SPLIT line by '|' into username and password
                   SET self.users[username] = password

       FUNCTION register(username, password):
           IF username in self.users THEN
               RETURN False
           ENDIF
           OPEN users_file for append
               WRITE username|password to file
           ADD username to self.users
           RETURN True

   ROUTE /register (method: GET, POST):
       IF request.method is POST THEN
           SET username to request.form['username']
           SET password to request.form['password']
           IF user_manager.register(username, password) THEN
               REDIRECT to /login
           ELSE
               RENDER registration.html with error "Username already exists"
       ENDIF
       RENDER registration.html
   ```


