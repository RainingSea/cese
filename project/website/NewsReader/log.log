<!DOCTYPE html>
<html>
<head>
    <title>Dashboard</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>
    <header>
        <h1>Welcome, {{ username }}</h1>
        <a href="{{ url_for('logout') }}" class="logout">Logout</a>
    </header>
    <div class="container">
        <div class="sidebar">
            <h2>Categories</h2>
            <ul>
                <li><a href="{{ url_for('dashboard') }}">All</a></li>
                {% for category in categories %}
                <li><a href="{{ url_for('dashboard', category=category) }}">{{ category }}</a></li>
                {% endfor %}
            </ul>
        </div>
        <div class="main-content">
            <form method="GET" action="{{ url_for('dashboard') }}" class="search-form">
                <input type="text" name="query" placeholder="Search news...">
                <button type="submit">Search</button>
            </form>
            
            <div class="news-feed">
                {% for item in news_items %}
                <div class="news-card">
                    <h3><a href="{{ url_for('article', article_id=item.id) }}">{{ item.title }}</a></h3>
                    <p class="summary">{{ item.summary }}</p>
                    <div class="meta">
                        <span class="category">{{ item.category }}</span>
                        <span class="source">{{ item.source }}</span>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</body>
</html>
