    return render_template('article_details.html', article=article)  # Render article details page

# article_manager.py
class ArticleManager:
    def load_articles(self) -> list:
        articles = []  # Initialize a list to hold articles
        try:
            with open('articles.txt', 'r') as file:  # Attempt to open articles.txt
                for line in file:
                    headline, summary, source, full_text = line.strip().split(',')  # Parse each line of the text file
                    articles.append({
                        'headline': headline,
                        'summary': summary,
                        'source': source,
                        'full_text': full_text  # Structure article information into a dictionary
                    })
        except FileNotFoundError:  # Handle file not found error
            pass
        return articles  # Return the list of articles

# templates/article_details.html
<!DOCTYPE html>
<html lang="en">
