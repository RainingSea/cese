import datetime

app = Flask(__name__)
app.secret_key = 'secret_key'  # For session management

class TaskManager:
    def __init__(self):
        self.users_file = 'users.txt'
        self.tasks_file = 'tasks.txt'
        self._initialize_files()

    def _initialize_files(self):
        if not os.path.exists(self.users_file):
            open(self.users_file, 'w').close()
        if not os.path.exists(self.tasks_file):
            open(self.tasks_file, 'w').close()

    def validate_credentials(self, username, password):
        with open(self.users_file, 'r') as f:
            for line in f:
                stored_username, stored_password, _ = line.strip().split(',')
                if username == stored_username and password == stored_password:
                    return True
        return False

    def create_user(self, username, password, email):
        # Check if username already exists
        with open(self.users_file, 'r') as f:
            for line in f:
                stored_username, _, _ = line.strip().split(',')
                if username == stored_username:
                    return False

        with open(self.users_file, 'a') as f:
            f.write(f"{username},{password},{email}\n")
        return True

    def add_task(self, username, description, due_date):
        task_id = f"{datetime.datetime.now().timestamp()}_{random.randint(1000,9999)}"
        with open(self.tasks_file, 'a') as f:
            f.write(f"{username},{description},{due_date},{task_id}\n")
        return task_id

    def delete_task(self, username, task_id):
        lines = []
        found = False
        
        with open(self.tasks_file, 'r') as f:
            for line in f:
                parts = line.strip().split(',')
                if parts[3] == task_id and parts[0] == username:
                    found = True
                else:
                    lines.append(line)
        
        if found:
            with open(self.tasks_file, 'w') as f:
                f.writelines(lines)
            return True
        return False

    def get_user_tasks(self, username):
        tasks = []
        with open(self.tasks_file, 'r') as f:
            for line in f:
                parts = line.strip().split(',')
                if parts[0] == username:
                    tasks.append({
                        'description': parts[1],
                        'due_date': parts[2],
                        'task_id': parts[3]
                    })
        return tasks

