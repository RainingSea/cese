            FOR EACH task IN tasks.txt  
                IF task['username'] == username  
                    IF task_index == 0  
                        REMOVE task  
                        SET removed = True  
                    ELSE  
                        DECREMENT task_index  
                    ENDIF  
                ENDIF  
            ENDFOR  
        ENDIF  

        IF removed  
            REWRITE tasks.txt WITHOUT removed task  
            RETURN True  
        ENDIF  
        RETURN False  
    ENDFUNCTION  
ENDCLASS  
