    REDIRECT to home  
ENDFUNCTION  

CLASS TaskManager  
    FUNCTION remove_task(username, task_index)  
        IF tasks.txt EXISTS  
            FOR EACH task IN tasks.txt  
                IF task['username'] == username  
                    IF task_index == 0  
                        REMOVE task  
                        SET removed = True  
                    ELSE  
                        DECREMENT task_index  
                    ENDIF  
                ENDIF  
            ENDFOR  
        ENDIF  

        IF removed  
            REWRITE tasks.txt WITHOUT removed task  
            RETURN True  
        ENDIF  
        RETURN False  
    ENDFUNCTION  
ENDCLASS  
```
