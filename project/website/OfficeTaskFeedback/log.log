        username = GET username from request
        password = GET password from request
        IF user_manager.register(username, password) THEN
            FLASH 'Registration successful! You can now log in.'
            REDIRECT to login
        ELSE
            FLASH 'Registration failed. Username already exists.'
        ENDIF
    ENDIF
    RENDER registration.html
END FUNCTION

