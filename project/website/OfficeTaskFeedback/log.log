CLASS FeedbackManager
    FUNCTION __init__()
        INITIALIZE feedbacks
        CALL load_feedbacks()

    FUNCTION load_feedbacks()
        INITIALIZE feedbacks AS EMPTY LIST
        TRY
            OPEN 'feedback.txt' FOR READING AS file
                FOR EACH line IN file
                    SPLIT line BY '|'
                    APPEND {'user_id': user_id, 'category': category, 'content': content} TO feedbacks
            END FOR
        EXCEPTION FileNotFoundError
            PASS
        RETURN feedbacks

    FUNCTION review_feedback() -> LIST
        RETURN feedbacks

FUNCTION feedback()
    IF request.method IS 'POST'
        GET user_id FROM session
        GET category FROM request.form
        GET content FROM request.form
        CALL feedback_manager.submit_feedback(user_id, category, content)
        REDIRECT TO feedback_status
    ENDIF
    RENDER feedback.html
