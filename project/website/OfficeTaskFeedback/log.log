CLASS FeedbackManager
    FUNCTION __init__()
        INITIALIZE feedbacks as empty list
        CALL load_feedback()

    FUNCTION load_feedback()
        TRY
            OPEN 'feedback.txt' for reading
            SET feedbacks to lines from file split by '|'
        EXCEPT FileNotFoundError
            SET feedbacks to empty list

    FUNCTION get_feedback_categories() -> list
        RETURN list of categories from predefined options

END CLASS

