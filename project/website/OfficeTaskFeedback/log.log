        username = GET username from request
        password = GET password from request
        IF user_manager.register(username, password) THEN
            FLASH 'Registration successful! You can now log in.'
            REDIRECT to login
        ELSE
            FLASH 'Registration failed. Username already exists.'
        ENDIF
    ENDIF
    RENDER registration.html
END FUNCTION

CLASS UserManager
    FUNCTION register(username: str, password: str) -> bool
        IF username not in users THEN
            users[username] = password
            APPEND username and password to users.txt
            RETURN True
        ENDIF
        RETURN False
    END FUNCTION
END CLASS
