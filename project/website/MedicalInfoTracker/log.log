class MedicalInfoManager:
    def __init__(self, medical_info_file: str):
        self.medical_info_file = medical_info_file
        self.load_medical_info()

    def load_medical_info(self):
        self.medical_info = {}

        with open(self.medical_info_file, 'r') as file:
