```python
FUNCTION save_user(user: User) -> None
    users = User.load_users()
    IF user.username NOT IN [user.username FOR user IN users] THEN
        OPEN 'users.txt' in append mode
            WRITE user.username + "|" + user.password + "\n"
        END OPEN
        RETURN True
    ENDIF
    RETURN False
END FUNCTION
```

