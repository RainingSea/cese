        <button type="submit">Set Appointment</button>
    </form>
    <ul>
        {% for appointment in appointments %}
            <li>{{ appointment }}</li>
        {% endfor %}
    </ul>
    
    <a href="/logout">Logout</a>
</body>
</html>
