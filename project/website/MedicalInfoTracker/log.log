l_info', methods=['GET', 'POST'])\nFUNCTION medical_info()\n    IF request method is POST\n        CALL add_info with inputs from form\n    info = CALL view_info\n    RENDER 'medical_info.html' with info\nEND FUNCTION\n```\n", "|Case|:**set_reminders**\n```plaintext\nCLASS ReminderManager\n    FUNCTION __init__()\n        LOAD reminders from 'reminders.txt'\n\n    FUNCTION load_reminders()\n        OPEN 'reminders.txt'\n        FOR EACH line IN file\n            SPLIT line into date, time, description\n            APPEND [date, time, description] to reminders list\n\n    FUNCTION set_reminder(date, time, description)\n        APPEND [date, time, description] to reminders list\n        APPEND date|time|description to 'reminders.txt'\n\n    FUNCTION get_reminders()\n        RETURN reminders list\n\n@app.route('/reminders', methods=['GET', 'POST'])\nFUNCTION reminders()\n    IF request method is POST\n        CALL set_reminder with inputs from form\n    reminders = CALL get_reminders\n    RENDER 'reminders.html' with reminders\nEND FUNCTION\n```"]
