from flask import Flask, render_template
from auth import AuthHandler
from tutor_manager import TutorHandler

def create_app():
    app = Flask(__name__)
    app.secret_key = 'dev_key'  # For development only
    
    auth_handler = AuthHandler('users.txt')
    tutor_handler = TutorHandler('tutors.txt', 'requests.txt')
    
    @app.route('/')
    def home():
        return render_template('login.html')
    
    @app.route('/dashboard')
    def dashboard():
        return render_template('dashboard.html')
    
    return app

if __name__ == '__main__':
    app = create_app()
    app.run(debug=True)
```

*** auth.py
```python
from flask import flash

class AuthHandler:
    def __init__(self, users_file):
        self.users_file = users_file
    
    def register(self, username, password, email):
        if not self._validate_user_data(username, password, email):
            return False
        
        users = self._read_users_file()
        if any(user.split('|')[0] == username for user in users):
            flash('Username already exists')
            return False
        
        users.append(f"{username}|{password}|{email}")
        self._write_users_file(users)
        return True
    
    def login(self, username, password):
        users = self._read_users_file()
        for user in users:
            parts = user.split('|')
            if parts[0] == username and parts[1] == password:
                return True
        return False
    
    def get_user(self, username):
        users = self._read_users_file()
        for user in users:
            parts = user.split('|')
            if parts[0] == username:
                return {
                    'username': parts[0],
                    'email': parts[2]
                }
        return None
    
    def _validate_user_data(self, username, password, email):
        if not username or not password or not email:
            flash('All fields are required')
            return False
        if '|' in username or '|' in password or '|' in email:
            flash('Invalid character in input')
            return False
        return True
    
    def _read_users_file(self):
        try:
            with open(self.users_file, 'r') as f:
                return [line.strip() for line in f.readlines() if line.strip()]
        except FileNotFoundError:
            return []
    
    def _write_users_file(self, users):
        with open(self.users_file, 'w') as f:
            f.write('\n'.join(users))
```

*** tutor_manager.py
```python
class TutorHandler:
    def __init__(self, tutors_file, requests_file):
        self.tutors_file = tutors_file
        self.requests_file = requests_file
    
    def get_tutors(self):
        tutors = self._read_tutors_file()
        return [{
            'username': tutor.split('|')[0],
            'subjects': tutor.split('|')[1].split(',')
        } for tutor in tutors]
    
    def add_request(self, student, tutor, subject, details, date):
        requests = self._read_requests_file()
        requests.append(f"{student}|{tutor}|{subject}|{details}|{date}|pending")
        self._write_requests_file(requests)
        return True
    
    def get_requests(self, username):
        requests = self._read_requests_file()
        user_requests = []
        for req in requests:
            parts = req.split('|')
            if parts[0] == username or parts[1] == username:
                user_requests.append({
                    'student': parts[0],
                    'tutor': parts[1],
                    'subject': parts[2],
                    'details': parts[3],
                    'date': parts[4],
                    'status': parts[5]
                })
        return user_requests
    
    def _read_tutors_file(self):
        try:
            with open(self.tutors_file, 'r') as f:
                return [line.strip() for line in f.readlines() if line.strip()]
        except FileNotFoundError:
            return []
    
    def _read_requests_file(self):
        try:
            with open(self.requests_file, 'r') as f:
                return [line.strip() for line in f.readlines() if line.strip()]
        except FileNotFoundError:
            return []
    
    def _write_requests_file(self, requests):
        with open(self.requests_file, 'w') as f:
            f.write('\n'.join(requests))
