FUNCTION register()
    IF POST request
        RETRIEVE username from request form
        RETRIEVE password from request form
        RETRIEVE email from request form
        IF user_manager.register(username, password, email) is SUCCESSFUL
            REDIRECT user to login page
        ELSE
            RETURN "Registration failed. Username already exists."
        ENDIF
    ENDIF
    RENDER registration.html
END FUNCTION

CLASS UserManager
    FUNCTION register(username: str, password: str, email: str) -> bool
        FOR each user IN users
            IF user.username == username
                RETURN False
            ENDIF
        ENDFOR
        new_user = User(username, password, email)
        APPEND new_user to users
        OPEN 'users.txt' in append mode
            WRITE username, password, and email in the format "username|password|email"
        END OPEN
        RETURN True
    END FUNCTION
END CLASS
```

