    try:
        with open('tutors.txt', 'r') as f:
            for line in f:
                name, subject = line.strip().split('|')
                tutors.append(Tutor(name, subject))
    except FileNotFoundError:
        pass
    return tutors

@app.route('/', methods=['GET', 'POST'])
def login():
