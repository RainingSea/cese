    <ul>
        {% for tutor in tutors %}
            <li>{{ tutor.name }} - Subject: {{ tutor.subject }} - Availability: {{ tutor.availability }}</li>
        {% endfor %}
    </ul>
    
    <h3>Request Tutoring:</h3>
    <form method="POST">
        <label for="subject">Subject:</label>
        <input type="text" id="subject" name="subject" required>
        <br>
        <label for="details">Details:</label>
        <textarea id="details" name="details" required></textarea>
        <br>
        <label for="preferred_date">Preferred Date:</label>
        <input type="date" id="preferred_date" name="preferred_date" required>
        <br>
        <button type="submit">Request Tutoring</button>
    </form>

    <h3>Your Requests:</h3>
    <ul>
        {% for request in requests %}
            <li>{{ request.subject }} - Details: {{ request.details }} - Preferred Date: {{ request.preferred_date }}
                <form method="POST" action="{{ url_for('cancel_request', request_id=loop.index0) }}">
                    <button type="submit">Cancel Request</button>
                </form>
            </li>
        {% endfor %}
    </ul>
    <a href="/logout">Logout</a>
</body>
</html>

