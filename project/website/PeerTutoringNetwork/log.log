*** tutor_manager.py
```python
from datetime import datetime

class TutorHandler:
    def __init__(self, tutors_file, requests_file):
        self.tutors_file = tutors_file
        self.requests_file = requests_file
    
    def get_all_tutors(self):
        tutors = self._read_tutors_file()
        return [{
            'id': tutor.split('|')[0],
            'name': tutor.split('|')[1],
            'subjects': tutor.split('|')[2].split(',')
        } for tutor in tutors]
    
    def add_request(self, student, tutor_id, subject, details, date):
        try:
            datetime.strptime(date, '%Y-%m-%d')
            requests = self._read_requests_file()
            requests.append(f"{student}|{tutor_id}|{subject}|{details}|{date}|pending")
            self._write_requests_file(requests)
            return True
        except ValueError:
            return False
    
    def get_requests(self, username):
        requests = self._read_requests_file()
        user_requests = []
        for req in requests:
            parts = req.split('|')
            if parts[0] == username or parts[1] == username:
                user_requests.append({
                    'student': parts[0],
                    'tutor': parts[1],
                    'subject': parts[2],
                    'details': parts[3],
                    'date': parts[4],
                    'status': parts[5]
                })
        return user_requests
    
    def _read_tutors_file(self):
        try:
            with open(self.tutors_file, 'r') as f:
                return [line.strip() for line in f.readlines() if line.strip()]
        except FileNotFoundError:
            return []
    
    def _read_requests_file(self):
        try:
            with open(self.requests_file, 'r') as f:
                return [line.strip() for line in f.readlines() if line.strip()]
        except FileNotFoundError:
            return []
    
    def _write_requests_file(self, requests):
        with open(self.requests_file, 'w') as f:
            f.write('\n'.join(requests))
