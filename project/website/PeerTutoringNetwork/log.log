            RENDER login.html WITH error="Invalid credentials"
    ELSE:
        RENDER login.html
```

2. |Case|:**user_registration**
```python
# auth.py
CLASS AuthHandler:
    FUNCTION create_user(username, password, email):
        TRY:
            OPEN users.txt IN APPEND MODE
            WRITE f"{username}|{password}|{email}\n"
            RETURN True
        EXCEPT:
            RETURN False

# main.py
ROUTE /register (POST):
    IF request.method == "POST":
        username = request.form["username"]
        password = request.form["password"]
        email = request.form["email"]
        IF auth_handler.create_user(username, password, email):
            REDIRECT /login
        ELSE:
            RENDER register.html WITH error="Registration failed"
    ELSE:
        RENDER register.html
```

3. |Case|:**access_dashboard**
```python
# main.py
ROUTE /dashboard:
    IF "username" NOT IN session:
        REDIRECT /login
    ELSE:
        RENDER dashboard.html WITH username=session["username"]
```

4. |Case|:**view_available_tutors**
```python
# tutor.py
CLASS TutorHandler:
    FUNCTION get_all_tutors():
        tutors = []
        TRY:
            OPEN tutors.txt
            FOR EACH line IN file:
                SPLIT line BY "|" INTO [id, name, subjects]
                APPEND {"id": id, "name": name, "subjects": subjects} TO tutors
        EXCEPT FileNotFoundError:
            PASS
        RETURN tutors

# main.py
ROUTE /tutors:
    IF "username" NOT IN session:
        REDIRECT /login
    ELSE:
        tutors_list = tutor_handler.get_all_tutors()
        RENDER tutors.html WITH tutors=tutors_list
```

5. |Case|:**user_logout**
```python
# main.py
ROUTE /logout:
    REMOVE "username" FROM session
    REDIRECT /login
```

6. |Case|:**access_profile_page**
```python
FUNCTION profile()
    IF NOT SESSION_CONTAINS('username')
        REDIRECT_TO('login')
    ELSE
        RENDER_TEMPLATE('profile.html', 
                       username=session['username'],
                       email=session['email'])
    ENDIF
END FUNCTION
