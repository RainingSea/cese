{% extends "base.html" %}

{% block content %}
<div class="row">
    <div class="col-md-6">
        <h2>Your Profile</h2>
        <div class="card mt-4">
            <div class="card-body">
                <h5 class="card-title">User Information</h5>
                <p><strong>Username:</strong> {{ user.username }}</p>
                <p><strong>Email:</strong> {{ user.email }}</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <h2>Your Requests</h2>
        {% if requests %}
        <div class="table-responsive mt-4">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Tutor</th>
                        <th>Subject</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for req in requests %}
                    <tr>
                        <td>{{ req.tutor }}</td>
                        <td>{{ req.subject }}</td>
                        <td>{{ req.date }}</td>
                        <td><span class="badge bg-{{ 'success' if req.status == 'completed' else 'warning' }}">{{ req.status }}</span></td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <p class="mt-4">You have no tutoring requests yet.</p>
        {% endif %}
    </div>
</div>
{% endblock %}

