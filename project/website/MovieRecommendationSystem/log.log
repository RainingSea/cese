    OPEN movies.txt IN read mode
    FOR each movie IN movies.txt:
        IF movie.title IN favorites:
            ADD movie.genres TO favorite_genres
    
    # Recommend movies with matching genres
    recommendations = []
    OPEN movies.txt IN read mode
    FOR each movie IN movies.txt:
        IF movie.title NOT IN favorites AND movie.genres INTERSECT favorite_genres:
            ADD movie TO recommendations
    
