            <div class="card-body">
                <h5 class="card-title">{{ movie.title }}</h5>
                <p class="card-text">{{ movie.description[:100] }}...</p>
                <p class="card-text">
                    <small class="text-muted">Rating: {{ movie.rating }}/5</small><br>
                    <small class="text-muted">Genres: {{ movie.genres|join(', ') }}</small>
                </p>
                <a href="/movie/{{ movie.id }}" class="btn btn-primary">View Details</a>
            </div>
        </div>
