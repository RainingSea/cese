FUNCTION remove_favorite(username, movie_title)
    lines = []
    removed = False
    OPEN favorites.txt IN read mode
    FOR each line IN favorites.txt:
        IF line != username + "|" + movie_title:
            ADD line TO lines
        ELSE:
