<h2 class="mb-4">Search Results for "{{ query }}"</h2>
<div class="row">
    {% if movies %}
        {% for movie in movies %}
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">{{ movie.title }}</h5>
                    <p class="card-text">{{ movie.description[:100] }}...</p>
                    <p class="card-text"><small class="text-muted">Rating: {{ movie.rating }}/5</small></p>
                    <a href="/movie/{{ movie.id }}" class="btn btn-primary">View Details</a>
                </div>
            </div>
        </div>
        {% endfor %}
    {% else %}
        <div class="col-12">
            <div class="alert alert-info">No movies found matching your search.</div>
        </div>
    {% endif %}
</div>
{% endblock %}
```

