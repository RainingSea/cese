CLASS MovieManager:
    METHOD load_movies():
        movies = []
        OPEN movies.txt IN READ MODE
        FOR EACH line IN file:
            SPLIT line BY '|' INTO parts
            IF parts HAS >= 5 ELEMENTS:
                APPEND {
                    'id': parts[0],
                    'title': parts[1],
                    'description': parts[2],
                    'rating': parts[3],
                    'genres': parts[4].split(',')
                } TO movies
        RETURN movies

