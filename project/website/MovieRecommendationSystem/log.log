                    <h5 class="card-title">{{ movie.title }}</h5>
                    <p class="card-text">{{ movie.description[:100] }}...</p>
                    <p class="card-text"><small class="text-muted">Rating: {{ movie.rating }}/5</small></p>
                    <a href="/movie/{{ movie.id }}" class="btn btn-primary">View Details</a>
                    <a href="/remove_favorite/{{ movie.id }}" class="btn btn-danger">Remove</a>
                </div>
            </div>
        </div>
        {% endfor %}
    {% else %}
        <div class="col-12">
            <div class="alert alert-info">You haven't added any movies to your favorites yet.</div>
        </div>
    {% endif %}
</div>
{% endblock %}
