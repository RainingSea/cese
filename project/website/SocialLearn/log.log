*** templates/profile.html
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <title>Profile</title>
</head>
<body>
    <div class="container">
        <h2>Profile</h2>
        <p>Username: {{ username }}</p>
        <h3>Your Resources</h3>
        <ul>
            {% for resource in resources %}
                <li><a href="/resource/{{ loop.index0 }}">{{ resource.title }}</a></li>
            {% endfor %}
        </ul>
        <h3>Your Messages</h3>
        <ul>
            {% for message in messages %}
                <li><strong>{{ message.sender }}</strong>: {{ message.content }}</li>
            {% endfor %}
        </ul>
        <form method="POST" action="/add_resource">
            <div class="form-group">
                <label for="title">Resource Title:</label>
                <input type="text" class="form-control" id="title" name="title" required>
            </div>
            <div class="form-group">
                <label for="link">Resource Link:</label>
                <input type="url" class="form-control" id="link" name="link" required>
            </div>
            <div class="form-group">
                <label for="description">Resource Description:</label>
                <textarea class="form-control" id="description" name="description" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Add Resource</button>
        </form>
        <form method="POST" action="/send_message">
            <div class="form-group">
                <label for="receiver">Send Message To:</label>
                <input type="text" class="form-control" id="receiver" name="receiver" required>
            </div>
            <div class="form-group">
                <label for="content">Message Content:</label>
                <textarea class="form-control" id="content" name="content" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Send Message</button>
        </form>
        <a href="/logout" class="btn btn-danger">Logout</a>
    </div>
</body>
</html>
```

