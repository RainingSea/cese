   ```python
   APP: Flask application
   SETUP: Secret key for session management

   FUNCTION load_users()
       INITIALIZE users AS {}
       OPEN 'users.txt' FOR reading AS file
           FOR EACH line IN file
               SPLIT line INTO username AND password
               ADD username AND password TO users DICTIONARY
       RETURN users

   FUNCTION do_login()
       IF request.method IS POST THEN
           users = load_users()
           username = GET username FROM request.form
           password = GET password FROM request.form
           IF username IS IN users AND users[username] EQUALS password THEN
               SET session['username'] TO username
               REDIRECT TO profile
           ELSE
               REDIRECT TO login
   ```

