            Redirect to login page
        ENDIF
    ENDIF
    Render registration.html
END FUNCTION

CLASS UserManager:
    FUNCTION register(username, password)
        IF username NOT IN users THEN
            Add username with password to users dictionary
            Append to users file
        ENDIF
        RETURN True
    END FUNCTION
```
