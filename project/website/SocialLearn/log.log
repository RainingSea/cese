```
CLASS ResourceManager:
    FUNCTION upload_resource(title, type, uploader):
        GET current resources list
        GENERATE new resource_id (length + 1)
        APPEND new resource to resources.txt:
            {"id": resource_id, "title": title, "type": type, "uploader": uploader}
        RETURN resource_id
    
    FUNCTION get_resources():
        IF resources.txt EXISTS:
            READ all resources from file
            RETURN as list of dicts
        ELSE:
            RETURN empty list

ROUTE /resources:
    IF NOT logged in: REDIRECT to login
    IF POST request:
        GET title, type from form
        CALL upload_resource(title, type, current_user)
        REDIRECT to resources page
    GET all resources
    RENDER resources.html with resources list
```

```
CLASS ResourceManager:
    FUNCTION share_resource(title, type, link, shared_by):
        OPEN resources.txt IN APPEND MODE
        WRITE title, type, link, shared_by TO FILE
        RETURN True IF SUCCESS, False IF FAILURE
    
    FUNCTION get_resources():
        READ resources.txt
        FOR EACH LINE:
            SPLIT INTO title, type, link, shared_by
            APPEND TO resources LIST
        RETURN resources LIST
END CLASS

ROUTE /resources (GET/POST):
    IF USER NOT LOGGED IN ¡ú REDIRECT TO LOGIN
    IF POST REQUEST:
        EXTRACT title, type, link FROM FORM
        CALL ResourceManager.share_resource(title, type, link, current_user)
    GET ALL RESOURCES VIA ResourceManager.get_resources()
    RENDER resources.html WITH resources
END ROUTE
```

```
FUNCTION share_resource(title, type, url)
    IF current_user EXISTS
        APPEND title|type|url|current_user TO resources.txt
        RETURN True
    ELSE
        RETURN False
    ENDIF
END FUNCTION

FUNCTION read_resources()
    resources = []
    FOR EACH LINE IN resources.txt
        SPLIT line BY | INTO title, type, url, uploader
        APPEND {title, type, url, uploader} TO resources
    RETURN resources
END FUNCTION
```

