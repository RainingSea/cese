        READ all groups from groups.txt
        FIND target group
        IF user not in group members:
            ADD user to members
            WRITE updated groups back to file
            RETURN True
        RETURN False

ROUTE /join_group/<group_name>:
    IF NOT logged in: REDIRECT to login
    CALL join_group(group_name, current_user)
    REDIRECT to groups page
