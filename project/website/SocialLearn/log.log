*** templates/profile.html
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body>
    <div class="container">
        <h2>Profile of {{ username }}</h2>
        <form method="POST" action="/profile">
            <div class="form-group">
                <label for="interests">Interests:</label>
                <input type="text" class="form-control" id="interests" name="interests" value="{{ ', '.join(interests) }}">
            </div>
            <button type="submit" class="btn btn-primary">Update Profile</button>
        </form>
        <a href="/logout" class="btn btn-danger">Logout</a>
        <a href="/study_groups" class="btn btn-info">View Study Groups</a>
    </div>
</body>
</html>
```

*** templates/study_groups.html
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Study Groups</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body>
    <div class="container">
        <h2>Available Study Groups</h2>
        <form method="POST" action="/study_groups">
            <div class="form-group">
                <label for="group_name">Join Study Group:</label>
                <select class="form-control" id="group_name" name="group_name">
                    {% for group in groups %}
                        <option value="{{ group }}">{{ group }}</option>
                    {% endfor %}
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Join Group</button>
        </form>
        <h3>Your Study Groups</h3>
        <ul>
            {% for group, members in groups.items() %}
                {% if username in members %}
                    <li>{{ group }}</li>
                {% endif %}
            {% endfor %}
        </ul>
    </div>
</body>
</html>
```

*** templates/group_messages.html
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Messages in {{ group_name }}</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body>
    <div class="container">
        <h2>Messages in {{ group_name }}</h2>
        <form method="POST" action="/group_messages/{{ group_name }}">
            <div class="form-group">
                <label for="content">Message:</label>
                <input type="text" class="form-control" id="content" name="content" required>
            </div>
            <button type="submit" class="btn btn-primary">Send Message</button>
        </form>
        <h3>Previous Messages</h3>
        <ul>
            {% for sender, group, content in messages %}
                <li><strong>{{ sender }}:</strong> {{ content }}</li>
            {% endfor %}
        </ul>
        <a href="/profile" class="btn btn-secondary">Back to Profile</a>
    </div>
</body>
</html>
```

