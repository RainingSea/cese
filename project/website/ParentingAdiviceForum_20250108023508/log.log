sage: str)     }     class Forum {         +threads: list         +add_thread(thread: Thread)         +get_threads() list         +get_thread_by_title(title: str) Thread     }     class UserManager {         +users: list         +register_user(username: str, password: str)         +login_user(username: str, password: str) bool         +delete_user(username: str)     }     class ContactManager {         +inquiries: list         +add_inquiry(inquiry: ContactInquiry)     }     UserManager --> User     Forum --> Thread     Thread --> Comment     ContactManager --> ContactInquiry ", [/CONTENT]
