*** templates/dashboard.html
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
</head>
<body>
    <h2>Your Wishlist</h2>
    <form action="/dashboard" method="post">
        <h3>Add Item</h3>
        <label for="item_name">Item Name:</label>
        <input type="text" id="item_name" name="item_name" required>
        <br>
        <label for="description">Description:</label>
        <input type="text" id="description" name="description" required>
        <br>
        <label for="desired_price">Desired Price:</label>
        <input type="number" id="desired_price" name="desired_price" required>
        <br>
        <button type="submit" name="add_item">Add Item</button>
    </form>

    <h3>Current Items</h3>
    <ul>
        {% for item in items %}
        <li>
            {{ item.item_name }} - {{ item.description }} - ${{ item.desired_price }}
            <form action="/dashboard" method="post" style="display:inline;">
                <input type="hidden" name="item_name" value="{{ item.item_name }}">
                <button type="submit" name="remove_item">Remove</button>
            </form>
            <form action="/dashboard" method="post" style="display:inline;">
                <input type="hidden" name="old_name" value="{{ item.item_name }}">
                <input type="text" name="new_name" placeholder="New Name" required>
                <input type="text" name="new_description" placeholder="New Description" required>
                <input type="number" name="new_price" placeholder="New Price" required>
                <button type="submit" name="update_item">Update</button>
            </form>
        </li>
        {% endfor %}
    </ul>
    <a href="/logout">Logout</a>
</body>
</html>
```

