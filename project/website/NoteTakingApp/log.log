The registration process is implemented in this part of the codebase:

**Related Project Code Overview:**
```python
class UserManager:
    def __init__(self, users_file: str):
        # Initialize users_file and load user data
        self.users_file = users_file
        self.users = self.load_users()

    def register(self, username: str, password: str) -> bool:
        # Check if username already exists
        if username in self.users:
            return False
        # Add new user and save to file
        self.users[username] = password
        with open(self.users_file, 'a') as f:
            f.write(f"{username}|{password}\n")
        return True

    def load_users(self) -> dict:
        # Load users from the specified file
        users = {}
        try:
            with open(self.users_file, 'r') as f:
                for line in f:
                    username, password = line.strip().split('|')
                    users[username] = password
        except FileNotFoundError:
            pass
        return users
```
- **Pseudocode:**
```
BEGIN UserManager
  FUNCTION __init__(users_file)
    SET self.users_file = users_file
    SET self.users = load_users()
  END FUNCTION

  FUNCTION register(username, password)
    IF username IN self.users THEN
      RETURN False
    END IF
    self.users[username] = password
    OPEN self.users_file IN append mode AS f
      WRITE username + "|" + password TO f
    END OPEN
    RETURN True
  END FUNCTION

  FUNCTION load_users()
    SET users = {}
    TRY
      OPEN self.users_file IN read mode AS f
        FOR EACH line IN f
          SPLIT line TO username, password
          users[username] = password
        END FOR
      END OPEN
    EXCEPT FileNotFoundError
      RETURN users
    END TRY
  END FUNCTION
END UserManager
```

