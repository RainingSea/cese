<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Note</title>
</head>
<body>
    <h2>Add Note</h2>
    <form method="POST">
        <label for="title">Title:</label>
        <input type="text" id="title" name="title" required>
        <br>
        <label for="content">Content:</label>
        <textarea id="content" name="content" required></textarea>
        <br>
        <button type="submit">Save Note</button>
    </form>
    <a href="/dashboard">Back to Dashboard</a>
</body>
</html>
```

*** templates/view_note.html
```placeholder
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Note</title>
</head>
<body>
    <h2>{{ title }}</h2>
    <p>{{ content }}</p>
    <form method="POST">
        <input type="text" name="new_title" placeholder="New Title" required>
        <textarea name="new_content" placeholder="New Content" required></textarea>
        <button type="submit" name="edit">Edit Note</button>
        <button type="submit" name="delete">Delete Note</button>
    </form>
    <a href="/dashboard">Back to Dashboard</a>
</body>
</html>
```

*** templates/search_note.html
```placeholder
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Note</title>
</head>
<body>
    <h2>Search Note</h2>
    <form method="POST">
        <input type="text" name="title" placeholder="Search by title" required>
        <button type="submit">Search</button>
    </form>
    <h3>Results:</h3>
    <ul>
        {% for title, content in results %}
            <li><a href="{{ url_for('view_note', title=title) }}">{{ title }}</a></li>
        {% endfor %}
    </ul>
    <a href="/dashboard">Back to Dashboard</a>
</body>
</html>
