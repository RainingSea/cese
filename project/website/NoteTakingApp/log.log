<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
</head>
<body>
    <h1>Your Notes</h1>
    <ul id="notes-list">
        <!-- Notes will be populated here -->
    </ul>
    <a href="/add_note">Add Note</a>
    <a href="/logout">Logout</a>
</body>
</html>
```

*** templates/add_note.html
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Note</title>
</head>
<body>
    <h1>Add Note</h1>
    <form action="/add_note" method="post">
        <label for="title">Title:</label>
        <input type="text" id="title" name="title" required>
        <br>
        <label for="content">Content:</label>
        <textarea id="content" name="content" required></textarea>
        <br>
        <button type="submit">Save</button>
        <button type="button" onclick="window.history.back();">Discard</button>
    </form>
</body>
</html>
```

*** templates/view_note.html
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Note</title>
</head>
<body>
    <h1>View Note</h1>
    <h2 id="note-title"></h2>
    <p id="note-content"></p>
    <button onclick="window.location.href='/edit_note'">Edit</button>
    <button onclick="window.location.href='/delete_note'">Delete</button>
    <a href="/dashboard">Back to Dashboard</a>
</body>
</html>
```

*** templates/search_note.html
```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Notes</title>
</head>
<body>
    <h1>Search Notes</h1>
    <form action="/search" method="post">
        <label for="query">Search:</label>
        <input type="text" id="query" name="query" required>
        <button type="submit">Search</button>
    </form>
    <ul id="search-results">
        <!-- Search results will be populated here -->
    </ul>
    <a href="/dashboard">Back to Dashboard</a>
</body>
</html>
