            content = request.form['content']
            note_manager.edit_note(note_id, title, content)
            REDIRECT TO dashboard
        ENDIF
        note = note_manager.notes.get(note_id)
        RENDER view_note.html with note
    END FUNCTION
    ```

6. |Case|:**edit_note**
   ```
   FUNCTION edit_note(note_id: int, title: str, content: str) -> bool
       IF note_id in notes
           notes[note_id]['title'] = title
           notes[note_id]['content'] = content
           CALL save_notes()
           RETURN True
       ENDIF
       RETURN False
   END FUNCTION
   ```

