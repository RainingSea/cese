        <h2>Results for "{{ query }}"</h2>
        {% if results %}
            <ul>
                {% for result in results %}
                    <li>
                        <a href="{{ url_for('view_note', title=result['title']) }}">{{ result['title'] }}</a>
                        <p>{{ result['content'] }}</p>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p>No results found.</p>
        {% endif %}
    {% endif %}
    
