+        
+        if updated:
+            self._save_all_notes(username, notes)
+            return True
+        return False
+
+    def delete_note(self, username, title):
+        notes = self.get_notes(username)
+        remaining_notes = [note for note in notes if note['title'] != title]
+        
+        if len(remaining_notes) < len(notes):
+            self._save_all_notes(username, remaining_notes)
+            return True
+        return False
+
+    def _save_all_notes(self, username, notes):
+        notes_file = self._get_notes_file(username)
+        with open(notes_file, 'w') as f:
+            for note in notes:
+                f.write(f"{note['title']}|{note['content']}|{note['timestamp']}\n")
