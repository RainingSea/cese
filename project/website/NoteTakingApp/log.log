</head>
<body>
    <h1>View Note</h1>
    <h2>{{ note[1] }}</h2>
    <p>{{ note[2] }}</p>
    
    <form action="{{ url_for('view_note', note_id=note[0]) }}" method="post">
        <h3>Edit Note</h3>
        <label for="title">Title:</label>
        <input type="text" name="title" value="{{ note[1] }}" required>
        <br>
        <label for="content">Content:</label>
        <textarea name="content" required>{{ note[2] }}</textarea>
        <br>
        <input type="submit" name="edit" value="Save Changes">
        <input type="submit" name="delete" value="Delete Note" onclick="return confirm('Are you sure you want to delete this note?');">
    </form>
    <a href="{{ url_for('dashboard') }}">Back to Dashboard</a>
</body>
</html>
