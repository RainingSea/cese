<!DOCTYPE html>
<html>
<head>
    <title>Dashboard</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <a class="navbar-brand" href="#">Note Taking App</a>
        <div class="ml-auto">
            <form class="form-inline" method="POST" action="{{ url_for('search') }}">
                <input class="form-control mr-sm-2" type="search" name="query" placeholder="Search notes">
                <button class="btn btn-outline-success my-2 my-sm-0" type="submit">Search</button>
            </form>
        </div>
        <div class="ml-3">
            <a href="{{ url_for('logout') }}" class="btn btn-danger">Logout</a>
        </div>
    </nav>
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Your Notes</h2>
            <a href="{{ url_for('add_note') }}" class="btn btn-primary">Add Note</a>
        </div>
        {% if notes %}
            <div class="list-group">
                {% for note_id, note in notes.items() %}
                    <a href="{{ url_for('view_note', note_id=note_id) }}" class="list-group-item list-group-item-action">
                        <div class="d-flex w-100 justify-content-between">
                            <h5 class="mb-1">{{ note['title'] }}</h5>
                            <small>{{ note['created_at'] }}</small>
                        </div>
                        <p class="mb-1">{{ note['content'][:100] }}{% if note['content']|length > 100 %}...{% endif %}</p>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="alert alert-info">You don't have any notes yet. Click "Add Note" to create one.</div>
        {% endif %}
    </div>
</body>
</html>

