</head>
<body>
    <h1>Recommended Destinations</h1>
    <nav>
        <a href="{{ url_for('preferences') }}">Update Preferences</a> |
        <a href="{{ url_for('logout') }}">Logout</a>
    </nav>
    {% if recommendations %}
        <ul>
            {% for rec in recommendations %}
                <li>
                    <h3>{{ rec.name }}</h3>
                    <p>Activities: {{ rec.activities }}</p>
                    <p>Climate: {{ rec.climate }}</p>
                    <p>Cost: ${{ rec.cost }}</p>
                    <a href="{{ url_for('details', name=rec.name) }}">View Details</a>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p>No recommendations found based on your preferences.</p>
    {% endif %}
