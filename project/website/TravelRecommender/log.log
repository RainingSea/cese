*** templates/preferences.html
```html
<!DOCTYPE html>
<html>
<head>
    <title>Preferences</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <h2 class="text-center mb-4">Travel Preferences</h2>
                <form method="POST">
                    <div class="mb-3">
                        <label for="budget" class="form-label">Budget ($)</label>
                        <input type="range" class="form-range" id="budget" name="budget" min="100" max="5000" step="100" value="1000">
                        <div class="text-center"><span id="budgetValue">1000</span> $</div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Activities</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="activities" value="hiking" id="hiking">
                            <label class="form-check-label" for="hiking">Hiking</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="activities" value="beach" id="beach">
                            <label class="form-check-label" for="beach">Beach</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="activities" value="city" id="city">
                            <label class="form-check-label" for="city">City Tour</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="activities" value="museum" id="museum">
                            <label class="form-check-label" for="museum">Museum</label>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="climate" class="form-label">Preferred Climate</label>
                        <select class="form-select" id="climate" name="climate">
                            <option value="tropical">Tropical</option>
                            <option value="temperate">Temperate</option>
                            <option value="arctic">Arctic</option>
                            <option value="desert">Desert</option>
                        </select>
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100">Save Preferences</button>
                </form>
            </div>
        </div>
    </div>
    
    <script>
        const budgetSlider = document.getElementById('budget');
        const budgetValue = document.getElementById('budgetValue');
        
        budgetSlider.addEventListener('input', function() {
            budgetValue.textContent = this.value;
        });
    </script>
</body>
</html>
```

*** templates/recommendations.html
```html
<!DOCTYPE html>
<html>
<head>
    <title>Recommendations</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Recommended Destinations</h2>
            <div>
                <a href="{{ url_for('favorites') }}" class="btn btn-outline-primary me-2">View Favorites</a>
                <a href="{{ url_for('logout') }}" class="btn btn-outline-danger">Logout</a>
            </div>
        </div>
        
        <div class="row">
            {% for rec in recommendations %}
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">{{ rec.name }}</h5>
                        <p class="card-text">
                            <strong>Climate:</strong> {{ rec.climate }}<br>
                            <strong>Cost:</strong> ${{ rec.cost }}<br>
                            <strong>Activities:</strong> {{ rec.activities|join(', ') }}
                        </p>
                        <a href="{{ url_for('add_favorite', destination=rec.name) }}" class="btn btn-primary">Save to Favorites</a>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="col-12">
                <div class="alert alert-info">No recommendations found. Try adjusting your preferences.</div>
            </div>
            {% endfor %}
        </div>
    </div>
</body>
</html>
```

*** templates/favorites.html
```html
<!DOCTYPE html>
<html>
<head>
    <title>Favorites</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Your Favorite Destinations</h2>
            <div>
                <a href="{{ url_for('recommendations') }}" class="btn btn-outline-primary me-2">Back to Recommendations</a>
                <a href="{{ url_for('logout') }}" class="btn btn-outline-danger">Logout</a>
            </div>
        </div>
        
        {% if favorites %}
        <ul class="list-group">
            {% for fav in favorites %}
            <li class="list-group-item d-flex justify-content-between align-items-center">
                {{ fav }}
                <a href="{{ url_for('remove_favorite', destination=fav) }}" class="btn btn-sm btn-outline-danger">Remove</a>
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <div class="alert alert-info">You haven't saved any favorites yet.</div>
        {% endif %}
    </div>
</body>
</html>
```

