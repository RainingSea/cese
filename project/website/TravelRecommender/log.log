                        <input type="range" class="form-range" id="budget" name="budget" min="100" max="5000" step="100" value="1000">
                        <div class="text-center"><span id="budgetValue">1000</span> $</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Activities</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="activities" value="hiking" id="hiking">
                            <label class="form-check-label" for="hiking">Hiking</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="activities" value="beach" id="beach">
                            <label class="form-check-label" for="beach">Beach</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="activities" value="city" id="city">
                            <label class="form-check-label" for="city">City Tour</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="activities" value="museum" id="museum">
                            <label class="form-check-label" for="museum">Museum</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="climate" class="form-label">Preferred Climate</label>
                        <select class="form-select" id="climate" name="climate">
                            <option value="tropical">Tropical</option>
                            <option value="temperate">Temperate</option>
                            <option value="arctic">Arctic</option>
                            <option value="desert">Desert</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Save Preferences</button>
                </form>
            </div>
        </div>
    </div>
    <script>
        const budgetSlider = document.getElementById('budget');
        const budgetValue = document.getElementById('budgetValue');
        budgetSlider.addEventListener('input', function() {
            budgetValue.textContent = this.value;
        });
    </script>
</body>
</html>
