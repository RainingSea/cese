            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">{{ rec.name }}</h5>
                        <p class="card-text">
                            <strong>Climate:</strong> {{ rec.climate }}<br>
                            <strong>Budget:</strong> ${{ rec.min_budget }} - ${{ rec.max_budget }}<br>
                            <strong>Activities:</strong> {{ rec.activities|join(', ') }}
                        </p>
                        <p>{{ rec.description }}</p>
                        <a href="{{ url_for('add_favorite', destination=rec.name) }}" class="btn btn-primary me-2">Save to Favorites</a>
                        <a href="{{ url_for('destination_details', name=rec.name) }}" class="btn btn-outline-secondary">Details</a>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="col-12">
                <div class="alert alert-info">No recommendations found. Try adjusting your preferences.</div>
            </div>
            {% endfor %}
        </div>
    </div>
</body>
</html>
```

