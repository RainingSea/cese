7. |Case|:**3_travel_recommendations**  
**Pseudocode:**  
```python
CLASS RecommendationEngine:
    METHOD __init__(dest_file='destinations.txt'):
        SET self.dest_file = dest_file

    METHOD _load_destinations():
        INIT destinations = []
        TRY:
            OPEN self.dest_file
            FOR EACH line IN file:
                SPLIT line BY '|' INTO parts
                IF parts HAS 7 elements:
                    APPEND TO destinations:
                        {
                            'id': parts[0],
                            'name': parts[1],
                            'activities': parts[2].split(','),
                            'climate': parts[3],
                            'min_budget': int(parts[4]),
                            'max_budget': int(parts[5]),
                            'description': parts[6]
                        }
        EXCEPT IOError:
            PASS
        RETURN destinations

    METHOD get_recommendations(prefs):
        CALL _load_destinations() ↙ destinations
        IF prefs IS EMPTY:
            RETURN destinations
        ELSE:
            EXTRACT budget, activities, climate FROM prefs
            FILTER destinations WHERE:
                min_budget ≒ budget ≒ max_budget AND
                (climate IS EMPTY OR dest.climate == climate) AND
                (activities IS EMPTY OR any activity IN dest.activities)
            RETURN filtered_destinations

ROUTE '/recommendations':
    IF NOT logged_in:
        REDIRECT TO login
    ELSE:
        CALL recommendation_engine.get_recommendations({}) ↙ recommendations
        RENDER recommendations.html WITH recommendations
```
