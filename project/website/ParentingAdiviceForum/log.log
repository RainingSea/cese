    <title>Forum</title>
    <link rel="stylesheet" href="/static/style.css">
</head>
<body>
    <header>
        <nav>
            <a href="{{ url_for('home') }}">Home</a>
            <a href="{{ url_for('forum') }}">Forum</a>
            <a href="{{ url_for('advice') }}">Advice</a>
            <a href="{{ url_for('account') }}">My Account</a>
            <a href="{{ url_for('contact') }}">Contact Us</a>
            <a href="{{ url_for('logout') }}">Logout</a>
        </nav>
    </header>
    <div class="container">
        <h1>Forum</h1>
        <a href="#" onclick="document.getElementById('newThreadForm').style.display='block'">New Thread</a>
        
        <div id="newThreadForm" style="display:none;">
            <form method="POST" action="{{ url_for('new_thread') }}">
                <label for="title">Title:</label>
                <input type="text" id="title" name="title" required>
                
                <label for="content">Content:</label>
                <textarea id="content" name="content" required></textarea>
                
                <button type="submit">Post Thread</button>
            </form>
        </div>
        
        <div class="thread-list">
            {% for thread in threads %}
            <div class="thread">
                <h3><a href="{{ url_for('view_thread', thread_id=thread.id) }}">{{ thread.title }}</a></h3>
                <p>Posted by {{ thread.author }} on {{ thread.timestamp }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</body>
</html>
