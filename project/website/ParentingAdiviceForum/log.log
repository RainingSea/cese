CLASS UserManager
    FUNCTION register(username, password)
        IF NOT any user.username == username
            users.append({'username': username, 'password': password})
            CALL save_users()
            RETURN TRUE
        ELSE
            RETURN FALSE
        ENDIF
    END FUNCTION

    FUNCTION save_users()
        OPEN 'users.txt' FOR writing
        FOR each user IN users
            WRITE user.username + '|' + user.password + '\n'
        END FOR
        CLOSE file
    END FUNCTION
END CLASS
