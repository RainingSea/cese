    FUNCTION create_thread(title, content)
        threads.append({'title': title, 'content': content, 'comments': []})
        CALL save_threads()
        RETURN TRUE
    END FUNCTION

    FUNCTION save_threads()
        OPEN 'threads.txt' FOR writing
        FOR each thread IN threads
            WRITE thread.title + '|' + thread.content + '\n'
        END FOR
        CLOSE file
    END FUNCTION
END CLASS
