           for line in f:
               parts = line.strip().split('|')
               threads.append({
                   'id': parts[0],
                   'title': parts[1],
                   'author': parts[3],
                   'timestamp': parts[4]
               })
       # Sort by timestamp (newest first)
       threads.sort(key=lambda x: x['timestamp'], reverse=True)
       return threads

