                <li><a href="{{ url_for('forum') }}">Forum</a></li>
                <li><a href="{{ url_for('post_advice') }}">Post Advice</a></li>
                <li><a href="{{ url_for('my_account') }}">My Account</a></li>
            {% endif %}
            <li><a href="{{ url_for('contact_us') }}">Contact Us</a></li>
        </ul>
    </nav>
</body>
</html>
```

