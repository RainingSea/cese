        self.save_advice()
        return True

    def get_advice(self) -> list:
        return self.advice_posts

    def save_advice(self):
        with open('advice.txt', 'w') as file:
            for advice in self.advice_posts:
                file.write(f"{advice['title']}|{advice['content']}\n")
