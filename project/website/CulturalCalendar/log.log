            RETURN LIST OF EVENT DICTS

ROUTE /dashboard:
    IF USER NOT IN session:
        REDIRECT TO /login
    FETCH EVENTS USING EventManager.get_events()
    RENDER dashboard.html WITH events
```

3. |Case|:**user_registration**
```
CLASS UserManager:
    FUNCTION __init__(users_file='users.txt'):
        IF users_file NOT EXISTS:
            CREATE users_file
        
    FUNCTION register(username, password):
        OPEN users_file IN READ MODE:
            IF username ALREADY EXISTS (format: "username|password"):
                RETURN False
        OPEN users_file IN APPEND MODE:
            WRITE "username|password"  
        RETURN True
```

4. |Case|:**view_event_details**
```
CLASS EventManager:
    FUNCTION get_event(event_id):
        READ events.txt LINE BY LINE:
            IF event['id'] == event_id:
                RETURN EVENT DICT

ROUTE /event/<event_id>:
    IF USER NOT IN session:
        REDIRECT TO /login
    FETCH EVENT USING EventManager.get_event(event_id)
    RENDER event.html WITH event
```

5. |Case|:**set_reminder**
```
CLASS ReminderManager:
    FUNCTION add_reminder(user, event_id):
        APPEND "user|event_id" TO reminders.txt

ROUTE /add_reminder/<event_id>:
    IF USER NOT IN session:
        REDIRECT TO /login
    CALL ReminderManager.add_reminder(session['username'], event_id)
    REDIRECT TO /reminders
```

6. |Case|:**manage_reminders**
```
CLASS ReminderManager:
    FUNCTION get_reminders(user):
        READ reminders.txt LINE BY LINE:
            IF line.split("|")[0] == user:
                COLLECT event_ids
        RETURN LIST OF EVENT IDS

    FUNCTION delete_reminder(user, event_id):
        REWRITE reminders.txt EXCLUDING LINES MATCHING "user|event_id"

ROUTE /reminders:
    IF USER NOT IN session:
        REDIRECT TO /login
    FETCH REMINDERS FOR USER
    RENDER reminders.html WITH events

ROUTE /delete_reminder/<event_id>:
    CALL ReminderManager.delete_reminder(session['username'], event_id)
    REDIRECT TO /reminders
```

