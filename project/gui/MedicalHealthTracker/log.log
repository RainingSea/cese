            messagebox.showinfo("Info", "Stress logged successfully!")
            self.stress_entry.delete(0, tk.END)

    def visualize_trends(self):
        self.health_tracker.visualize_trends()

def main():
    root = tk.Tk()
    app = Main(root)
    root.mainloop()

if __name__ == "__main__":
    main()
