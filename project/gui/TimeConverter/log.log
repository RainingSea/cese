        self.target_timezone_entry = tk.Entry(self.root)
        self.target_timezone_entry.grid(row=2, column=1)

        tk.Label(self.root, text="Time Format:").grid(row=3, column=0)
        self.time_format_entry = tk.Entry(self.root)
