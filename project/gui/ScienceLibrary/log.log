   ```plaintext
   CLASS ArticleManager:
       FUNCTION __init__():
           // Load favorites from file
           favorites = load_favorites()

       FUNCTION load_favorites():
           OPEN 'favorites.json' AS file:
               RETURN json.load(file)
           
       FUNCTION save_favorite(article_id: str):
           // Append article_id to favorites
           favorites.APPEND(article_id)
           // Store updated favorites back to file
           CALL save_to_file('favorites.json', favorites)

       FUNCTION save_to_file(filename: str, data):
           OPEN filename IN write mode AS file:
               json.dump(data, file, indent=4)
   ```

