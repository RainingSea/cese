*** favorites_manager.py
```python
import json

class FavoritesManager:
    def __init__(self):
        self.favorites = []

    def load_favorites(self):
        try:
            with open('favorites.json', 'r') as file:
                self.favorites = json.load(file)
        except FileNotFoundError:
            self.favorites = []

    def add_favorite(self, article: str):
        if article not in self.favorites:
            self.favorites.append(article)
            self.save_favorites()

    def save_favorites(self):
        with open('favorites.json', 'w') as file:
            json.dump(self.favorites, file, indent=4)
```

*** annotations_manager.py
```python
import json

class AnnotationsManager:
    def __init__(self):
        self.annotations = {}

    def load_annotations(self):
        try:
            with open('annotations.json', 'r') as file:
                self.annotations = json.load(file)
        except FileNotFoundError:
            self.annotations = {}

    def add_annotation(self, article: str, note: str):
        if article in self.annotations:
            self.annotations[article].append(note)
        else:
            self.annotations[article] = [note]
        self.save_annotations()

    def save_annotations(self):
        with open('annotations.json', 'w') as file:
            json.dump(self.annotations, file, indent=4)
```

