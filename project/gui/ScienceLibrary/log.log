CLASS SearchEngine
    FUNCTION __init__()
        LOAD articles from 'articles.txt' into self.articles

    FUNCTION load_articles() RETURNS LIST
        OPEN 'articles.txt' AS file
        RETURN TRIM each line in file.readlines()

    FUNCTION search(query: STRING) RETURNS LIST
        RETURN [article FOR article IN self.articles IF query.lower() IN article.lower()]
