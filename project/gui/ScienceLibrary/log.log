class ArticleManager:
    def __init__(self):
        self.articles = []

    def load_articles(self):
        try:
            with open('articles.txt', 'r') as file:
                self.articles = [line.strip() for line in file.readlines()]
        except FileNotFoundError:
            self.articles = []

    def search(self, query: str):
        return [article for article in self.articles if query.lower() in article.lower()]
```

*** favorites_manager.py
```python
class FavoritesManager:
    def __init__(self):
        self.favorites = []

    def load_favorites(self):
        try:
            with open('favorites.txt', 'r') as file:
                self.favorites = [line.strip() for line in file.readlines()]
        except FileNotFoundError:
            self.favorites = []

    def add_favorite(self, article: str):
        if article not in self.favorites:
            self.favorites.append(article)
            self.save_favorites()

    def save_favorites(self):
        with open('favorites.txt', 'w') as file:
            for favorite in self.favorites:
                file.write(f"{favorite}\n")
```

*** annotations_manager.py
```python
class AnnotationsManager:
    def __init__(self):
        self.annotations = {}

    def load_annotations(self):
        try:
            with open('annotations.txt', 'r') as file:
                for line in file:
                    article, note = line.strip().split('|')
                    if article in self.annotations:
                        self.annotations[article].append(note)
                    else:
                        self.annotations[article] = [note]
        except FileNotFoundError:
            self.annotations = {}

    def add_annotation(self, article: str, note: str):
        if article in self.annotations:
            self.annotations[article].append(note)
        else:
            self.annotations[article] = [note]
        self.save_annotations()

    def save_annotations(self):
        with open('annotations.txt', 'w') as file:
            for article, notes in self.annotations.items():
                for note in notes:
                    file.write(f"{article}|{note}\n")
```

