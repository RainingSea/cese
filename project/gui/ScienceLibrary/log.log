CLASS FavoritesManager
    FUNCTION __init__()
        LOAD favorites from 'favorites.txt' into self.favorites

    FUNCTION save_favorite(article: STRING)
        APPEND article to self.favorites
        OPEN 'favorites.txt' FOR appending
            WRITE article + "\n" to the file

    FUNCTION load_favorites() RETURNS LIST
        TRY
            OPEN 'favorites.txt' AS file
            INITIALIZE self.favorites
            self.favorites = TRIM each line in file.readlines()
        CATCH FileNotFoundError
            INITIALIZE self.favorites as empty list
        RETURN self.favorites
```

