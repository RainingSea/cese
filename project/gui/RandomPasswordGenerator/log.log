CLASS PasswordGenerator:
    FUNCTION generate_password():
        IF length < 1 THEN
            RAISE ValueError("Password length must be at least 1.")
        
        DEFINE character_pool AS ""
        IF include_uppercase THEN
            ADD "ABCDEFGHIJKLMNOPQRSTUVWXYZ" TO character_pool
        IF include_lowercase THEN
            ADD "abcdefghijklmnopqrstuvwxyz" TO character_pool
        IF include_numbers THEN
            ADD "0123456789" TO character_pool
        IF include_symbols THEN
            ADD "!@#$%^&*()-_=+[]{}|;:,.<>?/" TO character_pool
        
        IF NOT character_pool THEN
            RAISE ValueError("No character types selected for password generation.")
        
        password = generate_random_password(character_pool, length)
        save_generated_password(password)
        RETURN password
