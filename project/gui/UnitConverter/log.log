   ```pseudocode
   CLASS UnitConverter
       FUNCTION load_conversion_rates(file_path)
           IF not exists(file_path)
               RAISE FileNotFoundError
           ENDIF
           OPEN file_path AS file
               FOR each line IN file
                   SPLIT line BY '|'
                   FROM_UNIT = data[0] 
                   TO_UNIT = data[1]
                   RATE = data[2]
                   ADD (FROM_UNIT, TO_UNIT): RATE TO conversion_rates DICTIONARY
               END FOR
           CLOSE file
       END FUNCTION

       FUNCTION convert(value, from_unit, to_unit)
           IF (from_unit, to_unit) NOT IN conversion_rates
               RAISE ValueError
           ENDIF
           RETURN value * conversion_rates[(from_unit, to_unit)]
       END FUNCTION
   END CLASS
   ```

