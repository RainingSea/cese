1. |Case|:**categorize_shopping_items**
```plaintext
CLASS Item:
    FUNCTION __init__(name: str, category: str):
        SET self.name to name
        SET self.category to category

CLASS ShoppingList:
    FUNCTION __init__():
        SET self.items to []

    FUNCTION add_item(item: str, category: str):
        CREATE new_item as Item(item, category)
        ADD new_item to self.items

CLASS Main:
    FUNCTION setup_ui():
        CREATE GUI components:
            item_entry as tk.Entry
            category_entry as tk.Entry
            add_button as tk.Button (command=self.add_item)

    FUNCTION add_item():
        SET item_name to item_entry.get()
        SET category_name to category_entry.get()
        IF item_name AND category_name are not empty:
            CALL current_list.add_item(item_name, category_name)
            INSERT f"{item_name} ({category_name})" into listbox
            CLEAR item_entry
            CLEAR category_entry
        ELSE:
            SHOW warning("Input Error")

IMPORT tkinter AS tk
...
IF __name__ == "__main__":
    CREATE root as tk.Tk()
    CREATE app as Main(root)
    CALL app.main()
```

2. |Case|:**add_items_manually_to_shopping_list**
```plaintext
CLASS ShoppingList:
    FUNCTION add_item(item AS string, category AS string):
        APPEND (item, category) TO items
        IF category NOT IN categories:
            APPEND category TO categories
```

3. |Case|:**import_items_from_previous_shopping_lists**
```plaintext
CLASS ShoppingList:
    FUNCTION load_previous_lists() -> List[Item]:
        INITIALIZE previous_items to []
        TRY:
            OPEN 'previous_lists.txt' FOR reading AS file:
                FOR EACH line IN file:
                    SPLIT line into name and category
                    ADD Item(name, category) to previous_items
        EXCEPT FileNotFoundError:
            SHOW error("Previous lists file not found.")
        RETURN previous_items

CLASS Main:
    FUNCTION import_previous_list():
        CALL previous_items = current_list.load_previous_lists()
        FOR EACH item IN previous_items:
            CALL current_list.add_item(item.name, item.category)
            INSERT f"{item.name} ({item.category})" into listbox
```

