        SET self.items to []

    FUNCTION add_item(item: str, category: str):
        CREATE new_item as Item(item, category)
        ADD new_item to self.items

CLASS Main:
    FUNCTION setup_ui():
        CREATE GUI components:
            item_entry as tk.Entry
            category_entry as tk.Entry
            add_button as tk.Button (command=self.add_item)

    FUNCTION add_item():
        SET item_name to item_entry.get()
        SET category_name to category_entry.get()
        IF item_name AND category_name are not empty:
            CALL current_list.add_item(item_name, category_name)
            INSERT f"{item_name} ({category_name})" into listbox
            CLEAR item_entry
            CLEAR category_entry
        ELSE:
            SHOW warning("Input Error")

IMPORT tkinter AS tk
...
IF __name__ == "__main__":
