CLASS Investment:
    FUNCTION __init__(name, amount, type):
        SET self.name = name
        SET self.amount = amount
        SET self.type = type

CLASS InvestmentTracker:
    FUNCTION add_investment(investment):
        APPEND investment to self.investments
        CALL save_investments()

    FUNCTION save_investments():
        OPEN 'investments.txt' FOR WRITING AS file
        FOR each investment IN self.investments:
            WRITE investment.name + '|' + investment.amount + '|' + investment.type + '\n'
        CLOSE file

FUNCTION main():
    CREATE InvestmentTracker instance
    CREATE Investment with name="Test Investment", amount=1000, type="Stock"
    CALL tracker.add_investment(investment)
