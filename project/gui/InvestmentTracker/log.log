```
CLASS Portfolio:
    FUNCTION __init__(name):
        SET self.name = name
        SET self.investments = []

CLASS InvestmentTracker:
    FUNCTION categorize_investment(investment, portfolio):
        APPEND investment to portfolio.investments
        CALL save_portfolios()

    FUNCTION save_portfolios():
        OPEN 'portfolios.txt' FOR WRITING AS file
        FOR each portfolio IN self.portfolios:
            WRITE portfolio.name + '\n'
        CLOSE file

FUNCTION main():
    CREATE Portfolio with name="Growth"
    APPEND portfolio to tracker.portfolios
    CREATE Investment with name="Investment A", amount=1000, type="Stock"
    CALL tracker.categorize_investment(investment, portfolio)
