            CALL save_investment with 'mutual_funds.txt'
        ELSE IF type is 'other_asset'
            APPEND investment to other assets list
            CALL save_investment with 'other_assets.txt'
        ENDIF

    FUNCTION save_investment(filename, investment)
        OPEN the file specified by filename in append mode
        WRITE investment details to the file
        CLOSE the file
END CLASS
```

