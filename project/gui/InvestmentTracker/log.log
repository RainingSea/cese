    INIT constructs an empty list for stocks, bonds, mutual funds and other assets
    LOAD_DATA
        LOAD investments from 'stocks.txt', 'bonds.txt', 'mutual_funds.txt', 'other_assets.txt'

    FUNCTION input_investment(type, amount, category)
        CREATE investment record with current date
        IF type is 'stock'
            APPEND investment to stocks list
            CALL save_investment with 'stocks.txt'
        ELSE IF type is 'bond'
            APPEND investment to bonds list
            CALL save_investment with 'bonds.txt'
        ELSE IF type is 'mutual_fund'
            APPEND investment to mutual funds list
            CALL save_investment with 'mutual_funds.txt'
        ELSE IF type is 'other_asset'
            APPEND investment to other assets list
            CALL save_investment with 'other_assets.txt'
        ENDIF

    FUNCTION save_investment(filename, investment)
        OPEN the file specified by filename in append mode
        WRITE investment details to the file
        CLOSE the file
END CLASS
```

