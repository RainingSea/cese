class BirthdateManager:
    def __init__(self):
        self.valid_birthdates: List[str] = []
        self.invalid_birthdates: List[str] = []

    def add_birthdate(self, birthdate: str) -> bool:
        if self.validate_birthdate_format(birthdate):
            self.valid_birthdates.append(birthdate)
            self.save_birthdates()
            return True
        else:
            self.log_invalid_birthdate(birthdate)
            return False

    def calculate_age(self, birthdate: str) -> str:
        birthdate_obj = datetime.strptime(birthdate, "%Y-%m-%d")
        today = datetime.today()
        years = today.year - birthdate_obj.year
        months = today.month - birthdate_obj.month
        days = today.day - birthdate_obj.day

        if days < 0:
            months -= 1
            days += (birthdate_obj.replace(month=birthdate_obj.month % 12 + 1, day=1) - birthdate_obj.replace(month=birthdate_obj.month, day=1)).days

        if months < 0:
            years -= 1
            months += 12

        return f"{years} years, {months} months, {days} days"

    def days_until_next_birthday(self, birthdate: str) -> int:
        birthdate_obj = datetime.strptime(birthdate, "%Y-%m-%d")
        today = datetime.today()
        next_birthday = birthdate_obj.replace(year=today.year)

        if next_birthday < today:
            next_birthday = next_birthday.replace(year=today.year + 1)

        return (next_birthday - today).days

