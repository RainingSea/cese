```python
from datetime import datetime, timedelta

class BirthdateManager:
    def __init__(self):
        self.birthdates = []

    def add_birthdate(self, birthdate: str) -> None:
        self.birthdates.append(birthdate)
        self.save_birthdates()

    def calculate_age(self, birthdate: str) -> str:
        birthdate = datetime.strptime(birthdate, "%Y-%m-%d")
        today = datetime.today()
        age_years = today.year - birthdate.year
        age_months = today.month - birthdate.month
        age_days = today.day - birthdate.day

        if age_days < 0:
            age_months -= 1
            age_days += (birthdate.replace(year=today.year, month=today.month) - timedelta(days=1)).day

        if age_months < 0:
            age_years -= 1
            age_months += 12

        return f"{age_years} years, {age_months} months, {age_days} days"

    def days_until_next_birthday(self, birthdate: str) -> int:
        birthdate = datetime.strptime(birthdate, "%Y-%m-%d")
        today = datetime.today()
        next_birthday = birthdate.replace(year=today.year)

        if next_birthday < today:
            next_birthday = next_birthday.replace(year=today.year + 1)

        return (next_birthday - today).days

    def load_birthdates(self) -> None:
        if os.path.exists("birthdates.txt"):
            with open("birthdates.txt", "r") as file:
                self.birthdates = [line.strip() for line in file.readlines()]

    def save_birthdates(self) -> None:
        with open("birthdates.txt", "w") as file:
            for birthdate in self.birthdates:
                file.write(birthdate + "\n")

    def validate_birthdate(self, birthdate: str) -> bool:
        try:
            datetime.strptime(birthdate, "%Y-%m-%d")
            return True
        except ValueError:
            return False
```

