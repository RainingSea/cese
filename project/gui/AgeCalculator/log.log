```python
import tkinter as tk
from tkinter import messagebox
from datetime import datetime, timedelta
import os

class Main:
    def __init__(self, master):
        self.master = master
        self.master.title("Age Calculator")
        
        self.birthdate_manager = BirthdateManager()
        self.birthdate_manager.load_birthdates()

        self.label = tk.Label(master, text="Enter your birthdate (YYYY-MM-DD):")
        self.label.pack()

        self.entry = tk.Entry(master)
        self.entry.pack()

        self.submit_button = tk.Button(master, text="Calculate Age", command=self.calculate_age)
        self.submit_button.pack()

        self.clear_button = tk.Button(master, text="Clear", command=self.clear_fields)
        self.clear_button.pack()

        self.age_label = tk.Label(master, text="")
        self.age_label.pack()

        self.days_label = tk.Label(master, text="")
        self.days_label.pack()

    def calculate_age(self):
        birthdate = self.entry.get()
        try:
            self.birthdate_manager.add_birthdate(birthdate)
            age = self.birthdate_manager.calculate_age(birthdate)
            days_until_birthday = self.birthdate_manager.days_until_next_birthday(birthdate)

            self.age_label.config(text=f"Age: {age}")
            self.days_label.config(text=f"Days until next birthday: {days_until_birthday}")
        except ValueError as e:
            messagebox.showerror("Input Error", str(e))

    def clear_fields(self):
        self.entry.delete(0, tk.END)
        self.age_label.config(text="")
        self.days_label.config(text="")

class BirthdateManager:
    def __init__(self):
        self.birthdates = []
        self.filename = 'birthdates.txt'

    def add_birthdate(self, birthdate: str):
        if self.validate_birthdate(birthdate):
            self.birthdates.append(birthdate)
            self.save_birthdates()
        else:
            raise ValueError("Invalid birthdate format. Please use YYYY-MM-DD.")

    def calculate_age(self, birthdate: str) -> str:
        birthdate_obj = datetime.strptime(birthdate, "%Y-%m-%d")
        today = datetime.today()
        age_years = today.year - birthdate_obj.year
        age_months = today.month - birthdate_obj.month
        age_days = today.day - birthdate_obj.day

        if age_days < 0:
            age_months -= 1
            age_days += (birthdate_obj.replace(year=today.year, month=today.month) - timedelta(days=1)).day

        if age_months < 0:
            age_years -= 1
            age_months += 12

        return f"{age_years} years, {age_months} months, {age_days} days"

    def days_until_next_birthday(self, birthdate: str) -> int:
        birthdate_obj = datetime.strptime(birthdate, "%Y-%m-%d")
        today = datetime.today()
        next_birthday = birthdate_obj.replace(year=today.year)

        if next_birthday < today:
            next_birthday = next_birthday.replace(year=today.year + 1)

        return (next_birthday - today).days

    def load_birthdates(self):
        if os.path.exists(self.filename):
            with open(self.filename, 'r') as file:
                self.birthdates = [line.strip() for line in file.readlines()]

    def save_birthdates(self):
        with open(self.filename, 'w') as file:
            for birthdate in self.birthdates:
                file.write(f"{birthdate}\n")

    @staticmethod
    def validate_birthdate(birthdate: str) -> bool:
        try:
            datetime.strptime(birthdate, "%Y-%m-%d")
            return True
        except ValueError:
            return False

def main():
    root = tk.Tk()
    app = Main(root)
    root.mainloop()

if __name__ == "__main__":
    main()
