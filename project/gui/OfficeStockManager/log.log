   **Pseudocode**:
   ```
   CLASS InventoryManager:
       FUNCTION update_item(self, name: str, quantity: int) -> None:
           FOR item IN self.items:
               IF item[0] == name:
                   SET item[2] = str(quantity)
                   BREAK
           self.save_inventory(self.items)

   # In main.py during button click
   FUNCTION update_item(self):
       GET selected_item = self.inventory_listbox.curselection()
       IF selected_item:
           GET item_details = self.inventory_listbox.get(selected_item).split(':')
           GET name = item_details[0].split('(')[0].strip()
           GET quantity = self.quantity_entry.get()
           IF quantity.isdigit():
               self.inventory_manager.update_item(name, int(quantity))
               self.populate_inventory()
               self.clear_entries()
           ELSE:
               SHOW error message
       ELSE:
           SHOW selection error message
   ```

