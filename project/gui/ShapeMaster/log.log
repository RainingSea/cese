```python
import tkinter as tk
from tkinter import colorchooser, filedialog
import json

class Shape:
    def __init__(self, shape_id, shape_type, attributes):
        self.id = shape_id
        self.type = shape_type
        self.attributes = attributes

    def draw(self, canvas):
        if self.type == 'rectangle':
            canvas.create_rectangle(self.attributes['x'], self.attributes['y'],
                                    self.attributes['x'] + self.attributes['width'],
                                    self.attributes['y'] + self.attributes['height'],
                                    fill=self.attributes['color'])
        elif self.type == 'circle':
            canvas.create_oval(self.attributes['x'], self.attributes['y'],
                               self.attributes['x'] + self.attributes['radius'] * 2,
                               self.attributes['y'] + self.attributes['radius'] * 2,
                               fill=self.attributes['color'])
        elif self.type == 'triangle':
            x1, y1 = self.attributes['x'], self.attributes['y']
            x2, y2 = x1 + self.attributes['base'], y1
            x3, y3 = x1 + self.attributes['base'] / 2, y1 - self.attributes['height']
            canvas.create_polygon(x1, y1, x2, y2, x3, y3, fill=self.attributes['color'])
        elif self.type == 'polygon':
            canvas.create_polygon(self.attributes['points'], fill=self.attributes['color'])

    def resize(self, new_size):
        if self.type == 'rectangle':
            self.attributes['width'], self.attributes['height'] = new_size
        elif self.type == 'circle':
            self.attributes['radius'] = new_size[0]
        elif self.type == 'triangle':
            self.attributes['base'], self.attributes['height'] = new_size
        # For polygon, resizing logic can be complex and is not implemented here.

    def reposition(self, new_position):
        self.attributes['x'], self.attributes['y'] = new_position

    def apply_style(self, style):
        self.attributes['color'] = style['color']

class ShapeManager:
    def __init__(self):
        self.shapes = []

    def create_shape(self, shape_type, attributes):
        shape_id = len(self.shapes) + 1
        new_shape = Shape(shape_id, shape_type, attributes)
        self.shapes.append(new_shape)
        return new_shape

    def edit_shape(self, shape_id, attributes):
        shape = next((s for s in self.shapes if s.id == shape_id), None)
        if shape:
            shape.attributes.update(attributes)

    def group_shapes(self, ids):
        # Grouping logic can be implemented here.
        pass

    def align_shapes(self, alignment_type):
        # Alignment logic can be implemented here.
        pass

    def save_shapes(self):
        with open('shapes.txt', 'w') as f:
            for shape in self.shapes:
                f.write(f"{shape.id}|{shape.type}|{json.dumps(shape.attributes)}\n")

    def load_shapes(self):
        try:
            with open('shapes.txt', 'r') as f:
                for line in f:
                    shape_id, shape_type, attributes = line.strip().split('|')
                    self.shapes.append(Shape(int(shape_id), shape_type, json.loads(attributes)))
        except FileNotFoundError:
            print("Shapes file not found. Starting with an empty shape list.")

class Main:
    def __init__(self):
        self.root = tk.Tk()
        self.shape_manager = ShapeManager()
        self.canvas = tk.Canvas(self.root, width=800, height=600)
        self.canvas.pack()
        self.create_ui()

    def create_ui(self):
        # UI elements for creating shapes
        tk.Button(self.root, text="Add Rectangle", command=self.add_rectangle).pack()
        tk.Button(self.root, text="Add Circle", command=self.add_circle).pack()
        tk.Button(self.root, text="Add Triangle", command=self.add_triangle).pack()
        tk.Button(self.root, text="Save Shapes", command=self.shape_manager.save_shapes).pack()
        tk.Button(self.root, text="Load Shapes", command=self.shape_manager.load_shapes).pack()

    def add_rectangle(self):
        attributes = {'x': 50, 'y': 50, 'width': 100, 'height': 50, 'color': 'blue'}
        shape = self.shape_manager.create_shape('rectangle', attributes)
        shape.draw(self.canvas)

    def add_circle(self):
        attributes = {'x': 200, 'y': 200, 'radius': 50, 'color': 'red'}
        shape = self.shape_manager.create_shape('circle', attributes)
        shape.draw(self.canvas)

    def add_triangle(self):
        attributes = {'x': 300, 'y': 300, 'base': 100, 'height': 80, 'color': 'green'}
        shape = self.shape_manager.create_shape('triangle', attributes)
        shape.draw(self.canvas)

    def main(self):
        self.shape_manager.load_shapes()
        self.root.mainloop()

if __name__ == "__main__":
    app = Main()
    app.main()
```

