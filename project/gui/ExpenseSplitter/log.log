   ```python
   class Expense:
       def __init__(self, total: float, names: list):
           self.total = total
           self.names = names

       def get_shares(self):
           IF NOT self.names:
               RETURN {}

           share = self.total / LENGTH(self.names)
           RETURN {name: share FOR name IN self.names}

   class ExpenseManager:
       def calculate_shares(self):
           shares = {}
           FOR expense IN self.expenses:
