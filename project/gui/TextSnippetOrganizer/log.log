    def clear_entries(self):
        self.tag_entry.delete(0, tk.END)
        self.text_area.delete("1.0", tk.END)
        self.description_entry.delete(0, tk.END)

def main():
    root = tk.Tk()
    app = Main(root)
    root.mainloop()

