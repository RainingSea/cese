```
CLASS ImageProcessor
    FUNCTION __init__()
        Set self.image to None

    FUNCTION load_image(file_path: str)
        OPEN image using PIL.Image with file_path
        ASSIGN opened image to self.image

CLASS Main
    FUNCTION load_image()
        SHOW file dialog for user to choose an image
        IF file_path is selected THEN
            SET last_directory to the directory of the file_path
            CALL save_config to save last_directory
            CALL image_processor.load_image(file_path) to load the image
            CALL display_image to display the loaded image

FUNCTION main()
    CREATE Main instance
    START mainloop for tkinter
```
