       FUNCTION calculate_square_root(a: float) -> float
          IF a < 0 THEN
             CALL messagebox.showerror("Error", "Cannot calculate square root of a negative number.")
             RETURN None
          ENDIF
          SET self.result = a ** 0.5
          CALL log_calculation("Square Root", self.result)
          RETURN self.result
   ```

