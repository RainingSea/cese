             ASSIGN chapter TO self.chapter
             ASSIGN content TO self.content
         END FUNCTION
     END CLASS

     CLASS NoteManager
         PROPERTY notes: list of Note
         FUNCTION INIT()
             SET self.notes TO empty list
             CALL load_notes()
         END FUNCTION

         FUNCTION add_note(chapter: string, content: string)
             CREATE new_note from Note with chapter, content
             APPEND new_note to self.notes
             CALL save_notes()
         END FUNCTION

         FUNCTION load_notes()
             TRY TO open 'notes.txt' for reading
                 FOR EACH line in file
                     SPLIT line by '|'
                     CREATE Note with chapter, content
                     APPEND the new Note to self.notes
                 END FOR
             CATCH FileNotFoundError
                 DO NOTHING
             END TRY
         END FUNCTION

         FUNCTION save_notes()
