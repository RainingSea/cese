```python
class BookManager:
    def __init__(self):
        self.books = self.load_books()

    def add_book(self, title: str, author: str, pub_date: str):
        with open("books.txt", "a") as file:
            file.write(f"{title}|{author}|{pub_date}\n")
        self.books.append((title, author, pub_date))

    def load_books(self) -> list:
        books = []
        try:
            with open("books.txt", "r") as file:
                for line in file:
                    title, author, pub_date = line.strip().split("|")
                    books.append((title, author, pub_date))
        except FileNotFoundError:
            pass
        return books
```

