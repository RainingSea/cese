CLASS SearchEngine
    FUNCTION search_notes(query: string, note_manager: NoteManager) RETURNS list of Note
        RETURN [note FOR EACH note IN note_manager.notes IF (query.lower() IN note.content.lower())]
    END FUNCTION
END CLASS
