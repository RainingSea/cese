FUNCTION load_vaults()
    IF directory 'vaults' does NOT exist
        CREATE directory 'vaults'
    ENDIF
    FOR each filename in 'vaults' directory DO
        IF filename ends with '.txt'
            SET vault_name to filename without '.txt'
            ADD vault_name to vaults dictionary as Vault object
        ENDIF
    ENDFOR

FUNCTION create_vault(name: String)
