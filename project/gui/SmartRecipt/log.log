        except ValueError:
            messagebox.showerror("Input Error", "Total amount must be a number.")
            return

        self.search_engine.add_receipt(date, merchant, total_amount)
        self.clear_entries()
        messagebox.showinfo("Success", "Receipt added successfully.")

