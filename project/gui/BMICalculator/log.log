    FUNCTION classify_bmi() -> str
        bmi = calculate_bmi()  // Calls calculate_bmi()
        IF bmi < 18.5
            RETURN "Underweight"
        ELSEIF 18.5 <= bmi < 24.9
            RETURN "Normal weight"
        ELSEIF 25 <= bmi < 29.9
            RETURN "Overweight"
        ELSE
            RETURN "Obese"

// Usage: 
classification = bmi_calculator.classify_bmi()  // Gets BMI classification
```

