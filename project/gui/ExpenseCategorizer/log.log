or summary\n        CALL self.root.mainloop()\n\n    FUNCTION add_expense():\n        TRY:\n            amount = CONVERT self.amount_entry.get() TO FLOAT\n            description = GET self.description_entry.get()\n            category = GET self.category_entry.get()\n            CALL self.expense_manager.add_expense(amount, description, category)\n            SHOW info message "Expense added successfully."\n        CATCH ValueError:\n            SHOW error message "Invalid amount entered."\n\n    FUNCTION show_summary():\n        summary = CALL self.expense_manager.get_summary()\n        CLEAR self.summary_display\n        INSERT summary into self.summary_display\n```\n|Case|:**add_expense_valid**\n```pseudocode\nCLASS Expense\n    FUNCTION __init__(amount: float, description: str, category: str)\n        SET self.amount = amount\n        SET self.description = description\n        SET self.category = category\n    END FUNCTION\nEND CLASS\n\nCLASS ExpenseCategorizer\n    FUNCTION __init__()\n        SET self.expenses = empty List\n        SET self.categories = CALL load_categories()\n    END FUNCTION\n\n    FUNCTION add_expense(amount: float, description: str, category: str)\n        CREATE expense = Expense(amount, description, category)\n        APPEND expense to self.expenses\n        CALL save_expenses()\n    END FUNCTION\n\n    FUNCTION save_expenses()\n        OPEN \'expenses.txt\' in write mode AS file\n            FOR each expense IN self.expenses\n                WRITE expense.amount, expense.description, expense.category TO file\n            END FOR\n        CLOSE file\n    END FUNCTION\n\n    FUNCTION load_categories() RETURNS List[str]\n        IF \'categories.txt\' exists THEN\n            OPEN \'categories.txt\' in read mode AS file\n                RETURN list of lines read from file\n            CLOSE file\n        END IF\n        RETURN empty List\n    END FUNCTION\nEND CLASS\n```\n', "|Case|:**create_custom_category**\n```pseudocode\nCLASS Expense