        self.quantity_entry.delete(0, tk.END)
        self.condition_entry.delete(0, tk.END)
        self.location_entry.delete(0, tk.END)

if __name__ == "__main__":
    root = tk.Tk()
    app = InventoryApp(root)
    root.mainloop()
