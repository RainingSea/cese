Example implementation:
```python
class Inventory:
    # Existing methods...
    
    def load_alerts(self):
        alerts = {}
        if os.path.exists('alerts.txt'):
            with open('alerts.txt', 'r') as file:
                for line in file:
                    equipment_name, alert_message = line.strip().split('|')
                    alerts[equipment_name.strip()] = alert_message.strip()
        return alerts
    
    def check_alerts(self):
        alerts = self.load_alerts()
        for equipment in self.equipment_list:
            if equipment.name in alerts:
                print(f"Alert for {equipment.name}: {alerts[equipment.name]}")
```

