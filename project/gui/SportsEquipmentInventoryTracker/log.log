#### Corresponding Project Code in Pseudocode Format:

**Main Classes**:
```plaintext
CLASS Equipment
    FUNCTION __init__(name: str, quantity: int, condition: str, location: str)
        SET self.name = name
        SET self.quantity = quantity
        SET self.condition = condition
        SET self.location = location
    END FUNCTION
END CLASS

CLASS Alert
    FUNCTION __init__(name: str, alert_type: str)
        SET self.name = name
        SET self.alert_type = alert_type
    END FUNCTION
END CLASS

CLASS InventoryManager
    FUNCTION __init__()
        CALL load_equipment()
        CALL load_alerts()
    END FUNCTION

    FUNCTION load_equipment() -> list
        TRY
            OPEN 'equipment_data.json' AS file FOR READING
                SET data = JSON.PARSE(file)
                RETURN [CREATE Equipment from item FOR EACH item IN data]
            END OPEN
        EXCEPTION FileNotFoundError
            RETURN []  // Return empty list if file not found
    END FUNCTION

    FUNCTION load_alerts() -> list
        TRY
            OPEN 'alerts.json' AS file FOR READING
                SET data = JSON.PARSE(file)
                RETURN [CREATE Alert from item FOR EACH item IN data]
            END OPEN
        EXCEPTION FileNotFoundError
            RETURN []  // Return empty list if file not found
    END FUNCTION

    FUNCTION add_equipment(name: str, quantity: int, condition: str, location: str)
        CREATE new_equipment = Equipment(name, quantity, condition, location)
        APPEND new_equipment TO self.equipment
        CALL save_equipment()
    END FUNCTION

    FUNCTION update_equipment(name: str, quantity: int, condition: str, location: str)
        FOR EACH item IN self.equipment
            IF item.name == name
                SET item.quantity = quantity
                SET item.condition = condition
                SET item.location = location
                CALL save_equipment()
                RETURN
            END IF
        END FOR
        CALL messagebox.showerror("Error", "Equipment not found.")
    END FUNCTION

    FUNCTION get_equipment() -> list
        RETURN self.equipment
    END FUNCTION

    FUNCTION set_alert(name: str, alert_type: str)
        CREATE new_alert = Alert(name, alert_type)
        APPEND new_alert TO self.alerts
        CALL save_alerts()
    END FUNCTION

    FUNCTION get_alerts() -> list
        RETURN self.alerts
    END FUNCTION

    FUNCTION save_equipment()
        OPEN 'equipment_data.json' FOR WRITING AS file
            WRITE JSON.DUMP([GET VARS(item) FOR EACH item IN self.equipment], file)
        END OPEN
    END FUNCTION

    FUNCTION save_alerts()
        OPEN 'alerts.json' FOR WRITING AS file
            WRITE JSON.DUMP([GET VARS(item) FOR EACH item IN self.alerts], file)
        END OPEN
    END FUNCTION
END CLASS

CLASS Main
    FUNCTION __init__()
        CREATE inventory_manager = InventoryManager()
        CREATE GUI_WINDOW = tk.Tk()
        SET GUI_WINDOW.title("Sports Equipment Inventory")
        CALL setup_ui()
    END FUNCTION

    FUNCTION setup_ui()
        // UI components setup goes here
    END FUNCTION

    FUNCTION main() -> str
        CALL GUI_WINDOW.mainloop()
        RETURN "Application Closed"
    END FUNCTION
END CLASS

IF __name__ == "__main__":
    CREATE app = Main()
    CALL app.main()
END IF
```

**Key Functionalities**:
- **Equipment and Alert Management**: Classes `Equipment` and `Alert` define the structure for equipment items and alerts, respectively.
- **Data Handling**: `InventoryManager` class handles loading, saving, and modifying equipment and alerts using JSON files. The program employs the `json` library to parse and write data.
- **UI Integration**: The `tkinter` library is used to create a GUI for user interaction.

