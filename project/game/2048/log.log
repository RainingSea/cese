    class GameBoard:
        -board: list
        +move(direction: str) void
        +merge_tiles() void
        +generate_tile() void
        +check_game_over() bool
    
    class Game:
        -board: GameBoard
        -score: int
        +start_game() void
        +save_game_state() void
