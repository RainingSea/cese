def check_game_over(self) -> bool:
    if any(0 in row for row in self.board):
        return False
    for i in range(4):
        for j in range(4):
            if (i < 3 and self.board[i][j] == self.board[i + 1][j]) or (j < 3 and self.board[i][j] == self.board[i][j + 1]):
                return False
    return True
```

