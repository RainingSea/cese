```python
import random

class GameBoard:
    def __init__(self):
        self.tiles = []

    def initialize_board(self):
        self.tiles = [[0 for _ in range(4)] for _ in range(4)]
        self.generate_tile()
        self.generate_tile()

    def generate_tile(self):
        empty_tiles = [(i, j) for i in range(4) for j in range(4) if self.tiles[i][j] == 0]
        if empty_tiles:
            i, j = random.choice(empty_tiles)
            self.tiles[i][j] = 4 if random.random() < 0.1 else 2

    def move_tiles(self, direction: str):
        if direction == 'up':
            self.move_up()
        elif direction == 'down':
            self.move_down()
        elif direction == 'left':
            self.move_left()
        elif direction == 'right':
            self.move_right()

    def merge_tiles(self, direction: str):
        if direction == 'up':
            self.merge_up()
        elif direction == 'down':
            self.merge_down()
        elif direction == 'left':
            self.merge_left()
        elif direction == 'right':
            self.merge_right()

    def move_up(self):
        for j in range(4):
            column = [self.tiles[i][j] for i in range(4) if self.tiles[i][j] != 0]
            self.tiles[0][j] = column[0] if column else 0
            for i in range(1, len(column)):
                if column[i] == column[i - 1]:
                    self.tiles[i][j] = 0
                    self.tiles[0][j] *= 2
                else:
                    self.tiles[i][j] = column[i]

    def move_down(self):
        for j in range(4):
            column = [self.tiles[i][j] for i in range(3, -1, -1) if self.tiles[i][j] != 0]
            self.tiles[3][j] = column[0] if column else 0
            for i in range(1, len(column)):
                if column[i] == column[i - 1]:
                    self.tiles[3][j] *= 2
                    self.tiles[3 - i][j] = 0
                else:
                    self.tiles[3 - i][j] = column[i]

    def move_left(self):
        for i in range(4):
            row = [self.tiles[i][j] for j in range(4) if self.tiles[i][j] != 0]
            self.tiles[i][0] = row[0] if row else 0
            for j in range(1, len(row)):
                if row[j] == row[j - 1]:
                    self.tiles[i][0] *= 2
                    self.tiles[i][j] = 0
                else:
                    self.tiles[i][j] = row[j]

    def move_right(self):
        for i in range(4):
            row = [self.tiles[i][j] for j in range(3, -1, -1) if self.tiles[i][j] != 0]
            self.tiles[i][3] = row[0] if row else 0
            for j in range(1, len(row)):
                if row[j] == row[j - 1]:
                    self.tiles[i][3] *= 2
                    self.tiles[i][3 - j] = 0
                else:
                    self.tiles[i][3 - j] = row[j]

    def merge_up(self):
        for j in range(4):
            for i in range(3):
                if self.tiles[i][j] == self.tiles[i + 1][j]:
                    self.tiles[i][j] *= 2
                    self.tiles[i + 1][j] = 0

    def merge_down(self):
        for j in range(4):
            for i in range(3, 0, -1):
                if self.tiles[i][j] == self.tiles[i - 1][j]:
                    self.tiles[i][j] *= 2
                    self.tiles[i - 1][j] = 0

    def merge_left(self):
        for i in range(4):
            for j in range(3):
                if self.tiles[i][j] == self.tiles[i][j + 1]:
                    self.tiles[i][j] *= 2
                    self.tiles[i][j + 1] = 0

    def merge_right(self):
        for i in range(4):
            for j in range(3, 0, -1):
                if self.tiles[i][j] == self.tiles[i][j - 1]:
                    self.tiles[i][j] *= 2
                    self.tiles[i][j - 1] = 0

class Game:
    def __init__(self):
        self.board = GameBoard()
        self.score = 0

    def start_game(self):
        self.board.initialize_board()
        # Main game loop would go here

    def move(self, direction: str):
        self.board.move_tiles(direction)
        self.board.merge_tiles(direction)
        self.board.generate_tile()

    def check_game_over(self):
        if any(0 in row for row in self.board.tiles):
            return False
        for i in range(4):
            for j in range(4):
                if (i < 3 and self.board.tiles[i][j] == self.board.tiles[i + 1][j]) or \
                   (j < 3 and self.board.tiles[i][j] == self.board.tiles[i][j + 1]):
                    return False
        return True

    def save_game(self):
        with open('game_state.txt', 'w') as file:
            for row in self.board.tiles:
                file.write(','.join(map(str, row)) + '\n')
            file.write(str(self.score) + '\n')

    def load_game(self):
        with open('game_state.txt', 'r') as file:
            lines = file.readlines()
            self.board.tiles = [list(map(int, line.strip().split(','))) for line in lines[:-1]]
            self.score = int(lines[-1].strip())
