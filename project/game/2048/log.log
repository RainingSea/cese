import random

class Game:
    def __init__(self):
        pygame.font.init()  # Ensure pygame font is initialized
        self.board = self.initialize_board()
        self.score = 0

    def initialize_board(self):
        board = [[0] * 4 for _ in range(4)]
        self.generate_tile(board)
        self.generate_tile(board)
        return board

