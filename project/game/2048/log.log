import random

class GameBoard:
    def __init__(self):
        self.tiles = []

    def initialize_board(self):
        self.tiles = [[0 for _ in range(4)] for _ in range(4)]
        self.generate_tile()
        self.generate_tile()

    def generate_tile(self):
        empty_tiles = [(i, j) for i in range(4) for j in range(4) if self.tiles[i][j] == 0]
        if empty_tiles:
            i, j = random.choice(empty_tiles)
            self.tiles[i][j] = 4 if random.random() < 0.1 else 2

    def move_tiles(self, direction: str):
        if direction == 'up':
            self.move_up()
        elif direction == 'down':
            self.move_down()
        elif direction == 'left':
            self.move_left()
        elif direction == 'right':
            self.move_right()

    def merge_tiles(self, direction: str):
        if direction == 'up':
            self.merge_up()
        elif direction == 'down':
            self.merge_down()
        elif direction == 'left':
            self.merge_left()
        elif direction == 'right':
            self.merge_right()

    def move_up(self):
        # Logic to move tiles up
        pass

    def move_down(self):
        # Logic to move tiles down
        pass

    def move_left(self):
        # Logic to move tiles left
        pass

    def move_right(self):
        # Logic to move tiles right
        pass

    def merge_up(self):
        # Logic to merge tiles up
        pass

    def merge_down(self):
        # Logic to merge tiles down
        pass

    def merge_left(self):
        # Logic to merge tiles left
        pass

    def merge_right(self):
        # Logic to merge tiles right
        pass

class Game:
    def __init__(self):
        self.board = GameBoard()
        self.score = 0

    def start_game(self):
        self.board.initialize_board()
        # Main game loop would go here

    def move(self, direction: str):
        self.board.move_tiles(direction)
        self.board.merge_tiles(direction)
        self.board.generate_tile()

    def check_game_over(self):
        # Logic to check if the game is over
        pass

    def save_game(self):
        with open('game_state.txt', 'w') as file:
            for row in self.board.tiles:
                file.write(','.join(map(str, row)) + '\n')
            file.write(str(self.score) + '\n')

    def load_game(self):
        with open('game_state.txt', 'r') as file:
            self.board.tiles = [list(map(int, line.strip().split(','))) for line in file.readlines()[:-1]]
            self.score = int(file.readlines()[-1].strip())
