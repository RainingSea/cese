    def __init__(self):
        self.paddle = Paddle()
        self.ball = Ball()
        self.bricks = [Brick((x * BRICK_WIDTH, y * BRICK_HEIGHT)) for x in range(10) for y in range(5)]
        self.score = 0  # Initialize score
        self.lives = 3  # Initialize lives

