    def change_lane(self, direction: str):
        new_lane = self.lane + (-1 if direction == "left" else 1)
        if 0 <= new_lane <= 2:
            self.lane = new_lane

    def stop(self):
        self.speed = 0

class Obstacle:
    def __init__(self, lane):
        self.type = random.randint(1, 3)  # Random obstacle type
        self.position = lane

    def move(self):
        # Logic to move the obstacle down the lane
        pass

