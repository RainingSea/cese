        self.screen.fill((0, 0, 0))  # Clear screen
        # Logic to render the vehicle, obstacles, and score on the screen
        pygame.display.flip()  # Update the display

    def stop_game(self):
        self.running = False
        self.save_data()

    def save_data(self):
        with open('game_data.txt', 'a') as f:
