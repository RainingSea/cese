import pygame
import random

class Enemy:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.width = 40
        self.height = 40
        self.move_speed = 2
        self.direction = random.choice([-1, 1])  # Randomly choose direction

    def move(self):
