1. |Case|:**bird_control**
```plaintext
CLASS Bird
    FUNCTION __init__()
        SET self.position to [100, 250]  // Initial position of the bird
        SET self.velocity to 0            // Initial velocity
        
    FUNCTION flap()
        SET self.velocity to -10          // Sets upward velocity on flap
    
    FUNCTION update()
        INCREMENT self.velocity by 0.5    // Gravity effect
        UPDATE self.position[1] by self.velocity // Update bird's vertical position

// Usage of pygame for graphical representation
IMPORT pygame
```

2. |Case|:**high_score_storage**
```plaintext
CLASS Score
    FUNCTION __init__()
        SET self.current_score to 0                // Initialize current score to 0
        SET self.high_score to self.load_high_score() // Load existing high score
        
    FUNCTION increment()
        INCREMENT self.current_score by 1         // Increment current score by 1
    
    FUNCTION save_high_score()
        IF self.current_score > self.high_score THEN
            SET self.high_score to self.current_score // Update high score
            OPEN 'highscore.txt' in write mode AS f
                WRITE self.high_score to f        // Save high score into file
            CLOSE f

    FUNCTION load_high_score()
        TRY
            OPEN 'highscore.txt' in read mode AS f
                RETURN int(read from f)          // Load and return high score
            CLOSE f
        EXCEPT FileNotFoundError
            RETURN 0                              // Return 0 if file not found
```

3. |Case|:**restart_game**
```plaintext
FUNCTION Game.restart_game()
    IF score > high_score THEN
        high_score = score
        CALL save_high_score()
    ENDIF
    score = 0
    CLEAR pipes
    SET bird.y = DEFAULT_VERTICAL_POSITION
    SET bird.velocity = 0
END FUNCTION
```

4. |Case|:**pipe_movement**
```plaintext
FUNCTION Pipe.move()
    x = x - PIPE_SPEED
END FUNCTION

FUNCTION Game.update()
    bird.update()  // Update creates a gravity effect on bird
    IF LENGTH of pipes == 0 OR last pipe.x < SPAWN_THRESHOLD THEN
        APPEND new Pipe at screen width to pipes
    ENDIF
    FOR EACH pipe IN pipes DO
        CALL pipe.move()
    ENDFOR
    CALL check_collision()
    FILTER pipes WHERE pipe.x > OUT_OF_BOUNDS
END FUNCTION
```

5. |Case|:**scoring_system**
```plaintext
FUNCTION Game.check_collision()
    FOR EACH pipe IN pipes DO
        IF bird.collides_with(pipe) THEN
            CALL restart_game()
        ENDIF
    ENDFOR

    IF bird.y > FLOOR_LEVEL OR bird.y < CEILING_LEVEL THEN
        CALL restart_game()
    ENDIF
    score = score + 1  // Increment score with each update
END FUNCTION
```

