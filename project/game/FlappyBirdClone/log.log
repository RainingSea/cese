        pygame.draw.rect(screen, (0, 255, 0), (self.x, self.gap_y + 150, 50, 600 - self.gap_y - 150))

class Game:
    def __init__(self):
        self.bird = Bird()
        self.pipes = []
        self.score = 0
        self.high_score = 0
        self.load_high_score()
        self.screen = pygame.display.set_mode((800, 600))
        self.clock = pygame.time.Clock()
        self.running = True

    def start_game(self):
        while self.running:
            self.handle_events()
            self.update()
            self.render()
            self.clock.tick(30)
        self.save_high_score()

    def handle_events(self):
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                self.running = False
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_SPACE:
                    self.bird.flap()

    def update(self):
        self.bird.update()
        if len(self.pipes) == 0 or self.pipes[-1].x < 600:
            self.pipes.append(Pipe())
        for pipe in self.pipes:
            pipe.update()
        self.check_collisions()

    def check_collisions(self):
        for pipe in self.pipes:
            if (self.bird.x + 30 > pipe.x and self.bird.x < pipe.x + 50 and
                (self.bird.y < pipe.gap_y or self.bird.y + 30 > pipe.gap_y + 150)):
                self.running = False

    def render(self):
        self.screen.fill((135, 206, 235))  # Sky blue
        pygame.draw.circle(self.screen, (255, 255, 0), (self.bird.x, self.bird.y), 15)  # Bird
        for pipe in self.pipes:
            pipe.draw(self.screen)
        self.display_score()
        pygame.display.flip()

    def display_score(self):
        font = pygame.font.Font(None, 36)
        score_text = font.render(f'Score: {self.score}', True, (255, 255, 255))
        self.screen.blit(score_text, (10, 10))

    def load_high_score(self):
        try:
            with open('scores.txt', 'r') as file:
                self.high_score = int(file.read().strip())
        except FileNotFoundError:
            self.high_score = 0

    def save_high_score(self):
        if self.score > self.high_score:
            self.high_score = self.score
            with open('scores.txt', 'w') as file:
                file.write(str(self.high_score))

