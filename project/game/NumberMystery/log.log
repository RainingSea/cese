        self.question = question
        self.answer = answer
        self.hint = hint

    def check_answer(self, answer: str) -> bool:
        return self.answer.lower() == answer.lower()


class Game:
    def __init__(self):
        self.player = None
        self.puzzles = []
        self.load_puzzles()
        self.load_progress()

