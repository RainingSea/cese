    def __init__(self):
        self.time_taken = 0
        self.accuracy = 0

    def calculate_score(self, time: int, accuracy: bool) -> int:
        self.time_taken = time
        self.accuracy = 1 if accuracy else 0
        return max(100 - self.time_taken * 10 + self.accuracy * 50, 0)  # Example scoring logic

