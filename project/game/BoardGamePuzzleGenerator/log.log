            puzzles["pattern"] = ["Pattern Puzzle 1", "Pattern Puzzle 2"]
            puzzles["spatial"] = ["Spatial Puzzle 1", "Spatial Puzzle 2"]

        RETURN RANDOM CHOICE FROM puzzles[category]
    END FUNCTION
END CLASS
