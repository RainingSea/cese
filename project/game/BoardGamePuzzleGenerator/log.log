import pygame
import sys
from game import Game

class Main:
    def __init__(self):
        self.game = Game()

    def main(self) -> str:
        pygame.init()
        screen = pygame.display.set_mode((800, 600))
        pygame.display.set_caption("Puzzle Game")
        clock = pygame.time.Clock()

        while True:
            for event in pygame.event.get():
