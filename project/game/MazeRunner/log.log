import pygame
from player import Player
from maze import Maze
from star import Star
from timer import Timer
from score import Score

class Game:
    def __init__(self):
        self.player = Player()
        self.maze = Maze()
        self.timer = Timer()
        self.score = Score()
        self.stars = []
        self.screen = pygame.display.set_mode((800, 600))
        pygame.display.set_caption("Maze Runner")
        self.clock = pygame.time.Clock()
        self.running = True

    def start_game(self):
        self.load_level(1)
        self.timer.start()
        while self.running:
            self.update()
            self.render()
            self.clock.tick(60)

    def load_level(self, level: int):
        self.maze.generate_maze()
        self.load_stars(level)

    def load_stars(self, level: int):
        # Load star positions based on level (for demonstration, hardcoded)
        star_positions = [(1, 1), (2, 2), (3, 3)]  # Example star positions
        self.stars = [Star(pos) for pos in star_positions]

    def update(self):
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                self.running = False
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_LEFT:
                    self.player.move("left")
                elif event.key == pygame.K_RIGHT:
                    self.player.move("right")
                elif event.key == pygame.K_UP:
                    self.player.move("up")
                elif event.key == pygame.K_DOWN:
                    self.player.move("down")
                self.check_star_collection()

    def check_star_collection(self):
        for star in self.stars:
            if not star.is_collected() and self.player.position == star.position:
                star.collected = True
                self.player.collect_star()
                self.score.update_score(1, self.timer.get_elapsed_time(), 0)  # Update score

    def render(self):
        self.screen.fill((0, 0, 0))  # Clear screen
        self.maze.render(self.screen)
        self.player.render(self.screen)
        for star in self.stars:
            if not star.is_collected():
                star.render(self.screen)
        self.score.render(self.screen)
        pygame.display.flip()
```

*** player.py
```python
import pygame

class Player:
    def __init__(self):
        self.position = (0, 0)
        self.score = 0  # Initialize player's score at 0

    def move(self, direction: str):
        if direction == "left":
            self.position = (self.position[0] - 1, self.position[1])
        elif direction == "right":
            self.position = (self.position[0] + 1, self.position[1])
        elif direction == "up":
            self.position = (self.position[0], self.position[1] - 1)
        elif direction == "down":
            self.position = (self.position[0], self.position[1] + 1)

    def collect_star(self):
        self.score += 1  # Increment the player's score by 1 when collecting a star

    def render(self, screen):
        pygame.draw.rect(screen, (255, 0, 0), (*self.position, 20, 20))  # Draw player
```

*** maze.py
```python
import pygame
import random

class Maze:
    def __init__(self):
        self.layout = []
        self.obstacles = []

    def generate_maze(self):
        self.layout = [[random.choice([' ', '#']) for _ in range(10)] for _ in range(10)]  # Random layout
        self.obstacles = [(x, y) for y in range(10) for x in range(10) if self.layout[y][x] == '#']  # Populate obstacles

    def check_collision(self, position: tuple) -> bool:
        return position in self.obstacles  # Check for collisions with walls

    def render(self, screen):
        for y, row in enumerate(self.layout):
            for x, cell in enumerate(row):
                color = (255, 255, 255) if cell == ' ' else (0, 0, 0)
                pygame.draw.rect(screen, color, (x * 20, y * 20, 20, 20))  # Draw maze cells
```

