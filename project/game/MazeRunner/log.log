CLASS Game
    FUNCTION __init__()
        IMPORT Player
        IMPORT Maze
        
        CREATE Player instance
        CREATE Maze instance
        INITIALIZE stars as empty list
        INITIALIZE score to 0
        INITIALIZE timer to 0.0
    END FUNCTION

    FUNCTION run()
        INITIALIZE clock from pygame.time.Clock()
        SET running to True
        WHILE running
            CALL update()
            CALL render()
            CALL clock.tick(60)
            
            FOR event IN pygame.event.get()
                IF event.type == pygame.QUIT
                    SET running to False
                ENDIF
            ENDFOR
        END WHILE
    END FUNCTION

    FUNCTION update()
        GET pressed keys using pygame.key.get_pressed()
        IF keys[pygame.K_LEFT]
            CALL self.player.move("left")
        ENDIF
        IF keys[pygame.K_RIGHT]
            CALL self.player.move("right")
        ENDIF
        IF keys[pygame.K_UP]
            CALL self.player.move("up")
        ENDIF
        IF keys[pygame.K_DOWN]
            CALL self.player.move("down")
        ENDIF
        INCREMENT timer by 1 / 60
    END FUNCTION

    FUNCTION render()
        # Rendering logic (to be implemented)
    END FUNCTION
END CLASS
```

2. **Player Class Logic**
```pseudocode
CLASS Player
    FUNCTION __init__()
        INITIALIZE x to 0
        INITIALIZE y to 0
    END FUNCTION

    FUNCTION move(direction: STRING)
        IF direction == "left"
            DECREMENT x by 1
        ELSE IF direction == "right"
            INCREMENT x by 1
        ELSE IF direction == "up"
            DECREMENT y by 1
        ELSE IF direction == "down"
            INCREMENT y by 1
        ENDIF
    END FUNCTION
END CLASS
```

