import pygame

class Player:
    def __init__(self):
        self.position = (0, 0)  # Initialize player's position at (0, 0)
        self.score = 0  # Initialize player's score at 0

    def move(self, direction: str):
        if direction == "up":
            self.position = (self.position[0], self.position[1] - 1)  # Move up
        elif direction == "down":
            self.position = (self.position[0], self.position[1] + 1)  # Move down
        elif direction == "left":
            self.position = (self.position[0] - 1, self.position[1])   # Move left
        elif direction == "right":
            self.position = (self.position[0] + 1, self.position[1])   # Move right

    def collect_star(self):
        self.score += 1  # Increment the player's score by 1 when collecting a star

    def render(self, screen):
        pygame.draw.rect(screen, (255, 0, 0), (*self.position, 20, 20))  # Draw player
