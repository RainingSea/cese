        self.score = 0
        self.stars_collected = 0
        self.moves = 0

    def move(self, direction: str) -> None:
        x, y = self.position
        if direction == 'UP':
            self.position = (x, y - 1)
        elif direction == 'DOWN':
            self.position = (x, y + 1)
        elif direction == 'LEFT':
            self.position = (x - 1, y)
        elif direction == 'RIGHT':
            self.position = (x + 1, y)
        self.moves += 1

    def collect_star(self) -> bool:
