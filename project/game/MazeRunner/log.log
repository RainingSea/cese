                self.position = (x, y - 1)
            elif direction == 'DOWN':
                self.position = (x, y + 1)
            elif direction == 'LEFT':
                self.position = (x - 1, y)
            elif direction == 'RIGHT':
                self.position = (x + 1, y)
            self.moves += 1

