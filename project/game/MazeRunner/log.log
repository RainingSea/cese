        ELSE IF direction == "right"
            INCREMENT x by 1
        ELSE IF direction == "up"
            DECREMENT y by 1
        ELSE IF direction == "down"
            INCREMENT y by 1
        ENDIF
    END FUNCTION
END CLASS
```

