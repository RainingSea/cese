        self.points = 0

    def update(self, points: int) -> None:
        self.points += points

class Tile:
    def __init__(self, color):
        self.color = color

    def get_color(self) -> str:
        return self.color

class Player:
    def __init__(self, name: str):
        self.name = name
        self.score = Score()

    def take_turn(self) -> None:
        # Logic for taking a turn
        pass

class Board:
