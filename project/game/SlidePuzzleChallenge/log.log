    def shuffle_tiles(self) -> None:
        self.grid.shuffle()

    def provide_hint(self) -> str:
        return self.hints.generate_hint(self.grid)

    def reset_game(self) -> None:
        self.grid.reset()
        self.shuffle_tiles()

