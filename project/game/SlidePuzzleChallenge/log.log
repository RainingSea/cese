    flat_tiles = FLATTEN self.tiles // Flatten the grid to a single-dimensional list
    CALL random.shuffle(flat_tiles)  // Shuffle the list of tiles
    self.tiles = CONVERT flat_tiles BACK TO 2D ARRAY
