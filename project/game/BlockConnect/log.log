        self.color = color
        self.position = position

class Game:
    def __init__(self):
        self.grid = self.initialize_grid()
        self.score = 0
        self.previous_moves = []

    def initialize_grid(self) -> list:
        colors = ['red', 'green', 'blue', 'yellow', 'purple']
        return [[Block(random.choice(colors), (x, y)) for y in range(8)] for x in range(8)]

