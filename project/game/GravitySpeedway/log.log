import pygame
import random

class Vehicle:
    def __init__(self, name, handling, acceleration, top_speed):
        self.name = name
        self.handling = handling
        self.acceleration = acceleration
        self.top_speed = top_speed
        self.position = 0
        self.speed = 0

    def move(self):
        keys = pygame.key.get_pressed()
        if keys[pygame.K_UP]:
            self.speed += self.acceleration
        if keys[pygame.K_DOWN]:
            self.speed -= self.acceleration
        self.speed = max(0, min(self.speed, self.top_speed))
        self.position += self.speed

class Track:
    def __init__(self, name):
        self.name = name
        self.obstacles = []

    def load_track(self):
        with open('tracks.txt', 'r') as file:
            for line in file:
                obstacle = line.strip()
                if obstacle:
                    self.obstacles.append(obstacle)

class Game:
    def __init__(self):
        self.vehicles = []
        self.tracks = []
        self.current_vehicle = None
        self.load_vehicles()
        self.load_tracks()
        self.screen = pygame.display.set_mode((800, 600))
        pygame.display.set_caption("Racing Game")

    def load_vehicles(self):
        with open('vehicles.txt', 'r') as file:
            for line in file:
                name, handling, acceleration, top_speed = line.strip().split('|')
                vehicle = Vehicle(name, float(handling), float(acceleration), float(top_speed))
                self.vehicles.append(vehicle)

    def load_tracks(self):
        with open('tracks.txt', 'r') as file:
            for line in file:
                track_name = line.strip()
                if track_name:
                    track = Track(track_name)
                    track.load_track()
                    self.tracks.append(track)

    def start_race(self):
        self.current_vehicle = random.choice(self.vehicles)

    def update(self):
        if self.current_vehicle:
            self.current_vehicle.move()

    def handle_input(self):
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                exit()

    def render(self):
        self.screen.fill((0, 0, 0))  # Clear the screen with black
        if self.current_vehicle:
            # Draw the vehicle as a rectangle for simplicity
            pygame.draw.rect(self.screen, (255, 0, 0), (self.current_vehicle.position, 300, 50, 30))
        pygame.display.flip()  # Update the display
