        elif direction == "up":
            self.position.y -= 5
        elif direction == "down":
            self.position.y += 5

    def update_physics(self) -> None:
        # Implement anti-gravity physics here
        pass

    def draw(self, surface):
        pygame.draw.rect(surface, (0, 255, 0), (self.position.x, self.position.y, 50, 30))
