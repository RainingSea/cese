```python
import pygame
import random

class Player:
    def __init__(self):
        self.position_x = 300  # Starting position at the bottom center

    def move_left(self):
        if self.position_x > 0:
            self.position_x -= 10

    def move_right(self):
        if self.position_x < 580:  # Assuming the width of the window is 600
            self.position_x += 10

class Block:
    def __init__(self):
        self.position_y = 0
        self.speed = random.randint(5, 10)
        self.position_x = random.randint(0, 580)  # Random starting position

    def fall(self):
        self.position_y += self.speed

    def reset_position(self):
        self.position_y = 0
        self.position_x = random.randint(0, 580)

class Game:
    def __init__(self):
        self.player = Player()
        self.blocks = [Block() for _ in range(5)]  # Create 5 blocks
        self.score = 0
        self.high_score = self.load_high_score()

    def run(self):
        pygame.init()
        screen = pygame.display.set_mode((600, 600))
        pygame.display.set_caption("Dodge the Falling Blocks")
        clock = pygame.time.Clock()
        running = True

        while running:
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    running = False

            keys = pygame.key.get_pressed()
            if keys[pygame.K_LEFT]:
                self.player.move_left()
            if keys[pygame.K_RIGHT]:
                self.player.move_right()

            self.update()
            self.display_score(screen)
            pygame.display.flip()
            clock.tick(30)

        self.save_high_score()
        pygame.quit()

    def update(self):
        for block in self.blocks:
            block.fall()
            if block.position_y > 600:  # Reset block if it falls below screen
                block.reset_position()
                self.score += 1
            if self.check_collision(block):
                self.game_over()

    def check_collision(self, block):
        return (self.player.position_x < block.position_x + 20 and
                self.player.position_x + 20 > block.position_x and
                block.position_y + 20 > 580)  # Assuming player height is 20

    def display_score(self, screen):
        font = pygame.font.Font(None, 36)
        score_text = font.render(f'Score: {self.score}', True, (255, 255, 255))
        screen.blit(score_text, (10, 10))

    def load_high_score(self):
        try:
            with open('high_scores.txt', 'r') as file:
                return max(map(int, file.readlines()), default=0)
        except FileNotFoundError:
            return 0

    def save_high_score(self):
        if self.score > self.high_score:
            with open('high_scores.txt', 'a') as file:
                file.write(f'{self.score}\n')
            self.high_score = self.score

    def game_over(self):
        print("Game Over!")
        pygame.quit()
        exit()
