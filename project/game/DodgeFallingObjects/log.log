  --- FILE: game.py (PATH: D:/Project/CE/CE/project/game/DodgeFallingObjects/ce\ce_2\code\game.py, TYPE: .py) ---
import pygame
from player import Player
from block import Block
import random

class Game:
    def __init__(self):
        self.player = Player(375, 550)
        self.blocks = []
        self.score = 0
        self.high_score = self.load_high_score()

    def run(self):
        pygame.init()
        screen = pygame.display.set_mode((800, 600))
        clock = pygame.time.Clock()
        running = True

        while running:
            self.update()
            self.draw(screen)
            pygame.display.flip()
            clock.tick(60)

            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    running = False

        self.save_score()
        pygame.quit()

    def update(self):
        if random.randint(1, 20) == 1:  # Randomly generate blocks
            new_block = Block(random.randint(0, 750), 0, random.randint(1, 5))
            self.blocks.append(new_block)

        for block in self.blocks:
            block.fall()
            if block.y > 600:
                self.blocks.remove(block)
                self.score += 1

        self.check_collision()

    def draw(self, surface):
        surface.fill((0, 0, 0))
        self.player.draw(surface)
        for block in self.blocks:
            block.draw(surface)
        self.display_score(surface)

    def check_collision(self) -> bool:
        for block in self.blocks:
            if (self.player.x < block.x + block.width and
                self.player.x + self.player.width > block.x and
                self.player.y < block.y + block.height and
                self.player.y + self.player.height > block.y):
                self.high_score = max(self.high_score, self.score)
                self.score = 0
                return True
        return False

    def save_score(self):
        with open('score.txt', 'w') as f:
            f.write(str(self.high_score))

    def load_high_score(self) -> int:
        try:
            with open('score.txt', 'r') as f:
                return int(f.read().strip())
        except FileNotFoundError:
            return 0

    def display_score(self, surface):
        font = pygame.font.SysFont(None, 36)
        score_text = font.render(f'Score: {self.score} High Score: {self.high_score}', True, (255, 255, 255))
        surface.blit(score_text, (10, 10))

