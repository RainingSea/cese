           self.board = [['', '', ''], ['', '', ''], ['', '', '']]  // Initialize board
           self.current_turn = 'X'  // First player is X
           self.timer = 0
           self.start_time = None

   FUNCTION main()
       game = Game()  // Create new game instance
       game.start_game()  // Start the game
   ```

