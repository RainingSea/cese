                   RETURN "{winner} wins"
           FOR each column in grid.cells
               IF all cells in column are the same AND not empty
                   SET winner to the symbol of column's first cell
                   RETURN "{winner} wins"
           IF diagonal from top left to bottom right is same AND not empty
               SET winner to the symbol of the first diagonal cell
               RETURN "{winner} wins"
           IF diagonal from top right to bottom left is same AND not empty
               SET winner to the symbol of the first diagonal cell
               RETURN "{winner} wins"
           IF grid.is_full()
