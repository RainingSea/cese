        self.cells = [['' for _ in range(3)] for _ in range(3)]

    def update_cell(self, row: int, col: int, symbol: str):
        self.cells[row][col] = symbol

    def is_full(self) -> bool:
        return all(cell != '' for row in self.cells for cell in row)

