```python
import pygame
import random

class Game:
    def __init__(self):
        self.player_ghost = PlayerGhost(5, 5)
        self.monster = Monster(1, 1)
        self.walls = [Wall(x, y) for x in range(10) for y in range(10) if (x + y) % 2 == 0]
        self.pellets = [Pellet(random.randint(0, 9), random.randint(0, 9)) for _ in range(5)]
        self.score = 0
        self.ticks = 0

    def start(self):
        screen = pygame.display.set_mode((400, 400))
        clock = pygame.time.Clock()
        running = True
        
        while running:
            self.update()
            self.render(screen)
            self.check_collisions()
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    running = False
            clock.tick(60)

    def update(self):
        keys = pygame.key.get_pressed()
        if keys[pygame.K_UP]:
            self.player_ghost.move("UP")
        if keys[pygame.K_DOWN]:
            self.player_ghost.move("DOWN")
        if keys[pygame.K_LEFT]:
            self.player_ghost.move("LEFT")
        if keys[pygame.K_RIGHT]:
            self.player_ghost.move("RIGHT")
        self.ticks += 1

    def render(self, screen):
        screen.fill((0, 0, 0))
        for wall in self.walls:
            pygame.draw.rect(screen, (255, 0, 0), (wall.x * 40, wall.y * 40, 40, 40))
        for pellet in self.pellets:
            pygame.draw.circle(screen, (0, 255, 0), (pellet.x * 40 + 20, pellet.y * 40 + 20), 10)
        pygame.draw.circle(screen, (0, 0, 255), (self.player_ghost.x * 40 + 20, self.player_ghost.y * 40 + 20), 20)
        pygame.display.flip()

    def check_collisions(self):
        for pellet in self.pellets:
            if self.player_ghost.x == pellet.x and self.player_ghost.y == pellet.y:
                self.player_ghost.eat_pellet()
                self.pellets.remove(pellet)
                self.score += 1

class PlayerGhost:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.has_superpellet = False

    def move(self, direction):
        if direction == "UP":
            self.y = max(0, self.y - 1)
        elif direction == "DOWN":
            self.y = min(9, self.y + 1)
        elif direction == "LEFT":
            self.x = max(0, self.x - 1)
        elif direction == "RIGHT":
            self.x = min(9, self.x + 1)

    def eat_pellet(self):
        pass

    def eat_superpellet(self):
        self.has_superpellet = True

class Monster:
    def __init__(self, x, y):
        self.x = x
        self.y = y

    def chase(self, target):
        if self.x < target.x:
            self.x += 1
        elif self.x > target.x:
            self.x -= 1
        if self.y < target.y:
            self.y += 1
        elif self.y > target.y:
            self.y -= 1

class Wall:
    def __init__(self, x, y):
        self.x = x
        self.y = y

class Pellet:
    def __init__(self, x, y):
        self.x = x
        self.y = y

class SuperPellet:
    def __init__(self, x, y):
        self.x = x
        self.y = y
