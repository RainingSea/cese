        if direction == 'left':
            self.x -= 5
        elif direction == 'right':
            self.x += 5
        elif direction == 'up':
            self.y -= 5
        elif direction == 'down':
            self.y += 5

    def eat_pellet(self):
        # Logic to eat pellet
        pass

    def eat_superpellet(self):
        self.has_superpower = True
