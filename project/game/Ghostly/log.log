        IF direction == 'UP'
            DECREASE position_y by 1
        ELSEIF direction == 'DOWN'
            INCREASE position_y by 1
        ELSEIF direction == 'LEFT'
            DECREASE position_x by 1
        ELSEIF direction == 'RIGHT'
            INCREASE position_x by 1
        ENDIF
    END METHOD
END CLASS

CLASS Game
