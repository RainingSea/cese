CLASS Player:
    FUNCTION __init__():
        SET position TO (0, 1)  // Starting position
    
    FUNCTION move(direction: str):
        SET x, y TO position
        IF direction == 'up':
            SET position TO (max(0, x - 1), y)
        ELSE IF direction == 'down':
            SET position TO (min(9, x + 1), y)
        ELSE IF direction == 'left':
            SET position TO (x, max(0, y - 1))
        ELSE IF direction == 'right':
            SET position TO (x, min(9, y + 1))

// Key Invocation
CREATE Player instance as player
CALL player.move('down')  // Move player down
ASSERT position == (1, 1)  // Validate position
CALL player.move('right')  // Move player right
ASSERT position == (1, 2)  // Validate position
CALL player.move('up')     // Move player up
ASSERT position == (0, 2)  // Validate position
CALL player.move('left')   // Move player left
ASSERT position == (0, 1)  // Validate position
