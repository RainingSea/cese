        PRINT "Congratulations! You've completed the maze."

// Key Invocation
CREATE Player instance as player
SET player.position TO (9, 8)  // Move to exit position
CALL player.check_exit()        // Check if it's the exit
IF check_exit() THEN
    CALL Game.display_completion_message()  // Display completion message
ENDIF
```
