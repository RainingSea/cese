class Player:
    def __init__(self):
        self.position = (0, 1)  # Starting position

    def move(self, direction: str):
        x, y = self.position
        if direction == "UP":
            self.position = (x, max(0, y - 1))
        elif direction == "DOWN":
            self.position = (x, min(9, y + 1))
        elif direction == "LEFT":
            self.position = (max(0, x - 1), y)
        elif direction == "RIGHT":
            self.position = (min(9, x + 1), y)

    def check_exit(self, exit_position: tuple) -> bool:
        return self.position == exit_position
