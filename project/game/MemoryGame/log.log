*** game.py
```python
import pygame
import random
import time

class Card:
    def __init__(self, image):
        self.image = image
        self.is_face_up = False

    def flip(self):
        self.is_face_up = not self.is_face_up

    def is_matched(self):
        return self.is_face_up  # Placeholder for actual matching logic

class Timer:
    def __init__(self):
        self.start_time = 0
        self.elapsed_time = 0

    def start(self):
        self.start_time = time.time()

    def stop(self):
        self.elapsed_time = time.time() - self.start_time

    def get_elapsed_time(self):
        return int(self.elapsed_time)

class Score:
    def __init__(self):
        self.points = 0

    def calculate_score(self, time):
        return max(1000 - time, 0)  # Simple scoring logic

    def save_score(self, player_name):
        with open('high_scores.txt', 'a') as f:
            f.write(f"{player_name}:{self.points}\n")

class Game:
    def __init__(self):
        self.cards = [Card(f"image_{i}.png") for i in range(8)] * 2  # 16 cards
        random.shuffle(self.cards)
        self.timer = Timer()
        self.score = Score()
        self.flipped_cards = []

    def start_game(self):
        self.timer.start()

    def restart_game(self):
        self.cards = [Card(f"image_{i}.png") for i in range(8)] * 2
        random.shuffle(self.cards)
        self.timer.start()
        self.score.points = 0
        self.flipped_cards = []

    def check_match(self, card1, card2):
        if card1.image == card2.image:
            self.score.points += 10  # Increment score for a match
            return True
        return False

    def update_display(self):
        # Placeholder for UI update logic
        pass

    def handle_event(self, event):
        # Placeholder for event handling logic
        pass
