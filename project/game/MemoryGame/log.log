```python
class MemoryGame:
    # Class Initialization
    def __init__(self):
        self.cards = []
        self.score = 0
        self.timer = 0.0
        self.game_over = False
        self.shuffle_cards()

    # Shuffle and initialize cards
    def shuffle_cards(self):
        faces = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H']  # Example faces for pairs
        pairs = faces * 2  # Create pairs
        random.shuffle(pairs)  # Shuffle the pairs
        self.cards = [Card(face) for face in pairs]  # Create Card objects for each face

    # Check if two cards match
    def check_match(self, index1: int, index2: int) -> bool:
        return self.cards[index1].is_match(self.cards[index2])  # Match based on card faces

    # Manage card flipping
    def flip_card(self, index: int):
        if not self.cards[index].is_flipped and not self.game_over:  # Ensure card isn't flipped and game is ongoing
            self.cards[index].flip()  # Flip the card

# Card Class Implementation
class Card:
    def __init__(self, face: str):
        self.face = face  # Card face
        self.is_flipped = False  # Card initial state

    # Flip the state of the card
    def flip(self):
        self.is_flipped = not self.is_flipped  # Toggle card state

    # Match cards based on face
    def is_match(self, other: 'Card') -> bool:
        return self.face == other.face  # Check face equality
```

