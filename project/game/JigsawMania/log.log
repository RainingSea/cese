import time

class Timer:
    def __init__(self):
        self.start_time = 0
        self.elapsed_time = 0

    def start(self) -> None:
        self.start_time = time.time()

    def stop(self) -> None:
        self.elapsed_time = time.time() - self.start_time

    def get_elapsed_time(self) -> int:
        return int(time.time() - self.start_time)
