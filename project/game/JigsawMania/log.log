        if self.puzzle:
            self.puzzle.pieces[piece_id].rotate()

    def restart_game(self):
        if self.puzzle:
            self.puzzle.shuffle_pieces()
            self.timer.start()

if __name__ == "__main__":
    main = Main()
    main.main()

