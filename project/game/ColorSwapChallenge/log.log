import pygame
import random
import json

# Constants
GRID_SIZE = 8
BLOCK_COLORS = ['red', 'green', 'blue', 'yellow', 'purple']
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
BLOCK_SIZE = 70

class Block:
