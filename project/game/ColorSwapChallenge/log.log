        self.color = color

    def draw(self, surface, position):
        pygame.draw.rect(surface, self.color, (position[0], position[1], BLOCK_SIZE, BLOCK_SIZE))

class Grid:
    def __init__(self):
        self.blocks = [[Block(random.choice(BLOCK_COLORS)) for _ in range(GRID_SIZE)] for _ in range(GRID_SIZE)]

    def initialize_grid(self):
        self.blocks = [[Block(random.choice(BLOCK_COLORS)) for _ in range(GRID_SIZE)] for _ in range(GRID_SIZE)]

    def get_block(self, pos):
        return self.blocks[pos[0]][pos[1]]

