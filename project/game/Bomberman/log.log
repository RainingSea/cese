import pygame
import random

class Grid:
    def __init__(self):
        self.cells = [[0 for _ in range(13)] for _ in range(13)]

    def initialize_grid(self):
        for i in range(13):
            for j in range(13):
                self.cells[i][j] = 0

    def draw(self, screen):
