import pygame
from game import Game

def main():
    pygame.init()
    screen = pygame.display.set_mode((520, 520))
    pygame.display.set_caption("Bomberman Game")
    
    game = Game()
    game.start_game()
    game.load_data()

    running = True
    while running:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False

        game.update()
        game.render(screen)
        pygame.display.flip()

    game.save_data()
    pygame.quit()

if __name__ == "__main__":
