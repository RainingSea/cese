        self.screen = pygame.display.set_mode((800, 600))
        pygame.display.set_caption("Drift Rivals")
        self.clock = pygame.time.Clock()

    def start_game(self) -> None:
        self.track.load("track1")  # Load a predefined track
        self.run()

    def run(self) -> None:
        while True:
            self.handle_input()
            self.update()
            self.render()
            self.clock.tick(60)

    def handle_input(self) -> None:
        for event in pygame.event.get():
            if event.type == QUIT:
                pygame.quit()
                exit()

        keys = pygame.key.get_pressed()
        if keys[K_LEFT]:
            self.car.move("left")
        if keys[K_RIGHT]:
            self.car.move("right")
        if keys[K_UP]:
            self.car.move("forward")
        if keys[K_DOWN]:
            self.car.move("backward")
        if keys[K_SPACE]:
            self.car.drift()

    def update(self) -> None:
        self.car.update_position()
        self.score.calculate_score(self.car.drift_metrics)

    def render(self) -> None:
        self.screen.fill((0, 0, 0))  # Clear screen
        self.track.render(self.screen)
        self.car.render(self.screen)
        pygame.display.flip()
