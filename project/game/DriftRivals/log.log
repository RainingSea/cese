import json

class ScoreManager:
    def __init__(self):
        self.scores = []

    def load_scores(self, file_path: str) -> None:
        with open(file_path, 'r') as f:
            self.scores = json.load(f)

    def save_score(self, score: int) -> None:
        self.scores.append(score)
        with open('scores.txt', 'w') as f:
