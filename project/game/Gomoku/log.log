  ```python
  class Game:
      def check_victory(self) -> bool:
          # Loop through each cell in the board.
          for x in range(15):
              for y in range(15):
                  # Check if there is a piece at the cell.
                  if self.board[x][y] != '':
                      # Check in all directions for a victory condition.
                      if self.check_line(x, y, 1, 0) or self.check_line(x, y, 0, 1) or \
                         self.check_line(x, y, 1, 1) or self.check_line(x, y, 1, -1):
                          return True
          return False
  
      def check_line(self, x: int, y: int, dx: int, dy: int) -> bool:
          piece = self.board[x][y]
          count = 1
          # Check for 5 consecutive pieces in a specific direction.
          for step in range(1, 5):
              nx, ny = x + dx * step, y + dy * step
              if 0 <= nx < 15 and 0 <= ny < 15 and self.board[nx][ny] == piece:
                  count += 1
              else:
                  break
          return count >= 5
  ```

