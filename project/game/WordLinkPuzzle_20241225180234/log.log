import pygame

class Timer:
    def __init__(self):
        self.time_left = 0
        self.running = False

    def start_timer(self, duration: int):
        self.time_left = duration
        self.running = True

    def pause_timer(self):
        self.running = False

    def check_time(self) -> bool:
        if self.running:
            self.time_left -= 1  # Decrement time left
            if self.time_left <= 0:
                self.running = False
                return True
        return False

