### timer.py
```python
import pygame

class Timer:
    def __init__(self):
        self.time_left = 0
        self.running = False

    def start_timer(self, duration: int):
        self.time_left = duration
        self.running = True

    def pause_timer(self):
        self.running = False

    def check_time(self) -> bool:
        if self.running:
            self.time_left -= 1  # Decrement time left
            if self.time_left <= 0:
                self.running = False
                return True
        return False
```

### wordlist.py
```python
class WordList:
    def __init__(self):
        self.words = set()

    def load_words(self, file_path: str):
        with open(file_path, 'r') as file:
            for line in file:
                self.words.add(line.strip())

    def is_valid_word(self, word: str) -> bool:
        return word in self.words
```

### gamestate.py
```python
class GameState:
    def __init__(self):
        self.current_grid = []
        self.current_score = 0
        self.formed_words = []

    def save_state(self, file_path: str):
        with open(file_path, 'w') as file:
            file.write(f"{self.current_grid}\n{self.current_score}\n{self.formed_words}")

    def load_state(self, file_path: str):
        with open(file_path, 'r') as file:
            lines = file.readlines()
            self.current_grid = eval(lines[0].strip())
            self.current_score = int(lines[1].strip())
            self.formed_words = eval(lines[2].strip())
```

