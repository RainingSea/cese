            base_score += 2  # Bonus for longer words
        self.points += base_score  # Update cumulative score
        return base_score

    def get_score(self) -> int:
        """Returns the current score."""
        return self.points

class Timer:
    def __init__(self):
        self.time_left = 0
        self.paused = False
