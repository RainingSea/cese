CLASS Game:
    FUNCTION load_game_state(file):
        OPEN file for reading
        READ data and split into lines
        SPLIT first line by comma to get player_pos
        SET self.player.x to INT(player_pos[0])
        SET self.player.y to INT(player_pos[1])
        SPLIT second line by semicolon to get boxes_data
        FOR EACH box in boxes_data:
            SPLIT box by comma for coordinates
            ADD new Box with the coordinates to self.boxes
