CLASS PlayerBall
    FUNCTION __init__()
        SET size TO PLAYER_SIZE
        SET position TO (SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2)

    FUNCTION move(direction)
        GET current position (x, y)
        IF direction IS 'UP' AND y - size > 0
            SET position TO (x, y - 5)
        ELSE IF direction IS 'DOWN' AND y + size < SCREEN_HEIGHT
            SET position TO (x, y + 5)
        ELSE IF direction IS 'LEFT' AND x - size > 0
            SET position TO (x - 5, y)
        ELSE IF direction IS 'RIGHT' AND x + size < SCREEN_WIDTH
            SET position TO (x + 5, y)

CLASS Game
    FUNCTION update()
        FOR each event IN pygame.event.get()
            IF event.type IS pygame.KEYDOWN
                IF event.key IS pygame.K_UP
                    CALL player_ball.move('UP')
                ... (handle other directions)
```
|Case|:**enemy_ball_collision**
```plaintext
CLASS Game
    FUNCTION check_collisions()
        CREATE player_rect AS pygame.Rect(position of player_ball)
        FOR each enemy IN enemy_balls
            CREATE enemy_rect AS pygame.Rect(position of enemy_ball)
            IF player_rect collides with enemy_rect
                CALL player_ball.grow()  
                INCREMENT score by 1
                REMOVE enemy from enemy_balls
                APPEND new EnemyBall()
