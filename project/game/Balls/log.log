                self.enemy_balls.remove(enemy)

    def is_colliding(self, pos1, size1, pos2, size2):
        dist_x = pos1[0] - pos2[0]
        dist_y = pos1[1] - pos2[1]
        distance = (dist_x ** 2 + dist_y ** 2) ** 0.5
