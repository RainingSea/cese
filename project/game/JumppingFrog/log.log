import pygame
from game import Game

def main():
    game = Game()
    game.start()
    
    running = True
    while running:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False

        game.handle_input()
        game.update()
        game.check_collisions()
        game.draw()
        
