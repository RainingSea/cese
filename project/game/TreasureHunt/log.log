    FUNCTION move(direction)
        IF direction is "up" THEN
            Update position (x, y - 1)
        ELSE IF direction is "down" THEN
            Update position (x, y + 1)
        ELSE IF direction is "left" THEN
            Update position (x - 1, y)
        ELSE IF direction is "right" THEN
            Update position (x + 1, y)

class Maze:
