            SET self.position = (self.position[0] - 1, self.position[1])
        ELSE IF direction == "right":
            SET self.position = (self.position[0] + 1, self.position[1])

    FUNCTION find_treasure(maze):
        RETURN self.position == maze.treasure_location

CLASS Maze:
    FUNCTION __init__():
        SET self.treasure_location = (random_x, random_y)
```

