IMPORT pygame

CLASS Timer
    FUNCTION __init__()
        INITIALIZE start_time to 0
        INITIALIZE elapsed_time to 0

    FUNCTION start()
        SET start_time to current time in milliseconds using pygame.time.get_ticks()

    FUNCTION stop()
        SET elapsed_time to current time minus start_time in milliseconds

    FUNCTION get_time()
        CALCULATE seconds from elapsed_time by dividing by 1000
        RETURN formatted string in "MM:SS" format

CLASS Game
