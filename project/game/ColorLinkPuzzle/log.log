class HighScores:
    method __init__():
        initialize scores as empty list

    method load_scores():
        if 'high_scores.txt' exists:
            open 'high_scores.txt' in read mode as file
            for each line in file:
                split line into name and score by '|'
                append (name, integer(score)) to scores

    method save_score(name, score):
        append (name, score) to scores
        sort scores in descending order by score
        open 'high_scores.txt' in write mode as file
        for each (name, score) in scores:
