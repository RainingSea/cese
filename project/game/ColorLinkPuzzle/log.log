        return start.is_adjacent(end) and not self.is_blocked_path(start, end)

    def clear_connected_blocks(self, start_block: Block = None):
        cleared = 0
        if start_block:
            cleared += self._clear_block(start_block)
        else:
            for row in self.blocks:
                for block in row:
