```python
import pygame
from grid import Grid
from score import Score

class Game:
    def __init__(self):
        self.grid = Grid()
        self.score = Score()
        self.level_data = self.load_levels()

    def load_levels(self):
        levels = []
        with open('levels.txt', 'r') as file:
            for line in file:
                levels.append(line.strip().split('|'))
        return levels

    def start_game(self):
        running = True
        while running:
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    running = False
                # Additional event handling can be added here
            self.grid.display()
            self.clear_blocks()
            self.update_score(10)  # Example score update
            pygame.display.flip()

    def clear_blocks(self):
        self.grid.clear_connected_blocks()
        print("Blocks cleared!")

    def check_connection(self, start, end):
        return self.grid.is_path_clear(start, end)

    def update_score(self, points: int):
        self.score.update_score(points)

    def get_next_level(self):
        if self.level_data:
            return self.level_data.pop(0)
        return None
```

