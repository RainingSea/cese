            with open('level_data.json', 'r') as f:
                self.levels = json.load(f).get('levels', [])
        except FileNotFoundError:
            self.levels = []

    def save_levels(self) -> None:
        with open('level_data.json', 'w') as f:
            json.dump({'levels': self.levels}, f)

class Game:
