class Levels:
    def __init__(self):
        self.level_data = []
        self.load_levels()

    def load_levels(self):
        with open('levels.txt', 'r') as file:
            self.level_data = [line.strip() for line in file.readlines()]

    def get_next_level(self):
        return self.level_data[0] if self.level_data else None
