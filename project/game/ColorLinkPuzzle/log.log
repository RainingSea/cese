        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_RETURN:
                    game.start_game()
                    # Placeholder for game loop logic

        menu.show_main_menu()

    pygame.quit()

if __name__ == "__main__":
    main()
