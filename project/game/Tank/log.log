class Player:
    def __init__(self, position, health):
        self.position = position
        self.health = health

    def move(self, direction):
        if direction == 'UP':
            self.position[1] -= 1
        elif direction == 'DOWN':
            self.position[1] += 1
        elif direction == 'LEFT':
            self.position[0] -= 1
        elif direction == 'RIGHT':
            self.position[0] += 1

    def fire_bullet(self):
