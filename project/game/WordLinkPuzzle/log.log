```python
class Score:
    def __init__(self):
        self.points = 0

    def calculate_score(self, word: str) -> int:
        length = len(word)
        base_score = 0
        
        # Base scoring based on word length
        if length <= 3:
            base_score = 1
        elif length <= 5:
            base_score = 2
        elif length <= 7:
            base_score = 3
        else:
            base_score = 5  # Bonus for longer words

        # Bonus for rare or complex words (for demonstration, we assume words longer than 7 are complex)
        if length > 7:
            base_score += 2  # Additional bonus points for complex words

        return base_score

    def add_points(self, points: int):
        self.points += points

    def get_score(self) -> int:
        return self.points
```

