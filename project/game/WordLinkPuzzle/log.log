import pygame
from game import Game

def main():
    pygame.init()
    screen = pygame.display.set_mode((800, 600))
    pygame.display.set_caption("Word Puzzle Game")
    
    game = Game()
    game.start_game('Easy')  # Starting the game with 'Easy' difficulty
    
